=== judgeVerdictActions ===
{{if .CanShow}}<form method="POST" class="ckp-show"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="0"><button type="submit" name="jumpToFinding" class="outline">Show in file</button></form>
      {{end}}{{if or (eq .Status "fail") (eq .Status "ignored")}}<form method="POST" class="jv-ignore"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="toggleIgnoreVerdict" class="outline secondary jv-btn{{if eq .Status "ignored"}} is-on{{end}}" aria-pressed="{{if eq .Status "ignored"}}true{{else}}false{{end}}" title="{{if eq .Status "ignored"}}Bring it back{{else}}It's fine here: stop counting it until the file or the rubric changes{{end}}">{{if eq .Status "ignored"}}Ignored{{else}}Ignore{{end}}</button></form>
      {{end}}<span class="jv-agree"><span class="jv-label">Agree?</span>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="agree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "agree"}} is-on{{end}}" aria-pressed="{{if eq .Label "agree"}}true{{else}}false{{end}}">Agree</button></form>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="disagree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "disagree"}} is-on{{end}}" aria-pressed="{{if eq .Label "disagree"}}true{{else}}false{{end}}">Disagree</button></form>
      {{with .Model}}<span class="ck-src">{{.}}</span>{{end}}</span>
=== kbdHelp ===
<div class="kbd-help-backdrop{{if .KeyHelpOpen}} is-open{{end}}" lvt-on:click="toggleKeyboardHelp" aria-hidden="true"></div>
<div class="kbd-help-modal{{if .KeyHelpOpen}} is-open{{end}}" role="dialog" aria-label="Keyboard shortcuts" aria-modal="true">
  <div class="kbd-help-head">
    <strong>Keyboard shortcuts</strong>
    <form method="POST">
      <button type="submit" name="toggleKeyboardHelp" class="outline close-btn" aria-label="Close">
        {{template "iconClose16"}}
      </button>
    </form>
  </div>
  <dl class="kbd-help-list">{{range .KeyBindings}}
    <div class="kbd-row"><dt><kbd>{{.Display}}</kbd></dt><dd>{{.Label}}</dd></div>{{end}}
  </dl>
  <p class="kbd-help-note">Drawing a precise region on rendered HTML or an image needs a mouse — from the keyboard, comment on the whole block or image instead.</p>
  
  <p class="kbd-help-usage"><a href="/_usage" target="_blank" rel="noopener">Open the usage guide ↗</a></p>
</div>
=== learnCard ===

    <li class="lib-card is-{{.Status}}" data-key="learn-{{.ID}}">
      <header><span class="ck-pill ck-{{.Pill}}">{{.Status}}</span><span>scope: <b>{{.Scope}}</b></span><span>{{.Meta}}</span></header>
      {{if .Editing}}<form method="POST" class="lc-edit"><input type="hidden" name="id" value="{{.ID}}">
        <textarea name="text" rows="2" aria-label="Learning">{{.Text}}</textarea>
        <label>Scope <input type="text" name="scope" value="{{.Scope}}" autocomplete="off"></label>
        <div class="lc-actions"><button type="submit" name="saveLearning">Save</button><button type="submit" name="editLearning" class="outline secondary">Cancel</button></div>
      </form>{{else}}<p class="lc-text">{{.Text}}</p>{{end}}
      {{with .Conflict}}<div class="lc-conflict"><b>Replaces an older learning</b>: {{.}}. Newer wins: accepting this keeps the old one as superseded, so you can restore it.</div>{{end}}
      {{if .Evidence}}<details{{if eq .Status "proposed"}} open{{end}}><summary>Evidence ({{len .Evidence}})</summary><ul class="lc-evidence">
        {{range .Evidence}}<li><span class="ev-where">{{.Where}}</span>{{with .Quote}}<br><q>{{.}}</q>{{end}}</li>
        {{end}}</ul></details>{{end}}
      {{$accepted := eq .Status "accepted"}}{{with .Produces}}<div class="lc-row"><span>{{if $accepted}}became{{else}}would become{{end}}: <b>{{.}}</b></span></div>{{end}}
      {{with .Checker}}<details class="lc-drafted"><summary>Checker it adds</summary><pre>{{.}}</pre></details>{{end}}
      {{with .Judge}}<details class="lc-drafted"><summary>Judge it adds</summary><pre>{{.}}</pre></details>{{end}}
      {{with .Shortcut}}<details class="lc-drafted"><summary>Shortcut it adds</summary><p><b>{{.Label}}</b></p><pre>{{.Body}}</pre></details>{{end}}
      {{if not .Editing}}<div class="lc-actions">
        {{$id := .ID}}{{range .Actions}}<form method="POST"><input type="hidden" name="id" value="{{$id}}">{{with .Act}}<input type="hidden" name="act" value="{{.}}">{{end}}<button type="submit" name="{{.Name}}" class="{{.Class}}">{{.Label}}</button></form>
        {{end}}
      </div>{{end}}
    </li>

=== learnings ===
{{with $.LibraryBootCard}}{{template "bootCard" .}}{{end}}{{with $.LearnPage}}
  <div class="lib-filters">
    {{range .Chips}}<form method="POST"><input type="hidden" name="status" value="{{.Value}}"><button type="submit" name="setLearnFilter" class="lib-chip{{if .On}} is-on{{end}}" aria-pressed="{{if .On}}true{{else}}false{{end}}">{{.Label}} {{.Count}}</button></form>
    {{end}}<form method="POST" class="lib-auto-form"><button type="submit" name="toggleAutoLearn" class="lib-auto" role="switch" aria-checked="{{if $.AutoLearnOff}}false{{else}}true{{end}}" title="When your agent goes idle and a review has 5 or more new comments, replies or decisions, ask it to learn from them"><span class="ck-switch{{if $.AutoLearnOff}} off{{end}}" aria-hidden="true"></span>Learn after each review</button></form>
    <form method="POST" class="lib-auto-form"><button type="submit" name="toggleAutoAccept" class="lib-auto" role="switch" aria-checked="{{if $.AutoAcceptOff}}false{{else}}true{{end}}" title="Add what your agent learns straight to your skills (you're told, and can undo it), instead of waiting for you to accept each one"><span class="ck-switch{{if $.AutoAcceptOff}} off{{end}}" aria-hidden="true"></span>Accept automatically</button></form>
    {{if .Scopes}}<form method="POST" class="lib-scope-form">
      <select name="scope" aria-label="Scope" lvt-on:change="setLearnFilter">
        <option value=""{{if eq .Scope ""}} selected{{end}}>All scopes</option>
        {{range .Scopes}}<option value="{{.Name}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>{{end}}
      </select>
    </form>{{end}}
    <form method="POST" class="lib-boot-form"><button type="submit" name="openPastReviews" class="ck-link">{{if $.BootOpen}}Hide past reviews{{else}}Read past reviews{{end}}</button></form>
  </div>
  {{with .Empty}}<p class="ckp-empty">{{.}}</p>{{end}}
  <ul class="lib-list">
    {{range .Cards}}{{template "learnCard" .}}{{end}}
  </ul>
  <div class="lib-io">
    <span>Review on another machine too? Carry your learnings across: newer ones win.</span>
    <a role="button" class="outline" href="/_library-export" download>Export learnings</a>
    <form method="POST" action="/_library-import" enctype="multipart/form-data" class="lib-import" lvt-form:no-intercept>
      <input type="file" name="file" accept=".jsonl,application/x-ndjson,application/json" aria-label="Learnings file to import" required>
      <button type="submit" class="outline">Import</button>
    </form>
  </div>
{{end}}
=== libHistory ===
{{if .Versions}}{{$id := .ID}}{{$act := .Action}}<details class="ckp-history"{{if gt (len .Versions) 1}} open{{end}}><summary>History ({{len .Versions}} version{{if ne (len .Versions) 1}}s{{end}})</summary>
                <ol>
                  {{range .Versions}}<li data-key="ckp-v{{.Seq}}">
                    <span class="ckp-hv-head"><b>{{if .Current}}Current{{else}}Version {{.Seq}}{{end}}</b> · {{.When}}{{with .Stat}} · {{.}}{{end}}{{with .Note}} · {{.}}{{end}}{{if not .Current}} <form method="POST" class="ckp-inline"><input type="hidden" name="id" value="{{$id}}"><input type="hidden" name="seq" value="{{.Seq}}"><button type="submit" name="{{$act}}" class="outline">Restore</button></form>{{end}}</span>
                    {{if .Diff}}<div class="lc-diff">{{range .Diff}}<pre class="{{if eq .Kind "add"}}sg-new{{else}}sg-old{{end}}">{{if eq .Kind "add"}}+{{else}}−{{end}} {{.Text}}</pre>{{end}}{{if .More}}<pre class="sg-more">… {{.More}} more changed line{{if ne .More 1}}s{{end}}</pre>{{end}}</div>{{end}}
                  </li>
                  {{end}}
                </ol>
              </details>{{end}}
=== library ===
{{if $.ShowLibrary}}
<section class="library" data-key="library" aria-label="Library">
  <header class="lib-head">
    <strong class="lib-title">{{template "iconLibrary"}} Library</strong>
    <span class="lib-src">shared by every review on this machine · changes show up live</span>
    <details class="lib-editor">
      <summary>Open rule files in: {{range $.EditorOptions}}{{if .Selected}}{{.Label}}{{end}}{{end}}</summary>
      <form method="POST" class="checks-editor">
        <label>Editor
          <select name="editor">
            {{range $.EditorOptions}}<option value="{{.ID}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}
          </select>
        </label>
        <label>SSH host <input type="text" name="ssh_host" value="{{$.EditorSSHHost}}" placeholder="blank = this machine" autocomplete="off"></label>
        <label>Custom URL <input type="text" name="template" value="{{$.EditorTemplate}}" placeholder="myeditor://open?file={path}&amp;line={line}" autocomplete="off"></label>
        <button type="submit" name="setEditor" class="outline">Save</button>
      </form>
    </details>
    <span class="lib-head-actions"><a role="button" class="outline lib-review" href="/_library-review" target="_blank" rel="noopener" title="Open the library folder as a review: comments and suggestions on library files go to your agent">Review in prereview</a>
    <form method="POST" class="lib-back"><button type="submit" name="toggleLibrary" class="outline contrast">Back</button></form></span>
  </header>
  <div class="lib-tabs" role="tablist">
    <form method="POST"><input type="hidden" name="tab" value="learnings"><button type="submit" name="setLibraryTab" class="lib-tab{{if $.LibraryOnLearnings}} is-on{{end}}" role="tab" aria-selected="{{if $.LibraryOnLearnings}}true{{else}}false{{end}}">Learnings{{if $.LearnNew}}<span class="ck-pill ck-new">{{$.LearnNew}} new</span>{{end}}</button></form>
    <form method="POST"><input type="hidden" name="tab" value="shortcuts"><button type="submit" name="setLibraryTab" class="lib-tab{{if $.LibraryOnShortcuts}} is-on{{end}}" role="tab" aria-selected="{{if $.LibraryOnShortcuts}}true{{else}}false{{end}}">Shortcuts</button></form>
    <form method="POST"><input type="hidden" name="tab" value="skills"><button type="submit" name="setLibraryTab" class="lib-tab{{if $.LibraryOnSkills}} is-on{{end}}" role="tab" aria-selected="{{if $.LibraryOnSkills}}true{{else}}false{{end}}">Skills</button></form>
    <form method="POST"><input type="hidden" name="tab" value="checks"><button type="submit" name="setLibraryTab" class="lib-tab{{if $.LibraryOnChecks}} is-on{{end}}" role="tab" aria-selected="{{if $.LibraryOnChecks}}true{{else}}false{{end}}">Checks</button></form>
    <form method="POST"><input type="hidden" name="tab" value="benchmarks"><button type="submit" name="setLibraryTab" class="lib-tab{{if $.LibraryOnBenchmarks}} is-on{{end}}" role="tab" aria-selected="{{if $.LibraryOnBenchmarks}}true{{else}}false{{end}}">Benchmarks</button></form>
  </div>
  {{template "learnings" $}}{{with $.ShortcutsTab}}{{template "shortcutsTab" .}}{{end}}{{with $.SkillsTab}}{{template "skillsTab" .}}{{end}}{{with $.BenchTab}}{{template "benchTab" .}}{{end}}
  {{with $.CheckPage}}
  <div class="ckp-bar">
    <form method="POST" lvt-form:preserve class="ckp-search-form">
      <input type="search" name="q" class="ckp-search" value="{{.Query}}" placeholder="Search checks and findings" aria-label="Search checks and findings" lvt-on:input="setChecksQuery" lvt-mod:debounce="200" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
    </form>
    <div class="ckp-chips">
      {{range .Chips}}<form method="POST"><input type="hidden" name="field" value="status"><input type="hidden" name="value" value="{{.Value}}"><button type="submit" name="setChecksFilter" class="lib-chip{{if .On}} is-on{{end}}" aria-pressed="{{if .On}}true{{else}}false{{end}}">{{.Label}} {{.Count}}</button></form>
      {{end}}{{if .File}}<form method="POST"><input type="hidden" name="field" value="file"><input type="hidden" name="value" value=""><button type="submit" name="setChecksFilter" class="lib-chip ckp-file-chip is-on" title="Showing findings in this file only; clear to see every file">in <code>{{.File}}</code> ×</button></form>
      {{end}}{{if .Judges}}<span class="ckp-kind">
        <form method="POST"><input type="hidden" name="kind" value=""><button type="submit" name="setChecksKind" class="lib-chip{{if eq .Kind ""}} is-on{{end}}">Checkers &amp; judges</button></form>
        <form method="POST"><input type="hidden" name="kind" value="checker"><button type="submit" name="setChecksKind" class="lib-chip{{if eq .Kind "checker"}} is-on{{end}}">Checkers {{.Checkers}}</button></form>
        <form method="POST"><input type="hidden" name="kind" value="judge"><button type="submit" name="setChecksKind" class="lib-chip{{if eq .Kind "judge"}} is-on{{end}}">Judges {{.Judges}}</button></form>
      </span>
      {{end}}<form method="POST" class="ckp-source-form">
        <select name="source" aria-label="Source" lvt-on:change="setChecksSource">
          <option value=""{{if eq .Source ""}} selected{{end}}>All sources</option>
          <option value="builtin"{{if eq .Source "builtin"}} selected{{end}}>Built-in</option>
          <option value="user"{{if eq .Source "user"}} selected{{end}}>Yours</option>
          <option value="learned"{{if eq .Source "learned"}} selected{{end}}>Learned</option>
          <option value="vale"{{if eq .Source "vale"}} selected{{end}}>This repo (Vale)</option>
        </select>
      </form>
    </div>
    <span class="ckp-scope">{{.Files}} file{{if ne .Files 1}}s{{end}} checked{{if .Skipped}} ({{.Skipped}} more not checked){{end}} · {{.Checks}} check{{if ne .Checks 1}}s{{end}} · updates live</span>
  </div>
  <div class="ckp">
    <nav class="ckp-cats" aria-label="Categories">
      {{range .Categories}}<form method="POST"><input type="hidden" name="field" value="category"><input type="hidden" name="value" value="{{.Name}}"><button type="submit" name="setChecksFilter" class="ckp-cat{{if .On}} is-on{{end}}" aria-pressed="{{if .On}}true{{else}}false{{end}}"><span class="ckp-cat-name">{{if .Name}}{{.Name}}{{else}}All{{end}}</span>{{with .Note}}<span class="ckp-cat-note">{{.}}</span>{{end}}{{if .Failing}}<span class="ckp-cat-fail" title="{{.Failing}} failing">{{.Failing}}</span>{{end}}<span class="ckp-cat-n">{{.Count}}</span></button></form>
      {{end}}
    </nav>
    <div class="ckp-main">
      {{if or .QueueAll .IgnoreAll .Ignored}}<div class="ckp-bulk ckp-bulk-page">
        <span class="ckp-bulk-label">Everything listed:</span>
        {{if .QueueAll}}<form method="POST"><button type="submit" name="queueAllFindings" class="outline" title="Queue each failure listed below as a comment for your agent">Queue all {{.QueueAll}}</button></form>{{end}}
        {{if .IgnoreAll}}<form method="POST"><button type="submit" name="dismissAllFindings" class="outline secondary" aria-pressed="false" title="They're fine: stop flagging everything listed below">Ignore all {{.IgnoreAll}}</button></form>
        {{else}}<form method="POST"><button type="submit" name="restoreAllDismissed" class="outline secondary is-on" aria-pressed="true" title="Bring back the {{.Ignored}} you ignored">Ignored {{.Ignored}}</button></form>{{end}}
      </div>{{end}}
      {{if .Query}}<p class="ckp-hits">{{.Matches}} check{{if ne .Matches 1}}s{{end}} match “{{.Query}}”: names, descriptions, categories, and the words a finding flagged.</p>{{end}}
      {{range .Groups}}
      <section class="ckp-group" data-key="ckp-group-{{.Name}}">
        <h3>{{.Name}} <small>{{len .Rows}} check{{if ne (len .Rows) 1}}s{{end}}{{if .Failing}} · {{.Failing}} failing{{end}}{{if .Errors}} · {{.Errors}} error{{if ne .Errors 1}}s{{end}}{{end}}</small></h3>
        <ul class="ckp-list">
          {{range .Rows}}{{template "checkRow" .}}{{end}}
        </ul>
      </section>
      {{end}}
      {{if .ShowVale}}
      <section class="ckp-group" data-key="ckp-group-vale-notice">
        <h3>Vale <small>this repo’s <code>.vale.ini</code></small></h3>
        <div class="ckp-trust" role="note"><p>{{.ValeNotice}}</p>{{if .ValeTrust}}<form method="POST"><button type="submit" name="trustVale" class="outline">Trust this repo’s Vale config</button></form>{{end}}</div>
      </section>
      {{end}}
      {{if .Folded}}<div class="ckp-more">{{range $i, $g := .Folded}}{{if $i}}, {{end}}{{$g.Name}} ({{len $g.Rows}}){{end}} all pass · <form method="POST" class="ckp-inline"><button type="submit" name="togglePassingGroups" class="ck-link">show passing groups</button></form></div>
      {{else}}{{if and .ShowPassing .CanFold}}<div class="ckp-more"><form method="POST" class="ckp-inline"><button type="submit" name="togglePassingGroups" class="ck-link">hide passing groups</button></form></div>
      {{end}}{{end}}
      {{if and (not .Groups) (not .Folded) (not .ShowVale)}}<p class="ckp-empty">{{if .Query}}No check matches “{{.Query}}”.{{else}}No checks match these filters.{{end}}</p>{{end}}
    </div>
  </div>
  {{end}}
</section>
{{end}}
=== libraryButton ===

  <form method="POST" class="library-form">
    <button type="submit" name="toggleLibrary" class="contrast library-trigger{{if $.ShowLibrary}} is-on{{end}}" aria-pressed="{{if $.ShowLibrary}}true{{else}}false{{end}}" title="Library: the learnings and checks every review on this machine uses">{{template "iconLibrary"}}<span class="tb-label">Library</span>{{if $.LearnNew}}<span class="lib-badge" title="{{$.LearnNew}} new learning{{if ne $.LearnNew 1}}s{{end}} proposed">{{$.LearnNew}}</span>{{end}}{{if $.LearnStalled}}<span class="agent-dot is-stalled" role="img" aria-label="Learning is waiting: your agent's learner isn't running" title="Learning is waiting: your agent's learner isn't running"></span>{{end}}</button>
  </form>

=== liveStage ===
    {{template "regionToggle" $}}
    <div class="preview-stage ext-stage" lvt-fx:proxy-bridge="setProxyURL" data-key="ext-stage"{{with $.FocusedComment}} data-focus-token="{{$.FocusSeq}}" data-focus-url="{{.URL}}" data-focus-y="{{.Area.Y}}"{{end}}>
      
      <iframe class="ext-frame" src="{{.ProxyBaseURL}}" title="Live preview of {{.TargetURL}}" lvt-ignore></iframe>
      <div class="pin-layer" data-pin-layer data-key="pin-layer">{{range $.RegionComments}}<button type="button" class="area-overlay pin-btn{{if .Resolved}} is-resolved{{end}}{{if index $.AgentActedLabels .ID}} is-acted{{end}}{{if eq $.FocusedCommentID .ID}} is-focused{{end}}" lvt-on:click="editComment" data-id="{{.ID}}" data-key="pin-{{.ID}}" style="left:{{.Area.PercentX}};top:{{.Area.PercentY}};width:{{.Area.PercentW}};height:{{.Area.PercentH}};" title="{{with index $.AgentActedLabels .ID}}{{.}} — {{end}}{{.Body}}" aria-label="Edit annotation"></button>{{end}}{{if eq $.CommentMode "region"}}<div class="area-overlay area-overlay-pending" data-key="pin-pending" style="left:{{$.SelectionArea.PercentX}};top:{{$.SelectionArea.PercentY}};width:{{$.SelectionArea.PercentW}};height:{{$.SelectionArea.PercentH}};"></div>{{end}}</div>
      {{if and .RegionSelectArmed $.LiveShowing}}<div class="region-overlay" lvt-fx:region-select="selectRegion" data-surface="page" data-key="ext-region-overlay"></div>{{end}}
    </div>
    {{if and $.LiveShowing (eq $.CommentMode "region")}}{{template "composer" $}}{{end}}
=== liveToggle ===
<form method="POST">
  <button type="submit" name="toggleLiveView" class="live-toggle {{if .LiveShowing}}contrast{{else}}outline contrast{{end}}" aria-pressed="{{if .LiveShowing}}true{{else}}false{{end}}" title="{{if .LiveShowing}}Back to the files{{else}}Show the live site{{end}}{{with index $.KeyHint "toggleLiveView"}} ({{.}}){{end}}">Live</button>
</form>
=== markdownView ===
{{with $.CurrentDiff}}  <div class="md-view" data-key="md-{{.Path}}" lvt-spy="h1, h2, h3" lvt-fx:text-select="selectText" data-surface="block">{{range $.RenderedMarkdown}}{{$bs := .StartLine}}{{$be := .EndLine}}{{$mbkey := printf "MB-%d-%d" $bs $be}}{{$mbstatus := index $.BlockDiffStatus $mbkey}}<div class="md-block{{if and (ne $.SelectionEndMax 0) (ge $.SelectionEndMax $bs) (le $.SelectionEndMax $be)}} selected{{end}}{{if $mbstatus}} md-{{$mbstatus}}{{end}}{{if index $.RowToggled $mbkey}} row-toggled{{end}}" data-key="{{$mbkey}}"{{if or (eq $.ScrollHeadingBlockKey $mbkey) (eq $.ScrollToReadKey $mbkey)}} lvt-fx:scroll="into-view"{{end}}>{{$ba := index $.BlockAnnotations $mbkey}}{{if gt $ba.Total 0}}<button type="button" class="md-block-marks" lvt-on:click="toggleRow" data-row="{{$mbkey}}" lvt-el:toggleClass:on:click="row-toggled" data-lvt-target="closest:.md-block" aria-label="Show or hide the annotations in this block" title="Show/hide this block's annotations">
        <span class="line-mark{{if $ba.Open}} is-open{{else}}{{if $ba.Accepted}} is-accepted{{else}} is-done{{end}}{{end}}" aria-hidden="true">{{$ba.Total}}</span>
      </button>{{end}}<div class="md-rendered" tabindex="0" lvt-on:click="selectBlock" lvt-on:keydown="selectBlock" lvt-key="Enter" data-from="{{$bs}}" data-to="{{$be}}">{{.HTML}}</div>{{template "blockComments" .}}{{template "blockSuggestions" .}}</div>{{end}}</div>{{end}}
=== moreMenu ===
<div class="more-menu-backdrop{{if .MoreMenuOpen}} is-open{{end}}" lvt-on:click="closeMoreMenu" aria-hidden="true"></div>
<div class="more-menu{{if .MoreMenuOpen}} is-open{{end}}" role="menu" aria-label="More options">
  <div class="menu-info">{{len .Files}} files{{if gt .ChangedFilesCount 0}} · {{.ChangedFilesCount}} changed{{end}} · {{.ScopeViewedCount}}/{{.ScopeFileCount}} viewed{{if gt .CommentCount 0}} · {{.CommentCount}} comment{{if ne .CommentCount 1}}s{{end}}{{end}}</div>
  
  {{if and (gt (len .Files) 1) (not .LiveShowing)}}
  <form method="POST">
    <button type="submit" name="prevFile" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconChevronLeft"}}</span>
      <span class="menu-label">Previous file</span>
    </button>
  </form>
  <form method="POST">
    <button type="submit" name="nextFile" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconChevronRight"}}</span>
      <span class="menu-label">Next file</span>
    </button>
  </form>
  {{end}}
  
  <form method="POST">
    <button type="submit" name="cycleScheme" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconPalette"}}</span>
      <span class="menu-label">Scheme: {{.SchemeLabel}}</span>
      <span class="menu-meta">{{.NextSchemeLabel}} →</span>
    </button>
  </form>
  <form method="POST">
    <button type="submit" name="cycleTheme" class="menu-item" role="menuitem">
      <span class="menu-icon">{{if eq .ThemeMode "light"}}{{template "iconThemeLight"}}{{else}}{{if eq .ThemeMode "dark"}}{{template "iconThemeDark"}}{{else}}{{template "iconThemeSystem"}}{{end}}{{end}}</span>
      <span class="menu-label">Mode: {{.ThemeModeLabel}}</span>
      <span class="menu-meta">{{.NextThemeModeLabel}} →</span>
    </button>
  </form>
  {{if .FileShowing}}
  
  {{with .RenderedHeadings}}
  
  <form method="POST">
    <button type="submit" name="openTOC" class="menu-item toc-menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconTOC"}}</span>
      <span class="menu-label">Table of contents</span>
      <span class="menu-meta">{{len .}}</span>
    </button>
  </form>
  {{end}}
  {{if .IsMarkdown}}
  <form method="POST">
    <button type="submit" name="toggleRawMarkdown" class="menu-item{{if not .RawMarkdown}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">
        {{if .RawMarkdown}}
        {{template "iconRendered"}}
        {{else}}
        {{template "iconViewRaw"}}
        {{end}}
      </span>
      <span class="menu-label">{{if .RawMarkdown}}Preview{{else}}View raw source{{end}}</span>
    </button>
  </form>
  {{end}}
  {{if .IsHTML}}
  <form method="POST">
    <button type="submit" name="toggleRawHTML" class="menu-item{{if not .RawHTML}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">
        {{if .RawHTML}}
        {{template "iconRendered"}}
        {{else}}
        {{template "iconViewRaw"}}
        {{end}}
      </span>
      <span class="menu-label">{{if .RawHTML}}Preview{{else}}View raw source{{end}}</span>
    </button>
  </form>
  {{end}}
  {{if not .ShowRenderedHTML}}
  <form method="POST">
    <button type="submit" name="toggleFileView" class="menu-item{{if .FileView}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">
        {{if .FileView}}
        
        {{template "iconDiff"}}
        {{else}}
        
        {{template "iconFile"}}
        {{end}}
      </span>
      <span class="menu-label">{{if .FileView}}Show diff{{else}}View file{{end}}</span>
    </button>
  </form>
  {{end}}
  {{end}}
  {{if gt .CommentCount 0}}
  <form method="POST">
    <button type="submit" name="toggleCommentList" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconComments"}}</span>
      <span class="menu-label">{{if .ShowAllComments}}Back{{else}}All comments{{end}}{{with index $.KeyHint "toggleCommentList"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
      <span class="menu-meta">{{.CommentCount}}</span>
    </button>
  </form>
  {{end}}
  {{if .HasUnderstandContent}}
  <form method="POST">
    <button type="submit" name="toggleUnderstand" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconQuiz"}}</span>
      <span class="menu-label">{{if .ShowUnderstand}}Back{{else}}Understand{{end}}{{with index $.KeyHint "toggleUnderstand"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
      <span class="menu-meta">{{.QuizScoreLabel}}</span>
    </button>
  </form>
  {{end}}
  {{if gt .ResolvedCount 0}}
  <form method="POST">
    <button type="submit" name="toggleShowResolved" class="menu-item{{if .ShowResolved}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">
        {{if .ShowResolved}}
        {{template "iconCheck"}}
        {{else}}
        {{template "iconCircle16"}}
        {{end}}
      </span>
      <span class="menu-label">{{if .ShowResolved}}Hide resolved{{else}}Show resolved{{end}}{{with index $.KeyHint "toggleShowResolved"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
      <span class="menu-meta">{{.ResolvedCount}}</span>
    </button>
  </form>
  {{end}}
  
  {{if and .ShowResolved (gt .HiddenResolvedCount 0)}}
  <form method="POST">
    <button type="submit" name="unhideAllResolved" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconCircle16"}}</span>
      <span class="menu-label">Unhide</span>
      <span class="menu-meta">{{.HiddenResolvedCount}}</span>
    </button>
  </form>
  {{end}}
  
  {{if gt .SuggestionCount 0}}
  <form method="POST">
    <button type="submit" name="toggleSuggestions" class="menu-item{{if not .HideSuggestions}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">{{template "iconSuggestion"}}</span>
      <span class="menu-label">{{if .HideSuggestions}}Show suggestions{{else}}Hide suggestions{{end}}</span>
      <span class="menu-meta">{{.SuggestionCount}}</span>
    </button>
  </form>
  {{end}}
  
  {{if $.HasMarks}}
  <form method="POST">
    <button type="submit" name="toggleMarks" class="menu-item{{if not .HideMarks}} is-on{{end}}" role="menuitem">
      <span class="menu-icon">{{if .HideMarks}}{{template "iconCircle16"}}{{else}}{{template "iconCheck"}}{{end}}</span>
      <span class="menu-label">{{if .HideMarks}}Show annotations{{else}}Hide annotations{{end}}</span>
    </button>
  </form>
  {{end}}
  
  {{if gt .HiddenSuggestionCount 0}}
  <form method="POST">
    <button type="submit" name="showHiddenSuggestions" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconSuggestion"}}</span>
      <span class="menu-label">Show hidden suggestions</span>
      <span class="menu-meta">{{.HiddenSuggestionCount}}</span>
    </button>
  </form>
  {{end}}
  {{if gt .DecisionCount 0}}
  <div class="menu-info sg-decision-count">{{.DecisionCount}} suggestion decision{{if ne .DecisionCount 1}}s{{end}} recorded</div>
  {{end}}
  {{if and (eq .CommentCount 0) (eq .ResolvedCount 0)}}
  <div class="menu-info" style="border-bottom: 0; margin-bottom: 0; font-style: italic;">No comments yet — tap a line to add one.</div>
  {{end}}
  
  
  <form method="POST">
    <button type="submit" name="toggleKeyboardHelp" class="menu-item" role="menuitem">
      <span class="menu-icon" aria-hidden="true">?</span>
      <span class="menu-label">Keyboard shortcuts</span>
    </button>
  </form>
  
  <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
    <span class="menu-icon">{{template "iconBook"}}</span>
    <span class="menu-label">Usage guide</span>
  </a>
</div>
=== pastEndAnnotations ===
{{if or (gt $.PastEndCount 0) $.PastEndHidden}}
<section class="past-eof{{if index $.RowToggled "eof"}} row-toggled{{end}}" data-key="past-eof" aria-label="Annotations past the end of the file">
  <div class="past-eof-head">
    <span class="past-eof-title">Past the end of the file</span>
    <small class="past-eof-note">Their lines no longer exist in this file.</small>
    {{if gt $.PastEndCount 0}}<button type="button" class="line-marks" lvt-on:click="toggleRow" data-row="eof" lvt-el:toggleClass:on:click="row-toggled" data-lvt-target="closest:.past-eof" aria-label="Show or hide the annotations past the end of the file" title="Show/hide the annotations past the end of the file"><span class="line-mark{{if $.PastEndHasOpen}} is-open{{else}}{{if $.PastEndHasAccepted}} is-accepted{{else}} is-done{{end}}{{end}}" aria-hidden="true">{{$.PastEndCount}}</span></button>{{end}}
  </div>
  {{range $.PastEndComments}}{{template "commentCardFull" .}}{{end}}
  {{range $.PastEndSuggestions}}{{template "suggestionCard" .}}{{end}}{{with $.PastEndHidden}}{{template "hiddenMarker" .}}{{end}}
</section>
{{end}}
=== prereview ===
<!DOCTYPE html>

<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>prereview · {{.RepoPath}}</title>
<link rel="stylesheet" href="/pico.min.css">
<link rel="stylesheet" href="/livetemplate.css">
<link rel="stylesheet" href="/syntax.css">
<link rel="stylesheet" href="/prereview.css">
</head>
<body data-lvt-loading-debounce-ms="200" data-lvt-heartbeat-ms="10000">

<div class="theme-root" data-scheme="{{.DataScheme}}"{{with .DataMode}} data-mode="{{.}}"{{end}}>

<span class="kbd-esc" hidden aria-hidden="true" lvt-on:window:keydown="clearSelection" lvt-key="Escape"></span>

{{if .ExternalMode}}
{{template "externalBody" $}}
{{else}}

<div class="kbd-bindings" hidden aria-hidden="true">{{range .KeyBindings}}{{$b := .}}{{range $b.Keys}}{{if $b.Action}}<span lvt-on:window:keydown="{{$b.Action}}" lvt-key="{{.}}" lvt-mod:skip-when-typing></span>{{end}}{{end}}{{end}}</div>
{{template "toolbar" $}}


{{template "moreMenu" $}}

{{template "statusBanners" $}}{{template "skillNotice" $}}


<div class="drawer-backdrop{{if .FileDrawerOpen}} open{{end}}" lvt-on:click="closeFiles" aria-label="Close file list"></div>

<div class="layout{{if .FocusMode}} focus-mode{{end}}{{if .LiveShowing}} live-showing{{end}}{{if .TocCollapsed}} toc-collapsed{{end}}{{if .HideMarks}} marks-hidden{{end}}{{if .ShowResolved}} show-resolved{{end}}">
{{template "fileDrawer" $}}

<main class="viewer" lvt-fx:viewport-report="reportViewport" data-lvt-viewport-items=".line, .md-block">{{if .LiveAvailable}}<div class="live-wrap{{if not .LiveShowing}} live-hidden{{end}}" data-key="live-wrap">{{template "liveStage" $}}</div>{{end}}
{{if .ShowUnderstand}}
{{template "understandView" $}}
{{else}}{{if .ShowAllComments}}
{{template "allComments" $}}
{{else}}{{if .ShowLibrary}}{{template "library" $}}
{{else}}{{if .LiveView}}{{else}}
{{with .CurrentDiff}}
<article>
{{template "fileHeader" $}}
  {{if $.ViewingVersion}}
  
  <div class="version-view-banner" role="status">
    <span>{{if $.VersionViewDiff}}Comparing a previous version against the current file (read-only).{{else}}Viewing a previous version (read-only).{{end}}</span>
    <form method="POST" class="toast-dismiss-form"><button type="submit" name="exitVersionView" class="refresh-btn">Back to current</button></form>
  </div>
  {{end}}{{with $.WalkBar}}
  <div class="ann-nav walk-bar" role="navigation" aria-label="Walkthrough">
    <div class="walk-bar-nav">
      <form method="POST"><button type="submit" name="walkPrev" class="outline ann-nav-step" aria-label="Previous step"{{if not .HasPrev}} disabled{{end}}>{{template "iconChevronLeft"}}</button></form>
      <span class="ann-nav-label">Step {{.Num}} of {{.Total}}</span>
      <form method="POST"><button type="submit" name="walkNext" class="outline ann-nav-step" aria-label="Next step"{{if not .HasNext}} disabled{{end}}>{{template "iconChevronRight"}}</button></form>
      <span class="ann-nav-actions">
        <form method="POST"><input type="hidden" name="tab" value="walkthrough"><button type="submit" name="toggleUnderstand" class="outline" title="See every step">Steps</button></form>
        <form method="POST"><button type="submit" name="endWalkthrough" class="outline" aria-label="Stop the walkthrough" title="Stop the walkthrough">×</button></form>
      </span>
    </div>
    <div class="walk-bar-text"><strong class="walk-bar-title">{{.Title}}</strong>{{if .Risks}}<span class="walk-bar-risks">{{range .Risks}}<span class="ck-pill ck-fail risk-chip">{{.Kind}}</span>{{end}}</span>{{end}}{{if .Anchor}}<span class="walk-bar-at">{{.Anchor}}</span>{{else}}<span class="walk-bar-at quiz-ungrounded">⚠ cites nothing in this review</span>{{end}}{{if .Body}}<span class="walk-bar-body">{{.Body}}</span>{{end}}</div>
  </div>{{end}}
  
  {{if $.ShowNav}}
  <div class="ann-nav" role="navigation" aria-label="Open items">
    <form method="POST"><button type="submit" name="navPrev" class="outline ann-nav-step" aria-label="Previous open item" title="Previous open item (p)">{{template "iconChevronLeft"}}</button></form>
    <span class="ann-nav-label">{{$.NavLabel}}</span>
    <form method="POST"><button type="submit" name="navNext" class="outline ann-nav-step" aria-label="Next open item" title="Next open item (n)">{{template "iconChevronRight"}}</button></form>
    <div class="tb-dropdown ann-nav-kind" lvt-el:toggleClass:on:click="open" lvt-el:removeClass:on:click-away="open">
      <button type="button" class="outline" aria-haspopup="menu" title="Which items to step through">{{$.NavKindLabel}}{{template "iconChevronDown"}}</button>
      <div class="tb-dropdown-panel" role="menu" aria-label="Step through">
        {{range $.NavKinds}}<form method="POST"><input type="hidden" name="kind" value="{{.Kind}}"><button type="submit" name="setNavKind" class="menu-item{{if .On}} is-on{{end}}" role="menuitemradio" aria-checked="{{.On}}"><span class="menu-label">{{.Label}}</span></button></form>{{end}}
      </div>
    </div>
    <span class="ann-nav-actions">
      {{if $.HasQuiz}}<form method="POST"><input type="hidden" name="tab" value="quiz"><button type="submit" name="toggleUnderstand" class="outline" title="Open the quiz overview">Overview</button></form>{{end}}
      <form method="POST"><button type="submit" name="dismissNav" class="outline" aria-label="Hide this bar" title="Hide this bar">×</button></form>
    </span>
  </div>
  {{end}}{{if $.CheckStrip}}{{template "checksStrip" $}}{{end}}{{with $.BootCard}}{{template "bootCard" .}}{{end}}
  
  
  {{$fcs := $.FileLevelComments}}
  {{$acs := $.AreaComments}}
  <div class="file-head-marks{{if index $.RowToggled "file"}} row-toggled{{end}}">
    
    {{if gt $.FileHeadAnnotationCount 0}}
    <div class="file-head-badge-row">
      <button type="button" class="line-marks" lvt-on:click="toggleRow" data-row="file" lvt-el:toggleClass:on:click="row-toggled" data-lvt-target="closest:.file-head-marks" aria-label="Show or hide this file's annotations" title="Show/hide this file's annotations"><span class="line-mark{{if $.FileHeadHasOpen}} is-open{{else}} is-done{{end}}" aria-hidden="true">{{$.FileHeadAnnotationCount}}</span></button>
    </div>
    {{end}}
    <div class="file-head-cards">
      {{range $.FileQuizItems}}{{template "quizCard" .}}{{end}}
  
  {{if or $fcs $acs (eq $.CommentMode "area")}}
  <section class="file-comments" data-key="file-comments-{{.Path}}">
    {{range $fcs}}{{template "commentCardSimple" .}}{{end}}
    {{range $acs}}{{template "commentCardSimple" .}}{{end}}
    {{if eq $.CommentMode "area"}}{{template "composer" $}}{{end}}
  </section>
  {{end}}
    </div>
  </div>
  
  {{if eq $.CommentMode "file"}}
  <div class="fc-modal-backdrop" data-key="fc-modal-backdrop" lvt-on:click="clearSelection" aria-hidden="true"></div>
  <div class="fc-modal" data-key="fc-modal" role="dialog" aria-modal="true" aria-label="Comment on file">
    {{template "composer" $}}
  </div>
  {{end}}
  {{if .IsBinary}}
{{template "binaryView" $}}
  {{else}}{{if $.ShowRenderedHTML}}
{{template "htmlView" $}}
  {{else}}{{if $.ShowRenderedMarkdown}}
{{template "markdownView" $}}
  {{else}}{{if .Lines}}
{{template "diffView" $}}
  {{else}}
  <p class="empty"><small>No diff content.</small></p>
  {{end}}{{end}}{{end}}{{end}}{{template "pastEndAnnotations" $}}
</article>
{{else}}
  {{if .Files}}
  <p class="empty">Pick a file from the list.</p>
  {{else}}
  <div class="empty empty-diff">
    <h3>No files in this repository</h3>
    <p><small>Add some files and refresh, or relaunch prereview pointed at a different repo.</small></p>
  </div>
  {{end}}
{{end}}
{{end}}{{end}}{{end}}{{end}}

{{template "viewerPrompts" $}}
</main>


{{template "tocSidebar" $}}
</div>

{{template "tocOverlay" $}}

{{template "kbdHelp" $}}

{{if not .ExternalMode}}
{{template "searchPalette" $}}
{{end}}
<footer class="app-footer" role="contentinfo">
  prereview{{if ne .Version "dev"}} v{{.Version}}{{end}} · built with <a href="https://github.com/livetemplate/livetemplate" target="_blank" rel="noopener noreferrer">livetemplate</a>
</footer>
{{end}}


{{if .AgentMode}}{{template "endSessionDialog" .}}{{end}}
{{if not .AgentMode}}{{template "quitDialog" .}}{{end}}

</div>
<script defer src="/livetemplate-client.js"></script>

<script defer src="/mermaid-init.js"></script>
</body>
</html>




















































































































=== processedBadge ===
<small class="processed-badge">worked on</small>
=== queuedBadge ===
<small class="queued-badge" title="queued for the agent">queued</small>
=== quitDialog ===
<dialog id="confirm-quit"><article><header><strong>Quit prereview?</strong></header><p><small>Stops the prereview server and closes the review. Saved comments are already written to the CSV; this can't be undone from the browser.</small></p><footer>
    <form method="POST">
      <fieldset role="group">
        <button type="button" command="close" commandfor="confirm-quit" class="secondary">Cancel</button>
        <button type="submit" name="quit" class="contrast">Quit</button>
      </fieldset>
    </form>
  </footer></article></dialog>
=== quizAsk ===
{{if $.QuizPrompts}}{{if $.QuizPending}}<span class="request-pending" title="The request is queued — the agent will answer shortly">Quiz requested…</span>{{else}}<div class="quiz-ask">{{range $.QuizPrompts}}<form method="POST" style="margin:0"><input type="hidden" name="slug" value="{{.Slug}}"><button type="submit" name="requestQuiz" class="outline" title="{{.Body}}">{{.Title}}</button></form>{{end}}</div>{{end}}{{end}}
=== quizCard ===
<div class="quiz-card{{if .Answered}} is-answered{{end}}{{if .Settled}} is-settled{{end}}" data-key="quiz-{{.ID}}" id="qc-{{.ID}}">
  
  <div class="quiz-card-head"{{if eq $.ScrollToItemKey (printf "qz:%s" .ID)}} lvt-fx:scroll="into-view"{{end}}>
    <span class="quiz-probe quiz-probe-{{.Probe}}">{{.Probe}}</span>{{if .Ungrounded}}<span class="quiz-ungrounded" title="This question cites {{.AnchorLabel}}, which is not in this diff — treat it with suspicion">⚠ cites {{.AnchorLabel}}, not in this diff</span>{{end}}
  </div>
  <p class="quiz-prompt">{{.Prompt}}</p>
  <ul class="quiz-options">
    {{$item := .}}
    {{range $i, $opt := .Options}}
    <li>
      {{if $item.Answered}}
      <div class="quiz-option{{if eq $i $item.Answer}} is-correct{{end}}{{if and (eq $i $item.Choice) (ne $i $item.Answer)}} is-wrong{{end}}"><span class="quiz-mark">{{if eq $i $item.Answer}}✓{{else}}{{if eq $i $item.Choice}}✗{{else}} {{end}}{{end}}</span>{{$opt}}</div>
      {{else}}
      <form method="POST" style="margin:0"><input type="hidden" name="quizId" value="{{$item.QuizID}}"><input type="hidden" name="questionId" value="{{$item.ID}}"><input type="hidden" name="choice" value="{{$i}}"><button type="submit" name="answerQuestion" class="quiz-option quiz-option-btn">{{$opt}}</button></form>
      {{end}}
    </li>
    {{end}}
  </ul>
  {{if .Answered}}<p class="quiz-why{{if .Correct}} is-correct{{else}} is-wrong{{end}}"><small>{{.Why}}</small></p>{{end}}{{template "thread" .Thread}}{{if .Replying}}
  <form method="POST" class="reply-form" lvt-on:keydown="postReply" lvt-key="Mod+Enter">
    <input type="hidden" name="id" value="{{.ThreadID}}">
    <textarea name="body" placeholder="Ask the agent to clarify or revise this question…" lvt-on:input="saveReplyDraft" lvt-mod:debounce="200" lvt-autofocus>{{.ReplyDraft}}</textarea>
    <div class="reply-actions">
      <button type="submit" name="cancelReply" class="secondary outline">Cancel</button>
      <button type="submit" name="postReply">Send reply</button>
    </div>
  </form>
  {{else}}
  <form method="POST" class="quiz-card-actions"><input type="hidden" name="id" value="{{.ThreadID}}"><button type="submit" name="openReply" class="outline quiz-reply-btn">Reply</button></form>
  {{end}}
</div>

=== quizPanel ===
{{if $.HasQuiz}}
  <p class="quiz-sub"><small>on the whole change — every question also sits inline next to the code it asks about; this is the overview</small></p>
  {{range $.QuizFiles}}
  <h4 class="quiz-file"><code>{{.File}}</code></h4>
  <ol class="quiz-list">
    {{range .Items}}
    <li class="quiz-q{{if .Answered}} is-answered{{end}}" data-key="{{.ID}}">
      <div class="quiz-q-head">
        <span class="quiz-probe quiz-probe-{{.Probe}}">{{.Probe}}</span>
        {{if .Jumpable}}
        <form method="POST" style="margin:0">
          <input type="hidden" name="file" value="{{.File}}">
          <input type="hidden" name="line" value="{{.FromLine}}">
          <input type="hidden" name="side" value="{{.Side}}">
          <button type="submit" name="jumpToQuizLine" class="quiz-jump" title="Go read the code this asks about">{{.AnchorLabel}}</button>
        </form>
        {{else}}{{if .Ungrounded}}
        <span class="quiz-ungrounded" title="The quiz cited {{.AnchorLabel}}, but that line is not in this diff — treat the question with suspicion">⚠ cited {{.AnchorLabel}}, not in this diff</span>
        {{else}}
        <span class="quiz-absent" title="This question is about something the change does NOT contain, so there is no line to jump to">about something absent</span>
        {{end}}{{end}}
      </div>
      <p class="quiz-prompt">{{.Prompt}}</p>
      <ul class="quiz-options">
        {{$item := .}}
        {{range $i, $opt := .Options}}
        <li>
          {{if $item.Answered}}
          <div class="quiz-option{{if eq $i $item.Answer}} is-correct{{end}}{{if and (eq $i $item.Choice) (ne $i $item.Answer)}} is-wrong{{end}}">
            <span class="quiz-mark">{{if eq $i $item.Answer}}✓{{else}}{{if eq $i $item.Choice}}✗{{else}} {{end}}{{end}}</span>{{$opt}}
          </div>
          {{else}}
          <form method="POST" style="margin:0">
            <input type="hidden" name="quizId" value="{{$item.QuizID}}">
            <input type="hidden" name="questionId" value="{{$item.ID}}">
            <input type="hidden" name="choice" value="{{$i}}">
            <button type="submit" name="answerQuestion" class="quiz-option quiz-option-btn">{{$opt}}</button>
          </form>
          {{end}}
        </li>
        {{end}}
      </ul>
      {{if .Answered}}
      <p class="quiz-why{{if .Correct}} is-correct{{else}} is-wrong{{end}}"><small>{{.Why}}</small></p>
      {{end}}
    </li>
    {{end}}
  </ol>
  {{end}}
  <footer class="quiz-foot">
    {{if $.QuizComplete}}<p class="quiz-done"><strong>{{$.QuizScoreLabel}}</strong> — every question answered.</p>{{end}}
    {{if gt $.QuizAnsweredCount 0}}
    <form method="POST" style="margin:0">
      <button type="submit" name="retakeQuiz" class="outline" title="Clear your answers and take it again">Retake</button>
    </form>
    {{end}}
    {{template "quizAsk" $}}
  </footer>
  {{else}}
  <div class="empty quiz-empty">
    <p>No quiz yet.</p>
    <p><small>Ask the agent for a few questions about the whole change, to check you understood it before you accept it.</small></p>
    {{template "quizAsk" $}}
  </div>
  {{end}}
=== regionToggle ===
<form method="POST" class="region-toggle">
  <button type="submit" name="toggleRegionSelect" class="{{if $.RegionSelectArmed}}contrast{{else}}outline secondary{{end}}" aria-pressed="{{if $.RegionSelectArmed}}true{{else}}false{{end}}">{{if $.RegionSelectArmed}}Selecting region — tap to cancel{{else}}▭ Select a region to comment{{end}}</button>
</form>
=== replyForm ===
<form method="POST" class="reply-form" lvt-on:keydown="postReply" lvt-key="Mod+Enter">
    <input type="hidden" name="id" value="{{.ReplyingID}}">
    <textarea name="body" placeholder="Reply to the agent…" lvt-on:input="saveReplyDraft" lvt-mod:debounce="200" lvt-autofocus>{{.ReplyDraft}}</textarea>
    <div class="reply-actions">
      <button type="submit" name="cancelReply" class="secondary outline">Cancel</button>
      <button type="submit" name="postReply">Send reply</button>
    </div>
  </form>
=== searchPalette ===
<div class="search-backdrop{{if .SearchOpen}} is-open{{end}}" lvt-on:click="closeSearch" aria-hidden="true"></div>
<div class="search-modal{{if .SearchOpen}} is-open{{end}}" role="dialog" aria-label="Search files" aria-modal="true">
  {{if .SearchOpen}}
  <div class="search-head">
    <span class="search-head-icon">{{template "iconSearch"}}</span>
    <form method="POST" lvt-form:preserve class="search-input-form">
      <input type="text" name="q" value="{{.SearchQuery}}" placeholder="Search file names & contents…" lvt-autofocus lvt-on:input="setSearchQuery" lvt-mod:debounce="200" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
    </form>
    <form method="POST">
      <button type="submit" name="toggleSearchScope" class="search-scope outline" title="Toggle search scope (changed files vs all files)">{{.SearchScopeLabel}} <span class="search-scope-count">{{.SearchScopeCount}}</span></button>
    </form>
    <form method="POST">
      <button type="submit" name="closeSearch" class="outline close-btn" aria-label="Close">{{template "iconClose16"}}</button>
    </form>
  </div>
  <div class="search-body">
    {{if .SearchHits}}
    <ul class="search-list">{{range .SearchHits}}
      <li class="search-item{{if eq .Kind "file"}} is-file{{end}}">
        <form method="POST">
          <input type="hidden" name="file" value="{{.File}}">
          <input type="hidden" name="old" value="{{.OldNum}}">
          <input type="hidden" name="new" value="{{.NewNum}}">
          <button type="submit" name="jumpToSearchResult" class="search-hit">
            <span class="search-where"><code>{{.File}}</code>{{if eq .Kind "line"}} <small>L{{.NewNum}}</small>{{else}} <small class="search-filematch">file name</small>{{end}}</span>{{if eq .Kind "line"}}<span class="search-line">{{.Line}}</span>{{end}}</button>
        </form>
      </li>{{end}}
    </ul>
    {{if .SearchTruncated}}<p class="search-note">Showing the first {{len .SearchHits}} matches — narrow your search.</p>{{end}}
    {{else}}{{if .SearchQuery}}
    <p class="search-empty">No matches for “{{.SearchQuery}}”.</p>
    {{else}}
    <p class="search-empty">Type to search file names and contents.</p>
    {{end}}{{end}}
  </div>
  {{end}}
</div>
=== shortcutsTab ===
<section class="lib-shortcuts">
  <p class="sc-intro">One-tap comments for a line, a text selection or a block. The ones you use most come first. Add your own as Markdown files in <code>~/.config/prereview/shortcuts/</code>; an accepted learning can add one too.</p>
  <ul class="lib-list">
    {{range .Rows}}<li class="lib-card sc-row{{if .Hidden}} is-hidden{{end}}" data-key="sc-{{.Slug}}">
      <header><b class="sc-label">{{.Label}}</b><span class="ck-pill">{{.Source}}</span><span class="sc-uses">{{.Uses}} use{{if ne .Uses 1}}s{{end}}</span><form method="POST" class="sc-toggle"><button type="submit" name="{{if .Hidden}}showShortcut{{else}}hideShortcut{{end}}" value="{{.Slug}}" class="outline secondary">{{if .Hidden}}Show{{else}}Hide{{end}}</button></form></header>
      <p class="sc-body">{{.Body}}</p>
    </li>{{end}}
  </ul>
</section>
=== skillNotice ===
{{if .SkillNotice}}
<div class="skill-notice" role="status">
  <div class="skill-notice-body">
    <strong>prereview's agent skill</strong>
    <ul>{{range .SkillNotice}}
      <li><b>{{.Name}}</b>: {{.Status}}{{with .Fix}}. Run <code>{{.}}</code> to replace it with this version's copy.{{end}}</li>{{end}}
    </ul>
    {{if $.SkillReload}}<p>Reload the skill in your agent: a session that's already running still has the old copy.</p>{{end}}
  </div>
  <form method="POST" class="toast-dismiss-form">
    <button type="submit" name="dismissSkillNotice" class="toast-dismiss" aria-label="Dismiss">{{template "iconClose14"}}</button>
  </form>
</div>{{end}}
=== skillsTab ===

  {{if .Cards}}<div class="lib-pointers">
    <form method="POST" class="lib-auto-form"><button type="submit" name="toggleAgentPointers" class="lib-auto" role="switch" aria-checked="{{if .PointersOff}}false{{else}}true{{end}}" title="Add a short note to each agent's memory file saying to load these skills before writing prose, and have Claude Code run prereview check after each doc edit"><span class="ck-switch{{if .PointersOff}} off{{end}}" aria-hidden="true"></span>Tell agents to use these skills</button></form>
    {{if .Pointers}}<div class="lc-agents">{{range .Pointers}}<span class="ck-pill {{if .OK}}ck-pass{{else}}ck-muted{{end}}" title="{{.Where}}: {{.State}}">{{.Label}}{{if .OK}} ✓{{else}} — {{.State}}{{end}}</span>{{end}}</div>{{end}}
  </div>{{end}}
  <ul class="lib-list">
    {{range .Proposals}}<li class="lib-card is-proposed" data-key="skill-proposal-{{.Scope}}">
      <header><span class="ck-pill ck-new">proposed</span><span>{{.Count}} accepted learnings share the scope “{{.Scope}}”</span></header>
      <p class="lc-text">{{.Scope}}</p>
      <div class="lc-row"><span>would extend <b>Writing</b> with its own skill for these {{.Count}} learnings</span></div>
      <div class="lc-actions"><form method="POST"><input type="hidden" name="scope" value="{{.Scope}}"><button type="submit" name="createSkill" class="accept">Create skill</button></form><form method="POST"><input type="hidden" name="scope" value="{{.Scope}}"><button type="submit" name="dismissSkillScope" class="outline secondary">Not now</button></form></div>
    </li>
    {{end}}{{range .Cards}}<li class="lib-card" data-key="skill-{{.ID}}">
      <header><span class="ck-pill ck-pass">prereview's</span><span><code>{{.SourceRel}}</code></span></header>
      <p class="lc-text">{{.Name}}</p>
      <div class="lc-row"><span><b>{{.Lines}}</b> instruction{{if ne .Lines 1}}s{{end}}</span><span><b>{{.Checkers}}</b> checker{{if ne .Checkers 1}}s{{end}}</span><span><b>{{.Judges}}</b> judge{{if ne .Judges 1}}s{{end}}</span><span>scope: {{.Scope}}</span></div>
      <div class="lc-agents">{{range .Installs}}<span class="ck-pill {{if .OK}}ck-pass{{else}}ck-muted{{end}}" title="{{.State}}">{{.Label}}{{if .OK}} ✓{{else}} — {{.State}}{{end}}</span>{{end}}</div>
      {{if gt .Lines 50}}<div class="lc-conflict"><b>{{.Lines}} instructions</b>: a skill this long starts to contradict itself. Give a scope its own skill, or reject the learnings that overlap.</div>{{end}}
      {{if .Edited}}<div class="lc-conflict"><b>You edited this skill</b>, so prereview stopped regenerating it from your learnings; its installs follow your edit.</div>{{end}}
      {{with .History}}{{template "libHistory" .}}{{end}}
      <div class="lc-actions">
        {{if .Versions}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="expandSkill" class="outline" aria-expanded="{{if .History}}true{{else}}false{{end}}">{{if .History}}Hide history{{else}}History ({{.Versions}}){{end}}</button></form>{{end}}
        {{if .EditorURL}}<a role="button" class="outline" href="{{.EditorURL}}" title="{{.Source}}">Open SKILL.md in editor</a>{{end}}
        {{if .Edited}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="regenerateSkill" class="outline">Regenerate from learnings</button></form>{{end}}
      </div>
      {{if not .EditorURL}}<input class="check-path" type="text" readonly value="{{.Source}}" aria-label="Skill file path">{{end}}
    </li>
    {{end}}{{range .Imported}}<li class="lib-card" data-key="skill-imported-{{.Name}}">
      <header><span class="ck-pill ck-advisory">imported · by reference</span><span><code>{{.PathRel}}</code> · {{if .Changed}}changed since you imported it{{else}}unchanged since import{{end}}</span></header>
      <p class="lc-text">{{.Name}}</p>
      <div class="lc-row"><span>prereview never edits this folder</span>{{with .Checks}}<span><b>{{.}}</b> check{{if ne . 1}}s{{end}} read from its <code>evals/</code></span>{{end}}</div>
      {{with .Skipped}}<details class="lc-drafted"><summary>{{len .}} grader{{if ne (len .) 1}}s{{end}} not used</summary><ul class="lc-evidence">{{range .}}<li>{{.}}</li>{{end}}</ul></details>{{end}}
      {{if .Overlay}}<div class="lc-conflict"><b>{{.Overlay}} learning{{if ne .Overlay 1}}s{{end}} attached as an overlay</b> (their scope is “{{.Name}}”).{{if .Changed}} The skill changed since you imported it, so check where the patch lands.{{end}} Export them as a patch to apply to the skill yourself.</div>{{end}}
      <div class="lc-actions">
        {{if .Overlay}}<a role="button" class="outline" href="/_library-skill-patch?name={{.Name}}" download>Export patch</a>{{end}}
        {{if .EditorURL}}<a role="button" class="outline" href="{{.EditorURL}}" title="{{.Path}}">Open in editor</a>{{end}}
        <form method="POST"><input type="hidden" name="name" value="{{.Name}}"><button type="submit" name="forgetImport" class="outline secondary">Stop tracking</button></form>
      </div>
    </li>
    {{end}}{{if .Found}}<li class="lib-card" data-key="skill-found">
      <header><span class="ck-pill ck-muted">found on this machine</span></header>
      <p class="lc-text">Import a skill</p>
      {{range .Found}}<div class="lc-row" data-key="skill-found-{{.Hash}}"><span><code>{{.Where}}</code>{{if gt .Copies 1}} ({{.Copies}} copies){{end}} · {{if .HasEvals}}instructions + <code>evals/</code>{{else}}instructions only{{end}}</span>
        <form method="POST" class="ckp-inline"><input type="hidden" name="hash" value="{{.Hash}}"><button type="submit" name="importSkill" class="outline">Import {{.Name}}</button></form></div>
      {{end}}
    </li>
    {{end}}
  </ul>
  {{with .Empty}}<p class="ckp-empty">{{.}}</p>{{end}}

=== sourceBadge ===
<small class="source-badge" title="Imported from {{.Name}}">{{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener noreferrer">{{.Name}}</a>{{else}}{{.Name}}{{end}}{{with .Author}} · {{.}}{{end}}</small>
=== statusBanners ===
{{if .Quitting}}
<div class="banner-stopping" role="status">
  Server stopping… you can close this tab.
</div>
{{end}}

{{if .SessionEnded}}
<div class="banner-stopping" role="status">
  Session ended — Claude has been notified. You can close this tab.
</div>
{{end}}

{{if .Flash}}
<div class="toast flash-toast" role="status" lvt-fx:auto-click="3000:clearFlash">
  <span class="toast-msg">{{.Flash}}</span>
  <form method="POST" class="toast-dismiss-form">
    <button type="submit" name="clearFlash" class="toast-dismiss" aria-label="Dismiss">
      {{template "iconClose14"}}
    </button>
  </form>
</div>
{{end}}
{{if .LearnAdded}}
<div class="toast learn-toast{{if .Flash}} below-flash{{end}}" role="status" aria-live="polite">
  <span class="toast-msg">{{.LearnAddedLabel}}</span>
  <span class="toast-actions">
    <form method="POST"><button type="submit" name="reviewLearned" class="outline">Review</button></form>
    <form method="POST"><button type="submit" name="undoLearned" class="outline secondary" title="Remove {{if eq (len .LearnAdded) 1}}it{{else}}them{{end}} from your skills">Undo</button></form>
    <form method="POST" class="toast-dismiss-form">
      <button type="submit" name="dismissLearned" class="toast-dismiss" aria-label="Dismiss">
        {{template "iconClose14"}}
      </button>
    </form>
  </span>
</div>
{{end}}
{{if and .AgentMode (eq .LLMState "working")}}
<div class="toast llm-working" role="status" aria-live="polite">
  <span class="llm-spinner" aria-hidden="true"></span>
  <span class="toast-msg">{{.AgentWorkingLabel}}</span>
</div>
{{end}}
=== suggestionCard ===
{{$d := index $.DecisionsBySuggestion .ID}}{{$applied := index $.Applied .ID}}{{$g := index $.SuggestionGroups .ID}}<div class="inline-suggestion{{if .AnchorOutdated}} is-outdated{{end}}{{if $g.Total}} is-grouped{{end}}{{if $d.Verdict}} is-decided sg-{{$d.Verdict}}{{end}}{{if $applied}} is-applied{{end}}" data-key="sg-{{.ID}}"{{if eq $.ScrollToItemKey (printf "sg:%s" .ID)}} lvt-fx:scroll="into-view"{{end}} lvt-fx:animate="fade"><header><span class="sg-label">{{template "iconSuggestion"}} suggestion</span>{{if $g.Total}} <small class="sg-group-tag" title="{{$g.Total}} alternatives for this text — accepting one auto-rejects the rest">alternative {{$g.Index}} of {{$g.Total}}</small>{{end}} · <small>{{.LineSpan}}</small>{{with .For}} · <form method="POST" class="sg-for"><input type="hidden" name="id" value="{{.}}"><button type="submit" name="jumpToComment" class="sg-for-btn" title="Part of a change your comment asked for: go to it">for your comment</button></form>{{end}}{{if .AnchorMoved}} · <small class="moved-badge">moved</small>{{end}}{{if and .AnchorOutdated (not $applied)}} · <small class="outdated-badge">outdated</small>{{end}}{{if eq $d.Verdict "accept"}} · <small class="sg-verdict-badge sg-accept">{{if $applied}}applied{{else}}accepted{{end}}</small>{{end}}{{if eq $d.Verdict "reject"}} · <small class="sg-verdict-badge sg-reject" title="{{if $d.Auto}}not chosen — you accepted another alternative for this text{{else}}rejected by you{{end}}">{{if $d.Auto}}not chosen{{else}}rejected{{end}}</small>{{end}}{{if index $.AwaitingAgent .ID}} · {{template "awaitingBadge"}}{{end}}<span class="sg-hide-actions">{{if $g.Total}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="hideSuggestionGroup" class="sg-hide-btn" title="Hide all {{$g.Total}} alternatives for this text">Hide all</button></form>{{end}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="hideSuggestion" class="sg-hide-btn" title="Hide this suggestion from view">Hide</button></form>
    </span>
  </header>{{if .Note}}<div class="sg-note">{{.Note}}</div>{{end}}<div class="sg-diff{{if not .ProposedText}} is-deletion{{end}}">{{if .OriginalText}}<pre class="sg-old">{{.OriginalText}}</pre>{{end}}{{if .ProposedText}}<pre class="sg-new">{{.ProposedText}}</pre>{{else}}<p class="sg-del-note">delete — accepting removes {{.LineSpan}}</p>{{end}}
  </div>{{if and .AnchorOutdated (not $applied)}}<details class="anchor-orig"><summary>⚠ the document changed here — the original text is gone</summary><pre>{{.OriginalText}}</pre></details>{{end}}{{template "thread" (index $.Threads .ID)}}{{if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{else}}<div class="sg-reply-open"><form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="openReply" class="outline">Reply</button></form></div>{{end}}{{if $applied}}{{if $d.Revert}}<div class="sg-actions"><small class="sg-applied-status sg-reverting">Reverting — the agent will restore the original text.</small></div>{{else}}<div class="sg-actions">
    <small class="sg-applied-status">Edit applied to the file.</small>
    <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="requestRevert" class="outline sg-revert-btn">Revert</button></form>
  </div>{{end}}{{else}}{{if not .AnchorOutdated}}{{if $d.Verdict}}<div class="sg-actions">
    <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="clearSuggestionDecision" class="outline">Undo</button></form>
  </div>{{else}}<div class="sg-actions">
    <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="acceptSuggestion" class="outline sg-accept-btn">Accept</button></form>
    <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="rejectSuggestion" class="outline sg-reject-btn">Reject</button></form>
  </div>{{end}}{{end}}{{end}}</div>
=== thread ===
{{if .}}<div class="thread">{{range .}}<div class="thread-entry thread-{{.Author}}">
    <div class="thread-meta"><span class="thread-author">{{.Who}}</span>{{if .When}} · <small class="thread-when">{{.When}}</small>{{end}}</div>
    <div class="thread-body">{{.Body}}</div>
  </div>{{end}}</div>{{end}}
=== tocOverlay ===
{{with .RenderedHeadings}}
<div class="toc-backdrop{{if $.TOCOpen}} is-open{{end}}" lvt-on:click="closeTOC" aria-hidden="true"></div>
<div class="toc-modal{{if $.TOCOpen}} is-open{{end}}" role="dialog" aria-label="Table of contents" aria-modal="true">
  <div class="toc-modal-head">
    <strong>On this page</strong>
    <form method="POST">
      <button type="submit" name="closeTOC" class="outline close-btn" aria-label="Close">
        {{template "iconClose16"}}
      </button>
    </form>
  </div>
  <nav class="toc-modal-list">
    {{range .}}<a href="#{{.ID}}" lvt-spy-link lvt-on:click="navigateToHeading" data-id="{{.ID}}" class="toc-link toc-l{{.Level}}">{{.Text}}</a>
    {{end}}
  </nav>
</div>
{{end}}
=== tocSidebar ===
{{with .RenderedHeadings}}
<aside class="toc-sidebar" aria-label="Table of contents">
  
  <div class="toc-head">
    <form method="POST">
      <button type="submit" name="toggleTOC" class="collapse-toggle" aria-label="{{if $.TocCollapsed}}Show contents{{else}}Hide contents{{end}}" aria-expanded="{{if $.TocCollapsed}}false{{else}}true{{end}}" title="{{if $.TocCollapsed}}Show contents{{else}}Hide contents{{end}}{{with index $.KeyHint "toggleTOC"}} ({{.}}){{end}}">{{if $.TocCollapsed}}{{template "iconChevronLeft"}}{{else}}{{template "iconChevronRight"}}{{end}}</button>
    </form>
    <strong>On this page</strong>
  </div>
  <nav class="toc-list">
    {{range .}}<a href="#{{.ID}}" lvt-spy-link class="toc-link toc-l{{.Level}}">{{.Text}}</a>
    {{end}}
  </nav>
</aside>
{{end}}
=== toolbar ===
<header class="bar" lvt-fx:url-hash="setURLHash" data-lvt-url-hash="{{.URLHash}}">
  <form method="POST">
    <button type="submit" name="toggleFiles" class="hamburger outline contrast" aria-label="Toggle files">{{template "iconHamburger"}}</button>
  </form>{{if .LiveAvailable}}{{template "liveToggle" $}}{{end}}
  
  {{if not .ExternalMode}}
  <form method="POST">
    <button type="submit" name="openSearch" class="search-btn outline contrast" aria-label="Search files" title="Search files (⌘/Ctrl + K)">{{template "iconSearch"}}</button>
  </form>
  {{end}}
  <div class="title">
    <span class="title-main">{{if .ShowAllComments}}{{else}}{{if .LiveShowing}}<span class="title-page">{{.LivePageLabel}}</span> <small class="live-count">· {{len .RegionComments}} annotation{{if ne (len .RegionComments) 1}}s{{end}}</small>{{else}}{{if .CurrentDiff}}<span class="title-file">{{.CurrentDiff.Path}}</span>{{else}}<small>Pick a file from {{len .Files}} file{{if ne (len .Files) 1}}s{{end}}</small>{{end}}{{end}}{{end}}</span>
  </div>
  
  <div class="toolbar-inline">
    {{if not .LiveShowing}}<div class="tb-group tb-counters">
      
      <small class="auto-saved-long">{{len .Files}} files{{if gt .ChangedFilesCount 0}} · {{.ChangedFilesCount}} changed{{end}} · {{.ScopeViewedCount}}/{{.ScopeFileCount}} viewed</small>
    </div>{{end}}
    {{if .FileShowing}}
    <div class="tb-group tb-toggles">
      
      {{if .IsMarkdown}}
      <form method="POST" class="tb-radios" aria-label="Markdown view">
        <label><input type="radio" name="view" value="rendered" {{if not .RawMarkdown}}checked{{end}} lvt-on:change="setMarkdownView">Preview</label>
        <label><input type="radio" name="view" value="raw" {{if .RawMarkdown}}checked{{end}} lvt-on:change="setMarkdownView">Raw</label>
      </form>
      {{end}}
      {{if .IsHTML}}
      <form method="POST" class="tb-radios" aria-label="HTML view">
        <label><input type="radio" name="view" value="rendered" {{if not .RawHTML}}checked{{end}} lvt-on:change="setHTMLView">Preview</label>
        <label><input type="radio" name="view" value="raw" {{if .RawHTML}}checked{{end}} lvt-on:change="setHTMLView">Raw</label>
      </form>
      {{end}}
      
      {{if not .ShowRenderedHTML}}
      <form method="POST" class="tb-radios" aria-label="File view">
        <label><input type="radio" name="view" value="diff" {{if not .FileView}}checked{{end}} lvt-on:change="setFileViewMode">Diff</label>
        <label><input type="radio" name="view" value="file" {{if .FileView}}checked{{end}} lvt-on:change="setFileViewMode">File</label>
      </form>
      {{end}}
    </div>
    {{end}}
    
{{template "viewMenu" $}}
  </div>
  
  {{if and (gt (len .Files) 1) (not .LiveShowing)}}
  <form method="POST" class="nav-prev">
    <button type="submit" name="prevFile" title="Previous file" aria-label="Previous file" class="contrast">{{template "iconChevronLeft"}}<span class="nav-label">Prev{{with index $.KeyHint "prevFile"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span></button>
  </form>
  <form method="POST" class="nav-next">
    <button type="submit" name="nextFile" title="Next file" aria-label="Next file" class="contrast"><span class="nav-label">Next{{with index $.KeyHint "nextFile"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>{{template "iconChevronRight"}}</button>
  </form>
  {{end}}{{template "libraryButton" $}}
  
  {{if .AgentMode}}
{{template "workQueue" $}}
  {{else}}
  <form method="POST" class="tb-action">
    <button type="button" command="show-modal" commandfor="confirm-quit" class="contrast" title="Stop the prereview server">Quit</button>
  </form>
  {{end}}
  
  <form method="POST" style="margin:0">
    <button type="submit" name="toggleMoreMenu" class="more-trigger" aria-label="More options" aria-haspopup="menu" aria-expanded="{{if .MoreMenuOpen}}true{{else}}false{{end}}">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="5" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="12" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="19" r="1.8" fill="currentColor"/>
      </svg>
    </button>
  </form>
</header>
=== understandView ===
<section class="quiz understand">
  <header class="quiz-head">
    <strong>Understand this change</strong>
    <form method="POST" style="margin:0">
      <button type="submit" name="toggleUnderstand" class="outline contrast" title="Return to the file you were viewing">Back</button>
    </form>
  </header>
  <div class="lib-tabs understand-tabs" role="tablist">
    <form method="POST"><input type="hidden" name="tab" value="walkthrough"><button type="submit" name="setUnderstandTab" data-tab="walkthrough" class="lib-tab{{if eq $.UnderstandTabOn "walkthrough"}} is-on{{end}}" role="tab" aria-selected="{{if eq $.UnderstandTabOn "walkthrough"}}true{{else}}false{{end}}">Walkthrough{{with $.CurrentExplanation}} <span class="ck-pill">{{len .Steps}}</span>{{end}}</button></form>{{if $.HasDiagrams}}
    <form method="POST"><input type="hidden" name="tab" value="diagrams"><button type="submit" name="setUnderstandTab" data-tab="diagrams" class="lib-tab{{if eq $.UnderstandTabOn "diagrams"}} is-on{{end}}" role="tab" aria-selected="{{if eq $.UnderstandTabOn "diagrams"}}true{{else}}false{{end}}">Diagrams <span class="ck-pill">{{len $.CurrentExplanation.Diagrams}}</span></button></form>{{end}}
    <form method="POST"><input type="hidden" name="tab" value="quiz"><button type="submit" name="setUnderstandTab" data-tab="quiz" class="lib-tab{{if eq $.UnderstandTabOn "quiz"}} is-on{{end}}" role="tab" aria-selected="{{if eq $.UnderstandTabOn "quiz"}}true{{else}}false{{end}}">Quiz{{with $.QuizScoreLabel}} <span class="quiz-score">{{.}}</span>{{end}}</button></form>
  </div>
  {{if eq $.UnderstandTabOn "quiz"}}{{template "quizPanel" $}}{{else}}{{if eq $.UnderstandTabOn "diagrams"}}{{template "diagramsPanel" $}}{{else}}{{template "walkthroughPanel" $}}{{end}}{{end}}
</section>
=== versionSummary ===
{{if .Initial}}<span class="vs-note">Initial version — the starting point.</span>{{else}}{{if .Deleted}}<span class="vs-note">File removed at this version.</span>{{else}}{{if .Binary}}<span class="vs-note">Binary file changed.</span>{{else}}<span class="vs-stat"><span class="vs-add">+{{.Added}}</span> <span class="vs-rem">−{{.Removed}}</span></span>{{end}}{{end}}{{end}}
=== viewMenu ===
    <div class="tb-dropdown" lvt-el:toggleClass:on:click="open" lvt-el:removeClass:on:click-away="open">
      <button type="button" class="contrast theme-toggle tb-dropdown-trigger" aria-haspopup="menu" title="View options — focus, color scheme &amp; mode, comment filters, help"><span class="tb-label">View</span>{{template "iconChevronDown"}}</button>
      <div class="tb-dropdown-panel" role="menu" aria-label="View options">
        {{if .FileShowing}}
        
        <form method="POST">
          <button type="submit" name="toggleFocusMode" class="menu-item{{if .FocusMode}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{template "iconFocus"}}</span>
            <span class="menu-label">{{if .FocusMode}}Exit focus{{else}}Focus{{end}}{{with index $.KeyHint "toggleFocusMode"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
          </button>
        </form>
        {{end}}
        
        <form method="POST">
          <button type="submit" name="cycleScheme" class="menu-item" role="menuitem">
            <span class="menu-icon">{{template "iconPalette"}}</span>
            <span class="menu-label">Scheme: {{.SchemeLabel}}</span>
            <span class="menu-meta">{{.NextSchemeLabel}} →</span>
          </button>
        </form>
        <form method="POST">
          <button type="submit" name="cycleTheme" class="menu-item" role="menuitem">
            <span class="menu-icon">{{if eq .ThemeMode "light"}}{{template "iconThemeLight"}}{{else}}{{if eq .ThemeMode "dark"}}{{template "iconThemeDark"}}{{else}}{{template "iconThemeSystem"}}{{end}}{{end}}</span>
            <span class="menu-label">Mode: {{.ThemeModeLabel}}</span>
            <span class="menu-meta">{{.NextThemeModeLabel}} →</span>
          </button>
        </form>
        
        {{if gt .CommentCount 0}}
        <form method="POST">
          <button type="submit" name="toggleCommentList" class="menu-item{{if .ShowAllComments}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{template "iconComments"}}</span>
            <span class="menu-label">{{if .ShowAllComments}}Back{{else}}All comments{{end}}{{with index $.KeyHint "toggleCommentList"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
            <span class="menu-meta">{{.CommentCount}}</span>
          </button>
        </form>
        {{end}}
        
        {{if .HasUnderstandContent}}
        <form method="POST">
          <button type="submit" name="toggleUnderstand" class="menu-item{{if .ShowUnderstand}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{template "iconQuiz"}}</span>
            <span class="menu-label">{{if .ShowUnderstand}}Back{{else}}Understand{{end}}{{with index $.KeyHint "toggleUnderstand"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
            <span class="menu-meta">{{.QuizScoreLabel}}</span>
          </button>
        </form>
        {{end}}
        
        {{if gt .ResolvedCount 0}}
        <form method="POST">
          <button type="submit" name="toggleShowResolved" class="menu-item{{if .ShowResolved}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{if .ShowResolved}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
            <span class="menu-label">{{if .ShowResolved}}Hide resolved{{else}}Show resolved{{end}}{{with index $.KeyHint "toggleShowResolved"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
            <span class="menu-meta">{{.ResolvedCount}}</span>
          </button>
        </form>
        {{end}}
        
        {{if and .ShowResolved (gt .HiddenResolvedCount 0)}}
        <form method="POST">
          <button type="submit" name="unhideAllResolved" class="menu-item" role="menuitem">
            <span class="menu-icon">{{template "iconCircle16"}}</span>
            <span class="menu-label">Unhide</span>
            <span class="menu-meta">{{.HiddenResolvedCount}}</span>
          </button>
        </form>
        {{end}}
        
        {{if gt .SuggestionCount 0}}
        <form method="POST">
          <button type="submit" name="toggleSuggestions" class="menu-item{{if not .HideSuggestions}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{template "iconSuggestion"}}</span>
            <span class="menu-label">{{if .HideSuggestions}}Show suggestions{{else}}Hide suggestions{{end}}{{with index $.KeyHint "toggleSuggestions"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
            <span class="menu-meta">{{.SuggestionCount}}</span>
          </button>
        </form>
        {{end}}{{if $.HasMechanical}}
        
        <form method="POST">
          <button type="submit" name="toggleFoldMechanical" class="menu-item{{if not .UnfoldMechanical}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{if .UnfoldMechanical}}{{template "iconCircle16"}}{{else}}{{template "iconCheck"}}{{end}}</span>
            <span class="menu-label">Fold mechanical changes</span>
          </button>
        </form>
        {{end}}
        
        {{if $.HasMarks}}
        <form method="POST">
          <button type="submit" name="toggleMarks" class="menu-item{{if not .HideMarks}} is-on{{end}}" role="menuitem">
            <span class="menu-icon">{{if .HideMarks}}{{template "iconCircle16"}}{{else}}{{template "iconCheck"}}{{end}}</span>
            <span class="menu-label">{{if .HideMarks}}Show annotations{{else}}Hide annotations{{end}}{{with index $.KeyHint "toggleMarks"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span>
          </button>
        </form>
        {{end}}
        
        {{if gt .HiddenSuggestionCount 0}}
        <form method="POST">
          <button type="submit" name="showHiddenSuggestions" class="menu-item" role="menuitem">
            <span class="menu-icon">{{template "iconSuggestion"}}</span>
            <span class="menu-label">Show hidden suggestions</span>
            <span class="menu-meta">{{.HiddenSuggestionCount}}</span>
          </button>
        </form>
        {{end}}
        
        {{if gt .DecisionCount 0}}
        <div class="menu-info sg-decision-count">{{.DecisionCount}} suggestion decision{{if ne .DecisionCount 1}}s{{end}} recorded</div>
        {{end}}
        
        {{if and (gt .OutdatedCount 0) (not .ShowAllComments)}}
        <form method="POST">
          <button type="submit" name="toggleCommentList" class="menu-item" role="menuitem" title="{{.OutdatedCount}} comment{{if ne .OutdatedCount 1}}s{{end}} need re-anchoring — open the list to fix">
            <span class="menu-icon">{{template "iconWarning"}}</span>
            <span class="menu-label">Outdated</span>
            <span class="menu-meta">{{.OutdatedCount}}</span>
          </button>
        </form>
        {{end}}
        
        <form method="POST">
          <button type="submit" name="toggleKeyboardHelp" class="menu-item" role="menuitem">
            <span class="menu-icon" aria-hidden="true">?</span>
            <span class="menu-label">Keyboard shortcuts</span>
          </button>
        </form>
        
        <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
          <span class="menu-icon">{{template "iconBook"}}</span>
          <span class="menu-label">Usage guide</span>
        </a>
      </div>
    </div>
=== viewerPrompts ===
{{if and .LastDeletedComment (not .Quitting)}}
<div class="undo-toast" role="status">
  <span>Comment on <code>{{.LastDeletedComment.Location}}</code> {{.LastDeletedComment.LineSpan}} deleted</span>
  <span class="toast-actions">
    <form method="POST" style="margin:0;display:inline">
      <button type="submit" name="undoDelete" class="undo-btn">Undo</button>
    </form>
    <form method="POST" class="toast-dismiss-form">
      <button type="submit" name="dismissUndo" class="toast-dismiss" aria-label="Dismiss">{{template "iconClose14"}}</button>
    </form>
  </span>
</div>
{{end}}

{{if and .LastResolvedIDs (not .Quitting)}}
<div class="undo-toast" role="status">
  <span>Resolved {{len .LastResolvedIDs}} comment{{if ne (len .LastResolvedIDs) 1}}s{{end}}</span>
  <span class="toast-actions">
    <form method="POST" style="margin:0;display:inline">
      <button type="submit" name="undoResolveAll" class="undo-btn">Undo</button>
    </form>
    <form method="POST" class="toast-dismiss-form">
      <button type="submit" name="dismissResolveUndo" class="toast-dismiss" aria-label="Dismiss">{{template "iconClose14"}}</button>
    </form>
  </span>
</div>
{{end}}{{if and .ReanchorCommentID (eq .SelectionEndMax 0)}}
<div class="reanchor-prompt" role="status">
  <span>Re-anchoring — tap the line(s) this comment should attach to.</span>
  <form method="POST" class="toast-dismiss-form">
    <button type="submit" name="clearSelection" class="toast-dismiss" aria-label="Cancel re-anchoring">{{template "iconClose14"}}</button>
  </form>
</div>
{{end}}
{{if .EditsSettling}}

<div class="reanchor-prompt edits-settling-prompt" role="status">
  <span>Files under review are changing on disk — you'll be offered a refresh once the edits settle.</span>
</div>
{{else}}{{if .PendingRefresh}}

<div class="reanchor-prompt refresh-prompt" role="status">
  <span>The agent edited files on disk. This view still shows the earlier version — refresh to see the changes.</span>
  <form method="POST" class="toast-dismiss-form">
    <button type="submit" name="refreshDiff" class="refresh-btn">Refresh diff</button>
  </form>
</div>
{{end}}{{end}}
{{if .AgentPaused}}

<div class="reanchor-prompt paused-prompt" role="status">
  <span>⏸ Batching — comments are held, not sent to the agent yet.</span>
  <form method="POST" class="toast-dismiss-form">
    <button type="submit" name="resumeAgent" class="refresh-btn">Resume — send batch</button>
  </form>
</div>
{{end}}{{if .AgentStalled}}

<div class="reanchor-prompt agent-stall-prompt" role="status">
  <span>{{.AgentPhaseLabel}}</span>
</div>
{{end}}
=== walkthroughPanel ===
{{with $.CurrentExplanation}}
  {{if .Summary}}<p class="walk-summary">{{.Summary}}</p>{{end}}
  {{if .Stale}}<p class="walk-stale" role="status">Written before the last edit to the files, so a step may no longer match the code.</p>{{end}}
  {{with $.NotExplained}}<p class="walk-stale walk-unexplained" role="status">⚠ {{len .}} change{{if ne (len .) 1}}s{{end}} no step explains. They are the last step.</p>{{end}}
  <form method="POST" class="walk-start"><button type="submit" name="startWalkthrough" title="Read the change step by step, file to file">Start the walkthrough</button></form>
  <ol class="walk-steps">
    {{range $.WalkSteps}}
    <li class="walk-step{{if .NotExplained}} walk-step-unexplained{{end}}{{if .InConcern}} walk-in-concern{{end}}" data-key="step-{{.ID}}">{{if .Concern}}<div class="walk-concern"><span class="walk-concern-title">{{.Concern.Title}}</span> · {{.Concern.Steps}} step{{if ne .Concern.Steps 1}}s{{end}}{{if .Concern.Mechanical}} · mechanical{{if .Concern.Folded}} · {{.Concern.Folded}} line{{if ne .Concern.Folded 1}}s{{end}} fold{{end}}{{end}}</div>{{end}}
      <div class="walk-title"><span class="ck-pill walk-num">{{.Num}}</span> <span class="walk-title-text">{{.Title}}</span><form method="POST" class="walk-from"><input type="hidden" name="step" value="{{.Num}}"><button type="submit" name="startWalkthrough" class="outline" title="Walk from this step">Walk from here</button></form></div>
      {{if .Body}}<p class="walk-body">{{.Body}}</p>{{end}}{{if .Risks}}<ul class="walk-risks">{{range .Risks}}<li><span class="ck-pill ck-fail risk-chip">{{.Kind}}</span>{{if .Note}} {{.Note}}{{end}}</li>{{end}}</ul>{{end}}
      <ul class="walk-anchors">
        {{range .Anchors}}
        <li>{{template "anchorItem" .}}</li>
        {{end}}
      </ul>{{if .Impact}}<div class="walk-impact"><strong>Affects</strong><ul>{{range .Impact}}<li>{{if .Ungrounded}}<span class="quiz-ungrounded" title="The walkthrough says the change affects {{.Label}}, but that line isn't in the files — treat it with suspicion">⚠ {{.Label}}, not found</span>{{else}}{{if .Linkable}}{{template "anchorJump" .}}{{else}}<span class="walk-impact-label" title="Outside this review">{{.Label}}</span>{{end}}{{end}}{{if .Note}} <span class="walk-impact-note">— {{.Note}}</span>{{end}}</li>{{end}}</ul></div>{{end}}
    </li>
    {{end}}
  </ol>
  {{if $.CanExplain}}<footer class="quiz-foot">{{template "explainButton" $}}</footer>{{end}}
{{else}}
  <div class="empty quiz-empty">
    <p>No walkthrough yet.</p>
    <p><small>Ask the agent to walk you through the whole change, step by step, in the order it makes sense to read. prereview checks every line it cites.</small></p>
    {{if $.CanExplain}}{{template "explainButton" $}}{{else}}<p><small>Run prereview with <code>--agent</code> to ask an agent for one.</small></p>{{end}}
  </div>
{{end}}
=== workQueue ===
  <div class="tb-dropdown queue-dropdown{{if .AgentPaused}} is-paused{{end}}" lvt-el:toggleClass:on:click="open" lvt-el:removeClass:on:click-away="open">
    <button type="button" id="queue-trigger-{{.EnqueueTick}}" class="contrast tb-dropdown-trigger queue-trigger{{if .AgentWorking}} is-working{{end}}{{if .AgentPaused}} is-paused{{end}}" aria-haspopup="menu" title="{{if .AgentPaused}}Batching — comments held, not sent. {{end}}Work queue: queued, blocked, worked-on, drafts; Pause/Resume + End session inside">{{if .AgentPaused}}<span class="queue-paused-dot" aria-hidden="true">⏸</span>{{else}}{{if .AgentPhase}}<span class="agent-dot is-{{.AgentPhase}}" aria-hidden="true"></span>{{end}}{{end}}<span class="tb-label">Queue</span>{{if .AwaitingReplyCount}}<span class="q-num q-awaiting-reply" title="your replies still awaiting the agent (whole review)">{{.AwaitingReplyCount}}</span>{{end}}{{if .HasQueue}}<span class="queue-counts">{{if .AwaitingApplyCount}}<span class="q-num q-awaiting" title="accepted, not yet applied to the file">{{.AwaitingApplyCount}}</span> · {{end}}<span class="q-num q-queued">{{.QueuedCount}}</span>{{if .BlockedCount}} · <span class="q-num q-blocked" title="anchor gone — needs re-anchoring before the agent can act">{{.BlockedCount}}</span>{{end}}{{if .AnsweredCount}} · <span class="q-num q-answered" title="the agent replied with no edit — read its answer, then resolve or reply">{{.AnsweredCount}}</span>{{end}}{{if .DoneCount}} · <span class="q-num q-done">{{.DoneCount}}</span>{{end}}{{if .DraftCount}} · <span class="q-num q-draft">{{.DraftCount}}</span>{{end}}</span>{{end}}{{template "iconChevronDown"}}</button>
    <div class="tb-dropdown-panel queue-panel" role="menu" aria-label="Work queue">
      
      <form method="POST" class="queue-pause-form">
        <button type="submit" name="toggleAgentPause" class="queue-pause-btn{{if .AgentPaused}} is-paused{{end}}">{{if .AgentPaused}}▶ Resume — send batch{{if .QueuedCount}} ({{.QueuedCount}}){{end}}{{else}}⏸ Pause — batch comments{{end}}{{with index $.KeyHint "toggleAgentPause"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</button>
      </form>
      <div class="queue-mode{{if .AgentPaused}} is-batching{{end}}">{{if .AgentPaused}}Batching: comments are held, not sent. Resume sends them together.{{else}}Live: each comment is sent to the agent as you save it.{{end}}</div>
      {{with .AgentPhaseLabel}}<div class="queue-agent is-{{$.AgentPhase}}"><span class="agent-dot is-{{$.AgentPhase}}" aria-hidden="true"></span>{{.}}</div>{{end}}
      
      {{if not .SingleFile}}
      <form method="POST" class="queue-scope-form">
        <button type="submit" name="toggleQueueScope" class="queue-scope-btn" role="menuitemcheckbox" aria-checked="{{if .QueueGlobal}}true{{else}}false{{end}}" title="Show this file's work, or the whole review's">
          <span class="queue-scope-opt{{if not .QueueGlobal}} is-on{{end}}">This file</span><span class="queue-scope-opt{{if .QueueGlobal}} is-on{{end}}">All files</span>
        </button>
      </form>
      {{end}}
      
      {{if .AwaitingReplyCount}}<div class="queue-awaiting-reply"><span class="q-num q-awaiting-reply">{{.AwaitingReplyCount}}</span> repl{{if eq .AwaitingReplyCount 1}}y{{else}}ies{{end}} awaiting the agent (whole review)</div>{{end}}{{if .AwaitingPickCount}}<div class="queue-awaiting-pick"><span class="q-num q-pick">{{.AwaitingPickCount}}</span> fork{{if ne .AwaitingPickCount 1}}s{{end}} awaiting your pick: the agent offered alternatives, accept one (whole review)</div>{{end}}
      {{if .HasQueue}}
      <div class="queue-legend"><span class="q-num q-queued">{{.QueuedCount}}</span> queued{{if .BlockedCount}} · <span class="q-num q-blocked">{{.BlockedCount}}</span> need re-anchoring{{end}}{{if .AnsweredCount}} · <span class="q-num q-answered">{{.AnsweredCount}}</span> answered{{end}} · <span class="q-num q-done">{{.DoneCount}}</span> done{{if .DraftCount}} · <span class="q-num q-draft">{{.DraftCount}}</span> draft{{end}}{{if .QueueHiddenCount}} · <span class="q-num q-elsewhere">{{.QueueHiddenCount}}</span> on other files{{end}}</div>
      
      {{if .AwaitingApplyCount}}
      <div class="queue-awaiting"><span class="q-num q-awaiting">{{.AwaitingApplyCount}}</span> accepted, awaiting the agent to apply {{if eq .AwaitingApplyCount 1}}it{{else}}them{{end}} to the file</div>
      {{end}}
      {{range .QueueItems}}
      
      <div class="queue-row queue-{{.State}} queue-kind-{{.Kind}}">
        <form method="POST" class="queue-jump-form">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="{{if eq .Kind "suggestion"}}jumpToSuggestion{{else}}jumpToComment{{end}}" class="queue-item" title="Go to this {{.Kind}}">
            {{if eq .Kind "suggestion"}}<span class="queue-kind-icon" aria-hidden="true">✦</span>{{end}}
            <span class="queue-badge queue-badge-{{.State}}">{{.State}}</span>
            <span class="queue-body">{{.Body}}</span>
            <span class="queue-loc" title="{{.File}}{{if .Line}}:{{.Line}}{{end}}">{{.File}}{{if .Line}}:{{.Line}}{{end}}</span>
          </button>
        </form>{{if and (eq .State "done") (eq .Kind "comment")}}
        
        <form method="POST" class="queue-reenqueue-form">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="reenqueueComment" class="queue-reenqueue" title="Re-enqueue — ask the agent to redo this" aria-label="Re-enqueue">↺</button>
        </form>{{end}}
      </div>
      {{end}}
      {{else}}{{if .QueueHiddenCount}}
      
      <div class="queue-empty">Nothing queued on this file — <strong>{{.QueueHiddenCount}}</strong> item{{if ne .QueueHiddenCount 1}}s{{end}} on other files. Switch to <strong>All files</strong> to see {{if eq .QueueHiddenCount 1}}it{{else}}them{{end}}.</div>
      {{else}}
      <div class="queue-empty">Nothing queued yet — comments you add stream to the agent automatically.</div>
      {{end}}{{end}}
      
      <button type="button" command="show-modal" commandfor="confirm-end-session" class="queue-end-btn" role="menuitem">End session</button>
    </div>
  </div>
