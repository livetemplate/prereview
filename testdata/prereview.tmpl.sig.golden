=== allComments ===
<section class="all-comments">
  <header class="ac-head">
    <strong>All comments ({{.CommentCount}})</strong>
    {{if .UnresolvedListed}}<form method="POST" class="ac-resolve-all">
      <button type="submit" name="resolveAll" class="outline" title="Resolve every comment listed here">Resolve all {{.UnresolvedListed}}</button>
    </form>{{end}}
    <form method="POST" style="margin:0">
      <button type="submit" name="toggleCommentList" class="outline contrast" title="Return to the file you were viewing">Back</button>
    </form>
  </header>
  {{if .VisibleComments}}
  <ul class="ac-list">
    {{range .VisibleComments}}
    <li class="ac-item{{if .Resolved}} is-resolved{{end}}" data-key="{{.ID}}">
      <form method="POST" class="ac-jump">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" name="jumpToComment" class="ac-jump-btn">
          <div class="ac-where"><code>{{.Location}}</code> · {{.LineSpan}}{{with .Side}} <small>({{.}})</small>{{end}}{{if .Resolved}} <small class="resolved-badge">resolved</small>{{end}}{{if .AnchorMoved}} <small class="moved-badge">moved</small>{{end}}{{if and .AnchorEdited (not .Resolved) (not .Processed)}} <small class="edited-badge" title="exactly these lines were edited — likely addressed; confirm and resolve">likely addressed</small>{{end}}{{if .AnchorOutdated}} <small class="outdated-badge">outdated</small>{{end}}{{if .Processed}} {{template "processedBadge"}}{{end}}{{if eq (index $.CommentQueueStates .ID) "answered"}} {{template "answeredBadge"}}{{end}}{{with .Source}} {{template "sourceBadge" .}}{{end}}</div>
          <div class="ac-body">{{.Headline}}</div>
        </button>
      </form>
      {{if .AnchorOutdated}}<details class="anchor-orig"><summary>⚠ the document changed here — originally anchored to:</summary><pre>{{.Anchor.Text}}</pre></details>{{end}}
      <div class="ac-actions">
        <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="toggleResolved" class="outline">{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>
        {{if .Resolved}}<form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="hideComment" class="outline">Hide</button>
        </form>{{end}}
        {{if and (not .Resolved) .AnchorOutdated}}<form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="reanchorComment" class="outline">Re-anchor</button>
        </form>{{end}}
        {{if and (not .Resolved) (not .AnchorOutdated)}}<form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="editComment" class="outline">Edit</button>
        </form>{{end}}
        <button type="button" class="secondary outline" command="show-modal" commandfor="confirm-delete-{{.ID}}">Delete</button>
        {{template "deleteDialog" .}}
      </div>
    </li>
    {{end}}
  </ul>
  {{else}}
  
  <div class="ac-empty">
    <p class="ac-empty-msg">{{if and (gt .CommentCount 0) (not .ShowResolved)}}{{.CommentCount}} resolved comment{{if ne .CommentCount 1}}s{{end}} hidden — toggle “Show resolved” to see them.{{else}}No comments yet.{{end}}</p>
    <form method="POST" style="margin:0">
      <button type="submit" name="toggleCommentList" class="contrast ac-empty-back" title="Return to the file you were viewing">← Back to file</button>
    </form>
  </div>
  {{end}}
</section>
=== anchorItem ===
{{if .Ungrounded}}<span class="quiz-ungrounded" title="The walkthrough cites {{.Label}}, but the review has no such line — treat it with suspicion">⚠ {{.Label}}, not in this review</span>{{else}}{{template "anchorJump" .}}{{end}}
=== anchorJump ===
<form method="POST" style="margin:0"><input type="hidden" name="file" value="{{.File}}"><input type="hidden" name="side" value="{{.Side}}"><input type="hidden" name="line" value="{{.Line}}"><button type="submit" name="jumpToAnchor" class="quiz-jump" title="Go read the code this cites">{{.Label}}</button></form>
=== answeredBadge ===
<small class="answered-badge" title="the agent replied with no edit — read its answer, then resolve or reply">answered</small>
=== awaitingBadge ===
<small class="awaiting-badge" title="you replied — waiting on the agent">awaiting agent</small>
=== benchTab ===
{{$canAdd := .CanAdd}}
  <ul class="lib-list">
    {{range .Cards}}<li class="lib-card" data-key="bench-{{.ID}}">
      <header><span>{{.Cases}} case{{if ne .Cases 1}}s{{end}} · {{.Checkers}} checker{{if ne .Checkers 1}}s{{end}} · {{.Judges}} judge{{if ne .Judges 1}}s{{end}} · {{if .Weighted}}weighted{{else}}weights equal{{end}}</span>{{if .Asking}}<span class="ck-pill ck-new">waiting for your agent</span>{{end}}</header>
      <p class="lc-text">{{.Name}}</p>
      <div class="bm-score">{{.Score}} <small>{{.Spread}}</small></div>
      {{if .Rows}}<div class="bm-table-wrap"><table class="bm-table">
        <thead><tr><th>Case</th>{{range .Headers}}<th class="c">{{.}}</th>{{end}}</tr></thead>
        <tbody>{{range .Rows}}<tr><td>{{.Label}}</td>{{range .Cells}}<td class="c {{.Class}}" title="{{.Title}}">{{.Mark}}</td>{{end}}</tr>{{end}}</tbody>
      </table></div>{{end}}
      {{with .Runs}}<details class="bm-runs"><summary>Runs (pinned: check versions + judge model)</summary>
        <div class="bm-table-wrap"><table class="bm-table"><thead><tr><th>When</th><th>Score</th><th>Judge model</th><th>Checks</th></tr></thead><tbody>
          {{range .}}<tr{{if not .Comparable}} class="bm-incomparable" title="Different checks, cases or model: not comparable with the latest run"{{end}}><td>{{.When}}</td><td>{{.Score}}</td><td>{{.Model}}</td><td>{{.Pins}}{{if not .Comparable}} · not comparable{{end}}</td></tr>
          {{end}}</tbody></table></div></details>{{end}}
      <div class="lc-actions">
        <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="runBenchmark"{{if or (not .Rows) (not .Headers)}} disabled{{end}}>Run benchmark</button></form>
        {{if $canAdd}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="addBenchmarkCase" class="outline">Add the open file as a case</button></form>{{end}}
        {{if .EditorURL}}<a role="button" class="outline secondary" href="{{.EditorURL}}" title="{{.DefPath}}">Open in editor</a>{{end}}
      </div>
      {{if not .EditorURL}}<input class="check-path" type="text" readonly value="{{.DefPath}}" aria-label="Benchmark file path">{{end}}
    </li>
    {{end}}{{if .CanAdd}}<li class="lib-card" data-key="bench-new">
      <p class="lc-text">New benchmark</p>
      <form method="POST" class="lib-bench-new"><label>Name <input type="text" name="name" placeholder="Release notes" autocomplete="off" required></label><button type="submit" name="createBenchmark" class="outline">Create from the open file</button></form>
      <p class="ck-src">The open file becomes its first case (a snapshot: later edits don't move it), scored by every check that applies to it. Change its checks and weights in its <code>benchmark.yml</code>.</p>
    </li>
    {{else}}{{if not .Cards}}<li class="lib-card"><p class="ckp-empty">Open a file to start a benchmark from it.</p></li>
    {{end}}{{end}}{{with .Judges}}<li class="lib-card" data-key="bench-calibration">
      <header><span>judge calibration · your Agree/Disagree answers are the labels</span></header>
      <p class="lc-text">Judge agreement</p>
      <div class="bm-table-wrap"><table class="bm-table"><thead><tr><th>Judge</th><th>Agrees</th><th>Status</th></tr></thead><tbody>
        {{range .}}<tr><td>{{.Name}}</td><td>{{.Agrees}}</td><td><span class="ck-pill {{if .Calibrated}}ck-pass{{else}}ck-advisory{{end}}">{{.Status}}</span></td></tr>
        {{end}}</tbody></table></div>
    </li>{{end}}
  </ul>

=== binaryView ===
{{with $.CurrentDiff}}  
  {{$kind := $.BinaryKind}}
  {{if eq $kind "image"}}
  
  {{template "regionToggle" $}}{{if not $.RegionSelectArmed}}<small class="region-hint">Pinch or scroll to zoom; use the button above to comment on a region.</small>{{end}}<div class="binary-preview binary-image"><div class="image-with-areas{{if $.RegionSelectArmed}} is-armed{{end}}" data-key="iwa-{{.Path}}">
    <img src="/{{.Path}}" alt="{{.Path}}" {{if $.RegionSelectArmed}}lvt-fx:area-select="selectImageArea" style="touch-action:none;user-select:none;-webkit-user-select:none;"{{else}}style="user-select:none;-webkit-user-select:none;"{{end}}>
    {{range $.AreaComments}}<div class="area-overlay{{if .Resolved}} is-resolved{{end}}{{if index $.AgentActedLabels .ID}} is-acted{{end}}" data-key="ao-{{.ID}}" style="left:{{.Area.PercentX}};top:{{.Area.PercentY}};width:{{.Area.PercentW}};height:{{.Area.PercentH}};" title="{{with index $.AgentActedLabels .ID}}{{.}} — {{end}}{{.Body}}"></div>{{end}}
    {{if eq $.CommentMode "area"}}<div class="area-overlay area-overlay-pending" data-key="ao-pending" style="left:{{$.SelectionArea.PercentX}};top:{{$.SelectionArea.PercentY}};width:{{$.SelectionArea.PercentW}};height:{{$.SelectionArea.PercentH}};"></div>{{end}}
  </div></div>
  {{else}}{{if eq $kind "pdf"}}
  
  <div class="binary-preview binary-pdf-card">
    <div class="pdf-card-icon" aria-hidden="true">📄</div>
    <strong class="pdf-card-name">{{.Path}}</strong>
    <a role="button" class="contrast pdf-card-open" href="/{{.Path}}" target="_blank" rel="noopener">Open PDF in new tab →</a>
  </div>
  {{else}}{{if eq $kind "video"}}
  <div class="binary-preview binary-video"><video controls preload="metadata" src="/{{.Path}}"></video></div>
  {{else}}{{if eq $kind "audio"}}
  <div class="binary-preview binary-audio"><audio controls preload="metadata" src="/{{.Path}}"></audio></div>
  {{else}}
  <p class="empty">Binary file — cannot display.</p>
  {{end}}{{end}}{{end}}{{end}}{{end}}
=== blockComments ===
{{$bs := .StartLine}}{{$be := .EndLine}}{{range $.FileComments}}{{if and (ge .ToLine $bs) (le .ToLine $be)}}{{template "commentCardFull" .}}{{end}}{{end}}{{if and (ne $.SelectionEndMax 0) (ge $.SelectionEndMax $bs) (le $.SelectionEndMax $be)}}{{template "composer" $}}{{end}}
=== blockSuggestions ===
{{$bs := .StartLine}}{{$be := .EndLine}}{{range $.FileSuggestions}}{{if and (ge .ToLine $bs) (le .ToLine $be)}}{{template "suggestionCard" .}}{{end}}{{end}}{{with index $.HiddenSuggestionBlocks (printf "MB-%d-%d" $bs $be)}}{{template "hiddenMarker" .}}{{end}}
=== bootCard ===

  <section class="boot" data-key="boot" aria-label="{{if .Reading}}Learning from your reviews{{else}}Learn from your past reviews{{end}}">
    {{if .Reading}}
    <h2>Learning from your reviews…</h2>
    <div class="boot-progress" aria-hidden="true"><span></span></div>
    {{if .Stalled}}<p>Waiting for your agent's learner. It starts one in the background when it launches the review; if it didn't, ask it to start it (<code>prereview learn wait</code>).</p>
    {{else}}<p>Your agent's learner is reading them in the background{{if .Waiting}} · {{.Waiting}} learning{{if ne .Waiting 1}}s{{end}} waiting for you below{{end}}. You can keep reviewing; you'll be told when learnings are added.</p>{{end}}
    {{else}}{{if .Scanning}}
    <h2>Looking for past reviews…</h2>
    <div class="boot-progress" aria-hidden="true"><span></span></div>
    {{else}}{{if not .Stores}}
    <h2>No past reviews found</h2>
    <p>No review on this machine has comments yet. Learnings come from what you say in reviews.</p>
    {{else}}
    <h2>Learn from your past reviews</h2>
    <p>prereview found {{len .Stores}} review{{if ne (len .Stores) 1}}s{{end}} with comments on this machine. Your agent can read the comments, replies and accept/reject decisions in the ones you tick, in the background, and {{if .AutoAccept}}add what it learns to your skills: you're told each time, and can undo it{{else}}propose learnings for you to accept: nothing takes effect until you do{{end}}. Nothing is read until you ask.</p>
    <ul class="boot-list">
      {{range .Stores}}<li data-key="boot-{{.Store}}"><form method="POST"><input type="hidden" name="store" value="{{.Store}}"><button type="submit" name="toggleBootStore" class="boot-item" role="checkbox" aria-checked="{{if .Picked}}true{{else}}false{{end}}" title="{{.Store}}"><span class="boot-box" aria-hidden="true">{{if .Picked}}✓{{end}}</span><span class="bp">{{.Label}}</span><span class="bc">{{.Counts}}</span></button></form></li>
      {{end}}
    </ul>
    <div class="boot-actions">
      <form method="POST"><button type="submit" name="readPastReviews"{{if or (not .CanRead) (not .Picked)}} disabled{{end}}>Read {{.Picked}} with my agent</button></form>
      <form method="POST"><button type="submit" name="dismissPastReviews" class="outline secondary">Not now</button></form>
      <span class="boot-note">{{if .CanRead}}Later: Library → Learnings → Read past reviews{{else}}Reading needs an agent: start prereview with <code>--agent</code>.{{end}}</span>
    </div>
    {{end}}{{end}}{{end}}
  </section>

=== checkRow ===

          <li class="ckp-row is-{{.Status}}{{if .Expanded}} is-open{{end}}" data-key="ckp-row-{{.ID}}">
            <form method="POST" class="ckp-row-form"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="expandCheck" class="ckp-row-head" aria-expanded="{{if .Expanded}}true{{else}}false{{end}}">
              <span class="ck-pill ck-{{.Status}}">{{.Status}}</span>
              <span class="ckp-title"><span class="ckp-name">{{.Name}}{{if .IsJudge}} <span class="ck-judge-tag">judge</span>{{end}}</span>{{with .Description}}<span class="ckp-desc">{{.}}</span>{{end}}</span>
              <span class="ckp-sum">{{if .MatchNote}}{{.MatchNote}}{{else}}{{.Summary}}{{end}}</span>
              <span class="ckp-src">{{.SourceLabel}}</span>
              <span class="ckp-chev" aria-hidden="true">{{if .Expanded}}▾{{else}}▸{{end}}</span>
            </button></form>
            {{if .Expanded}}
            <div class="ckp-detail">
              {{if or .QueueAll .IgnoreAll .Ignored}}<div class="ckp-bulk">
                {{if .QueueAll}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="queueAllFindings" class="outline" title="Queue each one as a comment for your agent">Queue all {{.QueueAll}}</button></form>{{end}}
                {{if .IgnoreAll}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="dismissAllFindings" class="outline secondary" aria-pressed="false" title="They're fine: stop flagging them">Ignore all {{.IgnoreAll}}</button></form>
                {{else}}{{if .Ignored}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="restoreAllDismissed" class="outline secondary is-on" aria-pressed="true" title="Bring back the {{.Ignored}} you ignored">Ignored {{.Ignored}}</button></form>{{end}}{{end}}
              </div>{{end}}
              {{range .Errors}}<p class="ckp-err"><code>{{.Path}}</code>: {{.Err}}</p>
              {{end}}
              {{range .Verdicts}}
              <div class="ckp-file jv{{if eq .Status "stale"}} is-stale{{end}}" data-key="ckp-v-{{.Path}}">
                <header><code>{{.Path}}</code>{{if .Open}} <span class="ck-pill ck-open">open</span>{{end}}<span class="ck-pill ck-{{.Status}}">{{if eq .Status "notrun"}}not run{{else}}{{if eq .Status "stale"}}file changed since{{else}}{{.Status}}{{end}}{{end}}</span>
                </header>
                {{with .Critique}}<p class="jv-critique">{{.}}</p>{{end}}
                {{if and .At (ne .Status "notrun")}}<div class="jv-actions">
                  {{template "judgeVerdictActions" .}}
                </div>{{end}}
              </div>
              {{end}}
              {{range .ByFile}}
              <div class="ckp-file" data-key="ckp-file-{{.Path}}">
                <header><code>{{.Path}}</code>{{if .Open}} <span class="ck-pill ck-open">open</span>{{end}}<span class="ckp-file-n">{{.Count}}</span>{{if .Dismissed}}<form method="POST" class="ckp-dismissed"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="restoreDismissed" class="ck-link" title="Bring back the findings you ignored in this file">{{.Dismissed}} ignored · show again</button></form>{{end}}
                  {{if .Findings}}{{with index .Findings 0}}<form method="POST" class="ckp-show"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="jumpToFinding" class="outline">Show in file</button></form>{{end}}{{end}}
                </header>
                <ol>
                  {{range .Findings}}<li data-key="ckp-f-{{.Path}}-{{.CheckID}}-{{.Index}}">
                    <form method="POST" class="ckp-at-form"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="jumpToFinding" class="ckp-at">{{.Label}}</button></form>
                    <span class="ckp-msg">{{.Message}}</span>
                    {{if .Queued}}<span class="ck-pill ck-open ckp-q" title="Already queued as a comment">Queued</span>{{else}}<form method="POST" class="ckp-q"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="queueFinding" class="outline">Queue</button></form>
                    <form method="POST" class="ckp-q"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="dismissFinding" class="outline secondary" title="It's fine here: stop flagging this one">Ignore</button></form>{{end}}
                  </li>
                  {{end}}
                </ol>
              </div>
              {{end}}
              {{if .More}}<p class="ckp-more">{{.More}} more finding{{if ne .More 1}}s{{end}} not listed; turn the check off, or narrow it with a search.</p>{{end}}
              {{with .Disagreed}}<details class="lc-drafted ckp-disagreed"><summary>You disagreed with {{len .}} verdict{{if ne (len .) 1}}s{{end}}: edit the rubric to fix them</summary><ul class="lc-evidence">{{range .}}<li><span class="ev-where"><code>{{.File}}</code> · it said {{.Verdict}}</span>{{with .Critique}}<br><q>{{.}}</q>{{end}}</li>{{end}}</ul></details>{{end}}
              <div class="ckp-rule">
                <span>{{.Detail}} · category <b>{{.Category}}</b>{{with .Agreement}} · {{.}}{{end}}{{with .RulePath}} · <code>{{.}}</code>{{end}}</span>
                <span class="ckp-rule-actions">
                  {{if eq .Source "learned"}}<span class="ck-src">from a learning: change it on the Learnings tab</span>
                  {{else}}{{if .EditorURL}}<a role="button" class="outline" href="{{.EditorURL}}" title="{{.RulePath}}">Open in editor</a>
                  {{else}}{{if eq .Source "builtin"}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="copyCheckToUserFolder" class="outline" title="Copy this built-in to your checks folder to change it">Edit a copy</button></form>{{end}}{{end}}{{end}}
                  {{if ne .Source "vale"}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="toggleCheckEnabled" class="outline">{{if eq .Status "off"}}Turn on{{else}}Turn off{{end}}</button></form>{{end}}
                </span>
                {{if and .RulePath (not .EditorURL) (ne .Source "learned")}}<input class="check-path" type="text" readonly value="{{.RulePath}}" aria-label="Rule file path">{{end}}
              </div>
              {{with .History}}{{template "libHistory" .}}{{end}}
            </div>
            {{end}}
          </li>

=== checksButton ===
{{with $.CheckSummary}}
    <form method="POST" class="file-head-checks">
      <button type="submit" name="openChecks" class="checks-trigger{{if .Failing}} is-failing{{else}}{{if .Running}} is-running{{else}} is-passing{{end}}{{end}}" title="Checks on this file: {{.Passed}} of {{.Total}} passed{{if .Running}}, {{.Running}} running{{end}}. Opens the Checks page.">{{template "iconCheckList"}}<span class="checks-trigger-label">Checks</span><span class="checks-count">{{.Passed}}/{{.Total}}</span></button>
    </form>
{{end}}
=== checksStrip ===
{{with $.CheckStrip}}
  <div class="ck-strip{{if not .Selected}} is-idle{{end}}{{if .Judge}} is-judge{{end}}" data-key="checks-strip" role="{{if .Selected}}status{{else}}group{{end}}" aria-label="{{if .Judge}}Showing one judge{{else}}{{if .Selected}}Showing one check{{else}}Failing checks on this file{{end}}{{end}}">
    {{if .Judge}}
    <span class="ck-pill ck-{{.Judge.Status}}">{{.Judge.Status}}</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-pill ck-advisory" title="{{if .Calibrated}}Calibrated: counts in Checks n/m{{else}}Advisory: shown, not counted, until it agrees with you often enough{{end}}">judge · {{if .Calibrated}}calibrated{{else}}advisory{{end}}</span>
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this judge">×</button></form>
    {{else}}{{if .Selected}}
    <span class="ck-pill ck-fail">fail</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-strip-nav">
      <form method="POST"><input type="hidden" name="dir" value="-1"><button type="submit" name="stepFinding" class="outline" aria-label="Previous finding">‹</button></form>
      <span class="ck-strip-pos"><span class="ck-pos-long">finding {{.Pos}} of {{.Count}} in this file</span><span class="ck-pos-short" aria-hidden="true">{{.Pos}}/{{.Count}}</span></span>
      <form method="POST"><input type="hidden" name="dir" value="1"><button type="submit" name="stepFinding" class="outline" aria-label="Next finding">›</button></form>
    </span>
    {{if .Hidden}}<form method="POST" class="ck-strip-hidden"><button type="submit" name="showHiddenFindings" class="ck-link" title="Show the cards you hid">{{.Hidden}} hidden · show</button></form>{{end}}
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this check">×</button></form>
    {{else}}
    {{if .Failing}}<form method="POST"><button type="submit" name="toggleCheckStrip" class="outline ck-strip-sum" aria-expanded="{{if .Open}}true{{else}}false{{end}}" title="{{if .Open}}Hide{{else}}Show{{end}} the failing checks">{{len .Failing}} failing{{if .FailingChecks}} · {{.FailingChecks}} check{{if ne .FailingChecks 1}}s{{end}}{{end}}{{if .FailingJudges}} · {{.FailingJudges}} judge{{if ne .FailingJudges 1}}s{{end}}{{end}}{{template "iconChevronDown"}}</button></form>
    {{end}}{{if .JudgesRun}}{{if .NeedsAgent}}<span class="ck-strip-run"><button type="button" class="outline" disabled title="Judges are run by your coding agent">Run judges — needs an agent</button> <a class="ck-link" href="/_usage#judges" target="_blank" rel="noopener">How to start one</a></span>
    {{else}}{{if .JudgeWaiting}}<span class="ck-waiting" role="status">Asked your agent · {{.JudgeWaiting}} judge{{if ne .JudgeWaiting 1}}s{{end}}</span>
    {{else}}<form method="POST" class="ck-strip-run"><button type="submit" name="runJudges" class="outline">{{if .JudgeTimedOut}}No answer yet — run judges again{{else}}{{if .JudgesStale}}Re-run judges ({{.JudgesStale}} stale){{else}}Run judges ({{.JudgesRun}}){{end}}{{end}}</button></form>
    {{end}}{{end}}{{end}}<form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    {{if and .Failing .Open}}<div class="ck-strip-list">{{range .Failing}}<form method="POST" class="ck-strip-pick"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline{{if .Judge}} is-judge{{end}}">{{.Name}} {{if .Judge}}<span class="ck-judge-tag">judge{{if .Advisory}} · advisory{{end}}</span>{{else}}<span class="ck-strip-n">{{.Count}}</span>{{end}}</button></form>
    {{end}}</div>{{end}}
    {{end}}{{end}}
  </div>
  {{with .Judge}}<div class="jv-card" data-key="judge-card" role="note">
    {{with .Critique}}<p class="jv-critique">{{.}}</p>{{end}}
    {{if eq .Status "stale"}}<p class="jv-stale">This verdict is for an older version of the file or the rubric.</p>{{end}}
    <div class="jv-actions">
      {{if .Queued}}<span class="ck-pill ck-open" title="Already queued as a comment">Queued</span>{{else}}<form method="POST"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="queueJudgment" class="outline">Queue as comment</button></form>{{end}}
      {{template "judgeVerdictActions" .}}
    </div>
  </div>{{end}}
{{end}}
=== commentCardFull ===
<div class="inline-comment{{if .Resolved}} is-resolved{{end}}{{if .AnchorOutdated}} is-outdated{{end}}" data-key="{{.ID}}" lvt-fx:animate="fade"{{if and (eq $.ScrollToCommentID .ID) (eq $.SelectionAnchor 0) (eq $.CommentMode "")}} lvt-fx:scroll="into-view" tabindex="-1" lvt-autofocus{{end}}><header><span>{{.LineSpan}} · <small>{{.Side}}</small>{{if .Resolved}} · <small class="resolved-badge">resolved</small>{{end}}{{if .AnchorMoved}} · <small class="moved-badge">moved</small>{{end}}{{if and .AnchorEdited (not .Resolved) (not .Processed)}} · <small class="edited-badge" title="exactly these lines were edited — likely addressed; confirm and resolve">likely addressed</small>{{end}}{{if .AnchorOutdated}} · <small class="outdated-badge">outdated</small>{{end}}{{if .Draft}} · <small class="draft-badge">draft</small>{{end}}{{if .Processed}} · {{template "processedBadge"}}{{end}}{{if eq (index $.CommentQueueStates .ID) "answered"}} · {{template "answeredBadge"}}{{end}}{{if eq .QueueState "queued"}} · {{template "queuedBadge"}}{{end}}{{if index $.AwaitingAgent .ID}} · {{template "awaitingBadge"}}{{end}}{{with .Source}} · {{template "sourceBadge" .}}{{end}}</span></header>{{if .Snippet}}<div class="ic-snippet">{{.Snippet}}</div>{{end}}<div class="body">{{.Body}}</div>{{if .AnchorOutdated}}<details class="anchor-orig"><summary>⚠ the document changed here — originally anchored to:</summary><pre>{{.Anchor.Text}}</pre></details>{{end}}{{with index $.RippleByComment .ID}}<div class="ripple-row" role="group" aria-label="Follow-on edits"><span class="ripple-count">Follow-on edits: {{.Open}} open of {{.Total}}</span>{{if .Acceptable}}<form method="POST"><button type="submit" name="acceptRipple" value="{{.CommentID}}" class="accept">Accept all</button></form>{{end}}{{if .Open}}<form method="POST"><button type="submit" name="rejectRipple" value="{{.CommentID}}" class="outline reject">Reject all</button></form>{{end}}{{if .NeedPick}}<small class="ripple-pick">{{.NeedPick}} set{{if gt .NeedPick 1}}s{{end}} of alternatives need{{if eq .NeedPick 1}}s{{end}} your pick</small>{{end}}</div>{{end}}{{template "thread" (index $.Threads .ID)}}{{if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{end}}<div class="ic-actions">
    <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="toggleResolved" class="outline">{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>{{if ne $.ReplyingID .ID}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="openReply" class="outline">Reply</button></form>{{end}}{{if and $.AgentMode (not .Resolved) (not .AnchorOutdated) .Processed}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="enqueueComment" class="outline enqueue-btn" title="Re-enqueue — ask the agent to redo this">Re-enqueue</button>
    </form>{{end}}{{if .Resolved}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="hideComment" class="outline">Hide</button>
    </form>{{end}}{{if and (not .Resolved) .AnchorOutdated}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="reanchorComment" class="outline">Re-anchor</button>
    </form>{{end}}{{if and (not .Resolved) (not .AnchorOutdated)}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="editComment" class="outline">Edit</button>
    </form>{{end}}<button type="button" class="secondary outline" command="show-modal" commandfor="confirm-delete-{{.ID}}">Delete</button>{{template "deleteDialog" .}}</div></div>
=== commentCardSimple ===
<div class="inline-comment{{if .Resolved}} is-resolved{{end}}" data-key="{{.ID}}"lvt-fx:animate="fade"{{if and (eq $.ScrollToCommentID .ID) (eq $.SelectionAnchor 0) (eq $.CommentMode "")}} lvt-fx:scroll="into-view" tabindex="-1" lvt-autofocus{{end}}><header><span>{{.LineSpan}}{{if .Resolved}} · <small class="resolved-badge">resolved</small>{{end}}{{if .Draft}} · <small class="draft-badge">draft</small>{{end}}{{if .Processed}} · {{template "processedBadge"}}{{end}}{{if eq (index $.CommentQueueStates .ID) "answered"}} · {{template "answeredBadge"}}{{end}}{{if eq .QueueState "queued"}} · {{template "queuedBadge"}}{{end}}{{if index $.AwaitingAgent .ID}} · {{template "awaitingBadge"}}{{end}}{{with .Source}} · {{template "sourceBadge" .}}{{end}}</span></header>{{if .Snippet}}<div class="ic-snippet">{{.Snippet}}</div>{{end}}{{if .RequestSummary}}<details class="req-prompt" lvt-ignore-attrs><summary><span class="req-summary">{{.RequestSummary}}</span> <span class="req-more"></span></summary><div class="body">{{.Body}}</div></details>{{else}}<div class="body">{{.Body}}</div>{{end}}{{template "thread" (index $.Threads .ID)}}{{if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{end}}<div class="ic-actions">
    <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="toggleResolved" class="outline">{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>{{if ne $.ReplyingID .ID}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="openReply" class="outline">Reply</button></form>{{end}}{{if .Resolved}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="hideComment" class="outline">Hide</button>
    </form>{{end}}{{if not .Resolved}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="editComment" class="outline">Edit</button>
    </form>{{end}}<button type="button" class="secondary outline" command="show-modal" commandfor="confirm-delete-{{.ID}}">Delete</button>{{template "deleteDialogTagged" .}}</div></div>
=== composer ===
<div class="composer{{if eq $.CommentMode "region"}} ext-composer{{end}}" data-key="composer{{if $.ComposerNonce}}-{{$.ComposerNonce}}{{end}}"{{if eq $.CommentMode "region"}} lvt-fx:scroll="into-view"{{end}}><strong>{{if eq $.CommentMode "region"}}{{if $.EditingCommentID}}Editing comment on {{else}}Comment on {{end}}region · <small>{{$.CurrentURL}}</small>{{else}}{{if eq $.CommentMode "file"}}{{if $.EditingCommentID}}Editing comment on file{{else}}Comment on file{{end}} <code>{{$.CurrentDiff.Path}}</code>{{else}}{{if eq $.CommentMode "area"}}{{if $.EditingCommentID}}Editing comment on area of{{else}}Comment on area of{{end}} <code>{{$.CurrentDiff.Path}}</code>{{else}}{{if eq $.CommentMode "text"}}{{if $.EditingCommentID}}Editing comment on {{else}}Comment on {{end}}{{$.SelectionLabel}} · “<span class="selection-snippet">{{$.SelectionText}}</span>”{{else}}{{if $.ReanchorCommentID}}Re-anchoring comment to {{else}}{{if $.EditingCommentID}}Editing comment on {{else}}Comment on {{end}}{{end}}{{$.SelectionLabel}}{{end}}{{end}}{{end}}{{end}}</strong>{{if and (eq $.CommentMode "") (ne $.SelectionAnchor 0) (eq $.SelectionAnchor $.SelectionEnd) (not $.EditingCommentID) (not $.ShowRenderedMarkdown) (not $.ShowRenderedHTML)}} <small class="selection-hint">tap another line to extend, or save now for a single line</small>{{end}}<form method="POST" lvt-form:preserve class="composer-add" id="composer-add-form" lvt-on:keydown="addComment" lvt-key="Mod+Enter">{{if $.ShowShortcuts}}<div class="sc-chips" role="group" aria-label="Shortcuts">{{range $.Shortcuts}}<button type="submit" name="useShortcut" value="{{.Slug}}" class="sc-chip" formnovalidate title="{{.Body}}">{{.Label}}</button>{{end}}</div>{{end}}
    <textarea name="body" placeholder="{{if eq $.CommentMode "region"}}What's wrong with this region?{{else}}{{if eq $.CommentMode "file"}}What's wrong with this file?{{else}}{{if eq $.CommentMode "area"}}What's wrong with this region?{{else}}{{if eq $.CommentMode "text"}}What's wrong with this text?{{else}}What's wrong with these lines?{{end}}{{end}}{{end}}{{end}}" required lvt-autofocus lvt-on:input="saveDraft" lvt-mod:debounce="150" data-nonce="{{$.ComposerNonce}}">{{$.DraftBody}}</textarea>
  </form><form method="POST" class="composer-cancel" id="composer-cancel-form"></form><div class="c-actions">
    <button type="submit" name="clearSelection" form="composer-cancel-form" class="cancel-btn">Cancel{{with index $.KeyHint "clearSelection"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</button>
    <button type="submit" name="addComment" form="composer-add-form" class="save-btn">Save{{with index $.KeyHint "addComment"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</button>
  </div></div>
=== deleteDialog ===
<dialog id="confirm-delete-{{.ID}}"><article><header><strong>Delete comment?</strong></header><p><small><code>{{.Location}}</code> {{.LineSpan}}</small></p><footer>
    <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <fieldset role="group">
        <button type="button" command="close" commandfor="confirm-delete-{{.ID}}" class="secondary">Cancel</button>
        <button type="submit" name="deleteComment" class="contrast">Delete</button>
      </fieldset>
    </form>
  </footer></article></dialog>
=== deleteDialogTagged ===
<dialog id="confirm-delete-{{.ID}}"><article><header><strong>Delete comment?</strong></header><p><small>{{if .IsRegionLevel}}<code>{{.URL}}</code> · region{{else}}{{if .IsAreaLevel}}<code>{{.File}}</code> · area{{else}}<code>{{.File}}</code> · file{{end}}{{end}}</small></p><footer>
    <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <fieldset role="group">
        <button type="button" command="close" commandfor="confirm-delete-{{.ID}}" class="secondary">Cancel</button>
        <button type="submit" name="deleteComment" class="contrast">Delete</button>
      </fieldset>
    </form>
  </footer></article></dialog>
=== diagramsPanel ===
<ol class="walk-steps diagram-list">
    {{range $.DiagramViews}}
    <li class="walk-step diagram" data-key="diagram-{{.ID}}">
      {{if .Title}}<div class="walk-title"><span class="walk-title-text">{{.Title}}</span></div>{{end}}
      {{.HTML}}
      {{if .Anchors}}<div class="walk-impact"><strong>Cites</strong><ul>{{range .Anchors}}<li>{{template "anchorItem" .}}</li>{{end}}</ul></div>{{end}}
    </li>
    {{end}}
  </ol>
=== diffView ===
{{with $.CurrentDiff}}  
  <div class="code{{if eq .Note "file added"}} pure-add{{else}}{{if eq .Note "file deleted"}} pure-del{{end}}{{end}}{{if $.FileView}} file-view{{end}}{{if $.WrapLines}} wrap-lines{{end}}" data-key="code-{{.Path}}" data-path="{{.Path}}" lvt-fx:scroll="reset-on:data-path" lvt-fx:text-select="selectText" style="--diff-min-width: calc({{.MaxLineChars}}ch + 7ch)">{{range $.VisibleLines}}{{if or (eq .Kind "fold") (eq .Kind "mech")}}{{if eq .Kind "fold"}}<div class="line-row fold-row" data-key="F{{.OldNum}}-{{.NewNum}}" aria-hidden="true"><span class="fold-label">··· {{.Content}} unchanged line{{if ne .Content "1"}}s{{end}} ···</span></div>{{else}}<form method="POST" class="line-row mech-row" data-key="M{{.OldNum}}-{{.NewNum}}"><input type="hidden" name="hunk" value="{{.Group}}"><button type="submit" name="revealMechanical" class="mech-fold" title="The walkthrough calls these changes mechanical. Tap to read them.">Show {{.Content}} mechanical line{{if ne .Content "1"}}s{{end}} · {{index $.MechTitles .Group}}</button></form>{{end}}{{else}}{{$ln := .NewNum}}{{if not $ln}}{{$ln = .OldNum}}{{end}}{{$lside := "new"}}{{if eq .Kind "del"}}{{$lside = "old"}}{{end}}{{$rowkey := printf "%d-%s" $ln $lside}}{{$commentCount := index $.CommentCountLines $rowkey}}{{$suggestionCount := index $.SuggestionCountLines $rowkey}}{{$hasComment := gt $commentCount 0}}{{$hasSuggestion := gt $suggestionCount 0}}{{$hasQuiz := gt (index $.QuizCountLines $rowkey) 0}}{{$lkey := printf "L%d-%d" .OldNum .NewNum}}<div class="line-row{{if or $hasComment $hasSuggestion $hasQuiz}} has-line-marks{{end}}{{if index $.RowToggled $rowkey}} row-toggled{{end}}" data-key="row-L{{.OldNum}}-{{.NewNum}}{{if and (ne $.SelectionEndMax 0) (eq $.SelectionEndMax $ln) (eq $.SelectionSide $lside)}}-composing{{end}}">{{$sm := index $.StepMarkLines $lkey}}{{if $sm}}<div class="step-mark">{{$sm.Label}}{{range $sm.Risks}} <span class="ck-pill ck-fail risk-chip">{{.}}</span>{{end}}</div>{{end}}<div tabindex="0" lvt-on:click="selectLine" lvt-on:keydown="selectLine" lvt-key="Enter" data-line="{{$ln}}" data-side="{{if eq .Kind "del"}}old{{else}}new{{end}}" class="line {{.Kind}}{{if index $.SelectedLines $ln}} selected{{end}}{{if eq $.CursorKey $lkey}} is-cursor{{end}}"{{if eq $.CursorKey $lkey}} lvt-autofocus lvt-fx:scroll="into-view"{{else}}{{if eq $.ScrollToReadKey $lkey}} lvt-fx:scroll="into-view"{{end}}{{end}} data-key="{{$lkey}}"><span class="gutter"><span class="gutter-mark">{{if eq .Kind "add"}}+{{else}}{{if eq .Kind "del"}}-{{else}}&nbsp;{{end}}{{end}} </span>{{$ln}}</span><span class="content chroma" data-line-text>{{index $.LineDisplay $lkey}}</span></div>{{if or $hasComment $hasSuggestion $hasQuiz}}<span class="line-margin">
        <button type="button" class="line-marks{{if index $.AwaitingLines $rowkey}} has-unread{{end}}" lvt-on:click="toggleRow" data-row="{{$rowkey}}" lvt-el:toggleClass:on:click="row-toggled" data-lvt-target="closest:.line-row" aria-label="Show or hide the annotations on this line" title="Show/hide this line's annotations">
          <span class="line-mark{{if index $.AnnotationOpenLines $rowkey}} is-open{{else}}{{if index $.AnnotationAcceptedLines $rowkey}} is-accepted{{else}} is-done{{end}}{{end}}" aria-hidden="true">{{index $.AnnotationCountLines $rowkey}}</span>
        </button>
      </span>{{end}}{{range (index $.CommentsByEndLine $ln)}}{{if or (eq .Side $lside) (eq .Side "")}}{{template "commentCardFull" .}}{{end}}{{end}}{{range (index $.SuggestionsByEndLine $ln)}}{{if or (eq .Side $lside) (eq .Side "")}}{{template "suggestionCard" .}}{{end}}{{end}}{{with index $.HiddenSuggestionLines $rowkey}}{{template "hiddenMarker" .}}{{end}}{{range (index $.QuizByEndLine $ln)}}{{if or (eq .Side $lside) (eq .Side "")}}{{template "quizCard" .}}{{end}}{{end}}{{range (index $.FindingsByRow $rowkey)}}{{template "findingCard" .}}{{end}}{{if and (ne $.SelectionEndMax 0) (eq $.SelectionEndMax $ln) (eq $.SelectionSide $lside)}}{{template "composer" $}}{{end}}</div>
{{end}}{{end}}<div class="code-sentinel" aria-hidden="true"></div></div>{{end}}
=== endSessionDialog ===
<dialog id="confirm-end-session"><article><header><strong>End session?</strong></header><p><small>Emits the final <code>session_end</code> event and stops the prereview server — your agent stops consuming the stream. This can't be undone.</small></p>{{if .AwaitingApplyCount}}
  <p class="end-warn" role="alert"><small><strong>{{.AwaitingApplyCount}} accepted edit{{if ne .AwaitingApplyCount 1}}s{{end}} not yet applied.</strong> The agent still has to write {{if eq .AwaitingApplyCount 1}}it{{else}}them{{end}} to the file (<code>prereview applied</code>). Ending now leaves the document without {{if eq .AwaitingApplyCount 1}}that change{{else}}those changes{{end}}.</small></p>{{end}}{{if .AwaitingPickCount}}
  <p class="end-warn end-warn-pick" role="alert"><small><strong>{{.AwaitingPickCount}} fork{{if ne .AwaitingPickCount 1}}s{{end}} awaiting your pick.</strong> The agent offered alternatives and is waiting for you to accept one. Ending now leaves {{if eq .AwaitingPickCount 1}}that comment{{else}}those comments{{end}} unaddressed.</small></p>{{end}}<footer>
    <form method="POST">
      <fieldset role="group">
        <button type="button" command="close" commandfor="confirm-end-session" class="secondary">Cancel</button>
        <button type="submit" name="endSession" class="contrast">End session</button>
      </fieldset>
    </form>
  </footer></article></dialog>
=== explainButton ===
{{if $.ExplainPending}}<span class="request-pending" title="The request is queued — the agent will answer shortly">Walkthrough requested…</span>{{else}}<form method="POST" style="margin:0"><button type="submit" name="requestExplain" class="outline" title="Ask the agent to walk you through the whole change">{{if $.HasExplanation}}Explain again{{else}}Explain this change{{end}}</button></form>{{end}}
=== externalBody ===

<header class="bar bar-external">
  <span class="ext-target">prereview · annotating <code>{{.TargetURL}}</code>{{if .CurrentURL}} <span class="ext-page">{{.CurrentURL}}</span>{{end}}</span>
  <span class="bar-actions"><form method="POST" style="margin:0">
      <button type="submit" name="toggleAnnotations" class="outline secondary anno-toggle" aria-pressed="{{if .AnnoDrawerOpen}}true{{else}}false{{end}}" title="Show/hide annotations">💬 {{len $.AllRegionComments}}</button>
    </form>{{if .AgentMode}}
    <form method="POST" style="margin:0">
      <button type="submit" name="toggleAgentPause" class="contrast tb-pause{{if .AgentPaused}} is-paused{{end}}" title="{{if .AgentPaused}}Batching — annotations held, not sent. Resume to send the batch.{{else}}Live — each annotation is sent as you make it. Pause to batch them instead.{{end}}">{{if .AgentPaused}}▶ Resume — send batch{{else}}⏸ Pause — batch{{end}}</button>
    </form><form method="POST" style="margin:0">
      <button type="button" command="show-modal" commandfor="confirm-end-session" class="contrast" title="Emit session_end and stop the server — your agent stops consuming the stream">End session</button>
    </form>{{else}}<form method="POST" style="margin:0">
      <button type="button" command="show-modal" commandfor="confirm-quit" class="contrast" title="Stop the prereview server">Quit</button>
    </form>{{end}}</span>
</header>
{{template "skillNotice" $}}<div class="layout layout-external">
  <main class="viewer ext-viewer">
{{template "liveStage" $}}
  </main>
  <aside class="ext-sidebar{{if .AnnoDrawerOpen}} is-open{{end}}" aria-label="Annotations">
    <header class="ext-sidebar-head"><strong>Annotations ({{len $.AllRegionComments}})</strong><form method="POST" style="margin:0">
        <button type="submit" name="toggleAnnotations" class="outline secondary close-btn" aria-label="Close annotations">{{template "iconClose16"}}</button>
      </form></header>
    <div class="ext-sidebar-body">{{range $.AllRegionComments}}<div class="inline-comment ext-anno{{if .Resolved}} is-resolved{{end}}{{if eq $.FocusedCommentID .ID}} is-focused{{end}}" data-key="{{.ID}}" lvt-fx:animate="fade"><form method="POST" class="anno-locate-form">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" name="focusComment" class="anno-locate" title="Locate this region on the page"><span class="ext-page-link">📍 {{.URL}}</span>{{if .Resolved}} · <small class="resolved-badge">resolved</small>{{end}}{{if .Processed}} · {{template "processedBadge"}}{{end}}{{if eq (index $.CommentQueueStates .ID) "answered"}} · {{template "answeredBadge"}}{{end}}{{if eq .QueueState "queued"}} · {{template "queuedBadge"}}{{end}}{{if index $.AwaitingAgent .ID}} · {{template "awaitingBadge"}}{{end}}<span class="anno-body">{{.Body}}</span></button>
        </form>{{template "thread" (index $.Threads .ID)}}{{if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{end}}<div class="ic-actions">
    <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="toggleResolved" class="outline">{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>{{if ne $.ReplyingID .ID}}<form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="openReply" class="outline">Reply</button></form>{{end}}{{if not .Resolved}}<form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button type="submit" name="editComment" class="outline">Edit</button>
    </form>{{end}}<button type="button" class="secondary outline" command="show-modal" commandfor="confirm-delete-{{.ID}}">Delete</button>{{template "deleteDialogTagged" .}}</div></div>{{else}}<p class="empty"><small>No annotations yet — tap “Select a region”, then drag a box on the page.</small></p>{{end}}</div>
  </aside>
</div>
<footer class="app-footer" role="contentinfo"><small>prereview{{if ne .Version "dev"}} v{{.Version}}{{end}} · external mode · <code>{{.TargetURL}}</code></small></footer>
=== fileDrawer ===
<dialog id="files-drawer" open class="{{if .FileDrawerOpen}}is-open{{end}}" lvt-fx:resize="--pr-drawer-w" data-resize-handle=".resize-handle" data-resize-min="200" data-resize-max="560" data-resize-store="prereview.drawerW">
  
  <div class="drawer-collapse">
    <form method="POST">
      <button type="submit" name="toggleFiles" class="collapse-toggle" aria-label="{{if .FileDrawerOpen}}Show file list{{else}}Hide file list{{end}}" aria-expanded="{{if .FileDrawerOpen}}false{{else}}true{{end}}" title="{{if .FileDrawerOpen}}Show files{{else}}Hide files{{end}}{{with index $.KeyHint "toggleFiles"}} ({{.}}){{end}}">{{if .FileDrawerOpen}}{{template "iconChevronRight"}}{{else}}{{template "iconChevronLeft"}}{{end}}</button>
    </form>
  </div>
  <div class="drawer-head">
    <strong>{{len .Files}} file{{if ne (len .Files) 1}}s{{end}}</strong>
    <form method="POST">
      <button type="submit" name="closeFiles" class="outline close-btn" aria-label="Close">{{template "iconClose16"}}</button>
    </form>
  </div>
  
  
  
  {{if not .NoGit}}
  <div class="drawer-base">
    <form method="POST" class="base-select-form">
      <label for="base-input">Base</label>
      <select id="base-input" name="ref" lvt-on:change="setBase">
        {{range .BaseChoices}}
        <option value="{{.}}"{{if eq . $.Base}} selected{{end}}>{{.}}</option>
        {{end}}
      </select>
    </form>
  </div>
  {{end}}
  <div class="drawer-search">
    <form method="POST" lvt-form:preserve>
      <input type="text" name="filter" placeholder="Filter files…" value="{{.FileFilter}}" lvt-on:input="setFileFilter" lvt-mod:debounce="200" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
    </form>
  </div>
  
  {{if and (gt .ChangedFilesCount 0) (lt .ChangedFilesCount (len .Files))}}
  <div class="drawer-scope">
    <form method="POST">
      <button type="submit" name="toggleFileScope" class="scope-toggle{{if not .ShowAllFiles}} is-on{{end}}" title="{{if .ShowAllFiles}}Show only files changed vs {{.Base}}{{else}}Show all {{len .Files}} tracked files{{end}}">
        {{if .ShowAllFiles}}All {{len .Files}} files · show changed only{{else}}Changed {{.ChangedFilesCount}} · show all {{len .Files}}{{end}}
      </button>
    </form>
  </div>
  {{end}}{{if .HasExplanation}}
  <div class="drawer-scope">
    <form method="POST">
      <button type="submit" name="toggleDrawerOrder" class="scope-toggle{{if .DrawerWalkOrder}} is-on{{end}}" title="Sort the files the way the walkthrough reads them">
        {{if .DrawerWalkOrder}}Walkthrough order · sort A–Z{{else}}A–Z · sort in walkthrough order{{end}}
      </button>
    </form>
  </div>{{end}}
  <div class="drawer-body">
    
    {{.FileBrowserHTML}}
  </div>
  
  <div class="resize-handle" aria-hidden="true"></div>
</dialog>
=== fileHeader ===
{{with $.CurrentDiff}}  <header class="file-head">{{if gt $.ReadPercent 0}}<div class="read-progress-fill" style="width: {{$.ReadPercent}}%" aria-hidden="true"></div>{{end}}<span class="file-head-name" title="{{.Path}}">{{if $.SelectedFileDir}}<span class="fh-dir">{{$.SelectedFileDir}}</span>{{end}}<strong class="fh-base">{{$.SelectedFileBase}}</strong>{{if .Note}} <small>{{.Note}}</small>{{end}}</span>
    
    <span class="file-head-actions">
    
    {{if $.HasReadFrontier}}
    <form method="POST" class="file-head-resume">
      <button type="submit" name="jumpToReadFrontier" class="outline" title="Jump to the first content you haven't read yet">{{template "iconChevronDown"}}<span class="resume-label">Jump to unread</span></button>
    </form>
    {{end}}
    
    {{if and (ne $.CommentMode "file") (not $.ViewingVersion)}}
    <form method="POST" class="file-head-comment">
      <button type="submit" name="openFileComment" class="contrast" title="Add a comment about the whole file" aria-label="Comment on file">{{template "iconChat14"}}<span class="file-head-comment-label">Comment on file{{with index $.KeyHint "openFileComment"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}</span></button>
    </form>
    {{end}}
    
    {{if and (ne $.CommentMode "file") (not $.ViewingVersion) $.ShowUnderstandEntry}}
    <form method="POST" style="margin:0"><button type="submit" name="toggleUnderstand" class="quiz-trigger" title="Walk through the whole change, and quiz yourself on it">{{template "iconQuiz"}}<span class="quiz-trigger-label">Understand</span></button></form>
    {{end}}
    
    {{if and (ne $.CommentMode "file") (not $.ViewingVersion) $.Prompts}}
    <div class="tb-dropdown prompts-dropdown" lvt-el:toggleClass:on:click="open" lvt-el:removeClass:on:click-away="open">
      <button type="button" class="prompts-trigger" aria-haspopup="menu" title="Ask the agent for suggestions using a prebuilt prompt">{{template "iconSuggestion"}}<span class="prompts-trigger-label">Ask for suggestions</span></button>
      <div class="tb-dropdown-panel prompts-panel" role="menu" aria-label="Suggestion prompts">
        {{range $.Prompts}}
        <form method="POST"><input type="hidden" name="slug" value="{{.Slug}}"><button type="submit" name="pickPrompt" class="prompt-row" title="{{.Body}}">{{.Title}}</button></form>
        {{end}}
        
        <a class="prompts-more" role="menuitem" href="/_usage#suggested-edits" target="_blank" rel="noopener">Add your own prompts</a>
      </div>
    </div>
    {{end}}{{if $.ShowChecks}}{{template "checksButton" $}}{{end}}
    
    {{if $.Versions}}
    <div class="tb-dropdown versions-dropdown" lvt-el:toggleClass:on:click="open" lvt-el:removeClass:on:click-away="open">
      <button type="button" class="versions-trigger" aria-haspopup="menu" title="Versions of this file — view or roll back to a previous version">{{template "iconHistory14"}}<span class="versions-trigger-label">Versions</span><span class="versions-count">{{len $.Versions}}</span></button>
      <div class="tb-dropdown-panel versions-panel" role="menu" aria-label="File versions">
        
        {{range $.Versions}}
        <div class="version-row{{if .Viewing}} viewing{{end}}">
          <button type="button" class="version-summary-toggle" lvt-el:toggleClass:on:click="expanded" data-lvt-target="closest:.version-row" aria-label="Show what changed and version actions"><span class="version-meta">
            <span class="version-label">{{.Label}}{{if .Deleted}} · deleted{{end}}</span>
            <span class="version-when">{{.When}}{{if .Current}} · current{{end}}</span>
          </span><span class="version-more" aria-hidden="true">⋯</span></button>
          <div class="version-details">
            {{if .Changelog}}<p class="version-changelog">{{.Changelog}}</p>{{end}}
            <div class="version-summary">{{template "versionSummary" .Summary}}</div>
            <span class="version-actions">
              <form method="POST"><input type="hidden" name="seq" value="{{.Seq}}"><button type="submit" name="viewVersion" class="version-btn">View</button></form>
              {{if not .Current}}<form method="POST"><input type="hidden" name="seq" value="{{.Seq}}"><button type="submit" name="diffVersion" class="version-btn">Diff</button></form>
              <form method="POST"><input type="hidden" name="seq" value="{{.Seq}}"><button type="submit" name="restoreVersion" class="version-btn version-restore">Restore</button></form>{{end}}
            </span>
          </div>
        </div>
        {{end}}
      </div>
    </div>
    {{end}}
    </span>
  </header>{{end}}
=== findingCard ===

      <div class="finding-card sev-{{.Severity}}" data-key="finding-{{.CheckID}}-{{.Index}}" role="note">
        <span class="finding-check">{{.CheckName}}</span>
        <span class="finding-msg">{{.Message}}</span>
        <span class="finding-actions">
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="queueFinding" class="outline">Queue as comment</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="dismissFinding" class="outline secondary" title="It's fine here: stop flagging this one">Ignore</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="hideFinding" class="outline secondary" title="Fold this card for now; the underline stays">Hide</button></form>
        </span>
      </div>

=== hiddenMarker ===
<form method="POST" class="sg-hidden-marker"><input type="hidden" name="ids" value="{{.IDs}}"><span class="sg-hidden-label">{{.Label}}</span> <button type="submit" name="unhideSuggestions" class="sg-hide-btn">Show</button></form>
=== htmlView ===
{{with $.CurrentDiff}}  
  <div class="html-view" data-key="html-{{.Path}}">{{template "regionToggle" $}}<div class="preview-stage"><iframe class="html-preview" sandbox="allow-scripts" srcdoc="{{$.RenderedHTMLDoc}}" lvt-fx:preview-bridge title="HTML preview of {{.Path}}"></iframe>{{if $.RegionSelectArmed}}<div class="region-overlay" lvt-fx:region-select="selectBlock" data-surface="html" data-key="region-html-{{.Path}}"></div>{{end}}</div>{{range $.RenderedHTML}}{{$bs := .StartLine}}{{$be := .EndLine}}{{$hbkey := printf "HB-%d-%d" $bs $be}}<div class="html-block{{if and (ne $.SelectionEndMax 0) (ge $.SelectionEndMax $bs) (le $.SelectionEndMax $be)}} selected{{end}}" data-key="{{$hbkey}}">{{template "blockComments" .}}{{template "blockSuggestions" .}}</div>{{end}}</div>{{end}}
