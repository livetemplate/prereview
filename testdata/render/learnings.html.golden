<!DOCTYPE html>

<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
>
<title>prereview · /repo</title>
<link rel="stylesheet" href="/pico.min.css">
<link rel="stylesheet" href="/livetemplate.css">
<link rel="stylesheet" href="/syntax.css">
<link rel="stylesheet" href="/prereview.css">
</head>
<body
  data-lvt-loading-debounce-ms="200"
  data-lvt-heartbeat-ms="10000"
><div data-lvt-id="lvt-ID" data-lvt-loading="true">

<div class="theme-root" data-scheme="solarized">

<span class="kbd-esc" hidden aria-hidden="true"
  lvt-on:window:keydown="clearSelection"
  lvt-key="Escape"
></span>



<div class="kbd-bindings" hidden aria-hidden="true"><span
    lvt-on:window:keydown="nextFile"
    lvt-key="j"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="prevFile"
    lvt-key="k"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="cursorDown"
    lvt-key="ArrowDown"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="cursorUp"
    lvt-key="ArrowUp"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="navNext"
    lvt-key="n"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="navPrev"
    lvt-key="p"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="openFileComment"
    lvt-key="c"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleFiles"
    lvt-key="f"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleTOC"
    lvt-key="t"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="openSearch"
    lvt-key="Mod&#43;k"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleCommentList"
    lvt-key="a"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleUnderstand"
    lvt-key="z"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleShowResolved"
    lvt-key="r"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleSuggestions"
    lvt-key="s"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleFocusMode"
    lvt-key="."
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleKeyboardHelp"
    lvt-key="?"
    lvt-mod:skip-when-typing
  ></span></div>
<header
  class="bar"
  lvt-fx:url-hash="setURLHash"
  data-lvt-url-hash="app.go"
>
  <form method="POST">
    <button
      type="submit"
      name="toggleFiles"
      class="hamburger outline contrast"
      aria-label="Toggle files"
    ><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path
  d="M4 7h16M4 12h16M4 17h16"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
  </form>
  
  
  <form method="POST">
    <button
      type="submit"
      name="openSearch"
      class="search-btn outline contrast"
      aria-label="Search files"
      title="Search files (⌘/Ctrl + K)"
    ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
    cx="11" cy="11" r="7"
    stroke="currentColor" stroke-width="1.7" fill="none"
  /><path
    d="M16 16l5 5"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"
  /></svg></button>
  </form>
  
  <div class="title">
    <span class="title-main"><small>Pick a file from 2 files</small></span>
  </div>
  
  <div class="toolbar-inline">
    <div class="tb-group tb-counters">
      
      <small class="auto-saved-long">2 files · 2 changed · 0/2 viewed</small>
    </div>
    
    
    <div
      class="tb-dropdown"
      lvt-el:toggleClass:on:click="open"
      lvt-el:removeClass:on:click-away="open"
    >
      <button
        type="button"
        class="contrast theme-toggle tb-dropdown-trigger"
        aria-haspopup="menu"
        title="View options — focus, color scheme &amp; mode, comment filters, help"
      ><span class="tb-label">View</span><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M6 9l6 6 6-6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"
/></svg></button>
      <div class="tb-dropdown-panel" role="menu" aria-label="View options">
        
        
        <form method="POST">
          <button
            type="submit"
            name="cycleScheme"
            class="menu-item"
            role="menuitem"
          >
            <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
  stroke-linejoin="round"
/><circle cx="7.5" cy="11.5" r="1.2" fill="currentColor"/><circle cx="12" cy="8" r="1.2" fill="currentColor"/><circle cx="16.5" cy="11.5" r="1.2" fill="currentColor"/></svg></span>
            <span class="menu-label">Scheme: Solarized</span>
            <span class="menu-meta">Gruvbox →</span>
          </button>
        </form>
        <form method="POST">
          <button
            type="submit"
            name="cycleTheme"
            class="menu-item"
            role="menuitem"
          >
            <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8.5"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"/></svg></span>
            <span class="menu-label">Mode: System</span>
            <span class="menu-meta">Light →</span>
          </button>
        </form>
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        <form method="POST">
          <button
            type="submit"
            name="toggleKeyboardHelp"
            class="menu-item"
            role="menuitem"
          >
            <span class="menu-icon" aria-hidden="true">?</span>
            <span class="menu-label">Keyboard shortcuts</span>
          </button>
        </form>
        
        <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
          <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
          <span class="menu-label">Usage guide</span>
        </a>
      </div>
    </div>
  </div>
  
  
  <form method="POST" class="nav-prev">
    <button
      type="submit"
      name="prevFile"
      title="Previous file"
      aria-label="Previous file"
      class="contrast"
    ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg><span class="nav-label">Prev <kbd class="kbd-hint" aria-hidden="true">k</kbd></span></button>
  </form>
  <form method="POST" class="nav-next">
    <button
      type="submit"
      name="nextFile"
      title="Next file"
      aria-label="Next file"
      class="contrast"
    ><span class="nav-label">Next <kbd class="kbd-hint" aria-hidden="true">j</kbd></span><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M9 6l6 6-6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
  </form>
  
  <form method="POST" class="library-form">
    <button
      type="submit"
      name="toggleLibrary"
      class="contrast library-trigger is-on"
      aria-pressed="true"
      title="Library: the learnings and checks every review on this machine uses"
    ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="tb-label">Library</span><span class="lib-badge" title="2 new learnings proposed">2</span></button>
  </form>

  
  
  <form method="POST" class="tb-action">
    <button
      type="button"
      command="show-modal"
      commandfor="confirm-quit"
      class="contrast"
      title="Stop the prereview server"
    >Quit</button>
  </form>
  
  
  <form method="POST" style="margin:0">
    <button
      type="submit"
      name="toggleMoreMenu"
      class="more-trigger"
      aria-label="More options"
      aria-haspopup="menu"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="5" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="12" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="19" r="1.8" fill="currentColor"/>
      </svg>
    </button>
  </form>
</header>


<div
  class="more-menu-backdrop"
  lvt-on:click="closeMoreMenu"
  aria-hidden="true"
></div>
<div
  class="more-menu"
  role="menu"
  aria-label="More options"
>
  <div class="menu-info">2 files · 2 changed · 0/2 viewed</div>
  
  
  <form method="POST">
    <button type="submit" name="prevFile" class="menu-item" role="menuitem">
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></span>
      <span class="menu-label">Previous file</span>
    </button>
  </form>
  <form method="POST">
    <button type="submit" name="nextFile" class="menu-item" role="menuitem">
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M9 6l6 6-6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></span>
      <span class="menu-label">Next file</span>
    </button>
  </form>
  
  
  <form method="POST">
    <button
      type="submit"
      name="cycleScheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
  stroke-linejoin="round"
/><circle cx="7.5" cy="11.5" r="1.2" fill="currentColor"/><circle cx="12" cy="8" r="1.2" fill="currentColor"/><circle cx="16.5" cy="11.5" r="1.2" fill="currentColor"/></svg></span>
      <span class="menu-label">Scheme: Solarized</span>
      <span class="menu-meta">Gruvbox →</span>
    </button>
  </form>
  <form method="POST">
    <button
      type="submit"
      name="cycleTheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8.5"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"/></svg></span>
      <span class="menu-label">Mode: System</span>
      <span class="menu-meta">Light →</span>
    </button>
  </form>
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  <div
    class="menu-info"
    style="border-bottom: 0; margin-bottom: 0; font-style: italic;"
  >No comments yet — tap a line to add one.</div>
  
  
  
  <form method="POST">
    <button
      type="submit"
      name="toggleKeyboardHelp"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon" aria-hidden="true">?</span>
      <span class="menu-label">Keyboard shortcuts</span>
    </button>
  </form>
  
  <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
    <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
    <span class="menu-label">Usage guide</span>
  </a>
</div>


<div class="banner-slot" data-key="banners">





</div>


<div
  class="drawer-backdrop"
  data-key="drawer-backdrop"
  lvt-on:click="closeFiles"
  aria-label="Close file list"
></div>

<div class="layout" data-key="layout">
<dialog
  id="files-drawer"
  open
  class=""
  lvt-fx:resize="--pr-drawer-w"
  data-resize-handle=".resize-handle"
  data-resize-min="200"
  data-resize-max="560"
  data-resize-store="prereview.drawerW"
>
  
  <div class="drawer-collapse">
    <form method="POST">
      <button
        type="submit"
        name="toggleFiles"
        class="collapse-toggle"
        aria-label="Hide file list"
        aria-expanded="true"
        title="Hide files (f)"
      ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
    </form>
  </div>
  <div class="drawer-head">
    <strong>2 files</strong>
    <form method="POST">
      <button
        type="submit"
        name="closeFiles"
        class="outline close-btn"
        aria-label="Close"
      ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M6 6l12 12M18 6L6 18"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
    </form>
  </div>
  
  
  
  
  <div class="drawer-base">
    <form method="POST" class="base-select-form">
      <label for="base-input">Base</label>
      <select id="base-input" name="ref" lvt-on:change="setBase">
        
      </select>
    </form>
  </div>
  
  <div class="drawer-search">
    <form method="POST" lvt-form:preserve>
      <input type="text" name="filter" placeholder="Filter files…" value=""
             lvt-on:input="setFileFilter" lvt-mod:debounce="200"
             autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
             enterkeyhint="search">
    </form>
  </div>
  
  
  <div class="drawer-body">
    
    <ul class="file-tree"><li class="tree-file" data-key="app.go">
  <div class="file-row" style="--depth:0">
    <form method="POST" class="file-select-form">
      <input type="hidden" name="path" value="app.go">
      <button type="submit" name="selectFile" class="file-btn outline contrast is-selected" title="app.go"><span class="status-badge M">M</span><span class="tree-file-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M6 3h8l4 4v14H6z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /><path
    d="M14 3v4h4"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
        <span class="file-label"><span class="file-name">app</span><span class="file-ext">.go</span></span>
        <span class="file-meta"><small class="diff-stats"><span class="add">+3</span><span class="del">-1</span></small></span>
      </button>
    </form>
    <form method="POST" class="file-viewed-form">
      <input type="hidden" name="path" value="app.go">
      <button type="submit" name="toggleViewed" class="viewed-toggle" aria-label="Mark as viewed" title="Mark viewed"><svg viewBox="0 0 24 24" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.5"
  fill="none"
/></svg></button>
    </form>
  </div>
</li><li class="tree-file" data-key="README.md">
  <div class="file-row" style="--depth:0">
    <form method="POST" class="file-select-form">
      <input type="hidden" name="path" value="README.md">
      <button type="submit" name="selectFile" class="file-btn outline contrast" title="README.md"><span class="status-badge M">M</span><span class="tree-file-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M6 3h8l4 4v14H6z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /><path
    d="M14 3v4h4"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
        <span class="file-label"><span class="file-name">README</span><span class="file-ext">.md</span></span>
        <span class="file-meta"><small class="diff-stats"><span class="add">+2</span></small></span>
      </button>
    </form>
    <form method="POST" class="file-viewed-form">
      <input type="hidden" name="path" value="README.md">
      <button type="submit" name="toggleViewed" class="viewed-toggle" aria-label="Mark as viewed" title="Mark viewed"><svg viewBox="0 0 24 24" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.5"
  fill="none"
/></svg></button>
    </form>
  </div>
</li></ul>
  </div>
  
  <div class="resize-handle" aria-hidden="true"></div>
</dialog>

<main class="viewer"
      lvt-fx:viewport-report="reportViewport"
      data-lvt-viewport-items=".line, .md-block">

<section class="library" data-key="library" aria-label="Library">
  <header class="lib-head">
    <strong class="lib-title"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Library</strong>
    <span class="lib-src">shared by every review on this machine · changes show up live</span>
    <details class="lib-editor">
      <summary>Open rule files in: None (show path)</summary>
      <form method="POST" class="checks-editor">
        <label>Editor
          <select name="editor">
            <option value="" selected>None (show path)</option><option value="vscode">VS Code</option><option value="cursor">Cursor</option><option value="zed">Zed</option><option value="custom">Custom URL…</option>
          </select>
        </label>
        <label>SSH host <input type="text" name="ssh_host" value="" placeholder="blank = this machine" autocomplete="off"></label>
        <label>Custom URL <input type="text" name="template" value="" placeholder="myeditor://open?file={path}&amp;line={line}" autocomplete="off"></label>
        <button type="submit" name="setEditor" class="outline">Save</button>
      </form>
    </details>
    <span class="lib-head-actions"><a role="button" class="outline lib-review" href="/_library-review" target="_blank" rel="noopener" title="Open the library folder as a review: comments and suggestions on library files go to your agent">Review in prereview</a>
    <form method="POST" class="lib-back"><button type="submit" name="toggleLibrary" class="outline contrast">Back</button></form></span>
  </header>
  <div class="lib-tabs" role="tablist">
    <form method="POST"><input type="hidden" name="tab" value="learnings"><button type="submit" name="setLibraryTab" class="lib-tab is-on" role="tab" aria-selected="true">Learnings<span class="ck-pill ck-new">2 new</span></button></form>
    <form method="POST"><input type="hidden" name="tab" value="shortcuts"><button type="submit" name="setLibraryTab" class="lib-tab" role="tab" aria-selected="false">Shortcuts</button></form>
    <form method="POST"><input type="hidden" name="tab" value="skills"><button type="submit" name="setLibraryTab" class="lib-tab" role="tab" aria-selected="false">Skills</button></form>
    <form method="POST"><input type="hidden" name="tab" value="checks"><button type="submit" name="setLibraryTab" class="lib-tab" role="tab" aria-selected="false">Checks</button></form>
    <form method="POST"><input type="hidden" name="tab" value="benchmarks"><button type="submit" name="setLibraryTab" class="lib-tab" role="tab" aria-selected="false">Benchmarks</button></form>
  </div>
  
  <div class="lib-filters">
    <form method="POST"><input type="hidden" name="status" value="proposed"><button type="submit" name="setLearnFilter" class="lib-chip is-on" aria-pressed="true">Proposed 2</button></form>
    <form method="POST"><input type="hidden" name="status" value="accepted"><button type="submit" name="setLearnFilter" class="lib-chip" aria-pressed="false">Accepted 1</button></form>
    <form method="POST"><input type="hidden" name="status" value="superseded"><button type="submit" name="setLearnFilter" class="lib-chip" aria-pressed="false">Superseded 1</button></form>
    <form method="POST"><input type="hidden" name="status" value="rejected"><button type="submit" name="setLearnFilter" class="lib-chip" aria-pressed="false">Rejected 0</button></form>
    <form method="POST" class="lib-auto-form"><button type="submit" name="toggleAutoLearn" class="lib-auto" role="switch" aria-checked="true" title="When your agent goes idle and a review has 5 or more new comments, replies or decisions, ask it to learn from them"><span class="ck-switch" aria-hidden="true"></span>Learn after each review</button></form>
    <form method="POST" class="lib-auto-form"><button type="submit" name="toggleAutoAccept" class="lib-auto" role="switch" aria-checked="true" title="Add what your agent learns straight to your skills (you're told, and can undo it), instead of waiting for you to accept each one"><span class="ck-switch" aria-hidden="true"></span>Accept automatically</button></form>
    <form method="POST" class="lib-scope-form">
      <select name="scope" aria-label="Scope" lvt-on:change="setLearnFilter">
        <option value="" selected>All scopes</option>
        <option value="Release notes">Release notes</option><option value="Technical docs">Technical docs</option><option value="Writing (all documents)">Writing (all documents)</option>
      </select>
    </form>
    <form method="POST" class="lib-boot-form"><button type="submit" name="openPastReviews" class="ck-link">Read past reviews</button></form>
  </div>
  
  <ul class="lib-list">
    
    <li class="lib-card is-proposed" data-key="learn-l1">
      <header><span class="ck-pill ck-new">proposed</span><span>scope: <b>Writing (all documents)</b></span><span>2 pieces of evidence · newest 15 Nov 2026</span></header>
      <p class="lc-text">Cut filler words such as “basically”, “simply” and “very”.</p>
      
      <details open><summary>Evidence (2)</summary><ul class="lc-evidence">
        <li><span class="ev-where">comment · release-notes.md L5 · this review · 15 Nov 2026</span><br><q>Drop “basically” — it adds nothing.</q></li>
        <li><span class="ev-where">thread reply · notes · 28 Oct 2026</span><br><q>no “very” please</q></li>
        </ul></details>
      <div class="lc-row"><span>would become: <b>instruction · checker</b></span></div>
      
      
      
      <div class="lc-actions">
        <form method="POST"><input type="hidden" name="id" value="l1"><input type="hidden" name="act" value="accept"><button type="submit" name="learningAction" class="accept">Accept</button></form>
        <form method="POST"><input type="hidden" name="id" value="l1"><button type="submit" name="editLearning" class="outline">Edit</button></form>
        <form method="POST"><input type="hidden" name="id" value="l1"><input type="hidden" name="act" value="reject"><button type="submit" name="learningAction" class="outline reject">Reject</button></form>
        <form method="POST"><input type="hidden" name="id" value="l1"><input type="hidden" name="act" value="delete"><button type="submit" name="learningAction" class="outline secondary">Delete</button></form>
        
      </div>
    </li>

    <li class="lib-card is-proposed" data-key="learn-l2">
      <header><span class="ck-pill ck-new">proposed</span><span>scope: <b>Technical docs</b></span><span>1 piece of evidence</span></header>
      <form method="POST" class="lc-edit"><input type="hidden" name="id" value="l2">
        <textarea name="text" rows="2" aria-label="Learning">Use numbered lists for steps.</textarea>
        <label>Scope <input type="text" name="scope" value="Technical docs" autocomplete="off"></label>
        <div class="lc-actions"><button type="submit" name="saveLearning">Save</button><button type="submit" name="editLearning" class="outline secondary">Cancel</button></div>
      </form>
      <div class="lc-conflict"><b>Replaces an older learning</b>: “Prefer prose over bullet lists.” (accepted 2 Aug 2026). Newer wins: accepting this keeps the old one as superseded, so you can restore it.</div>
      <details open><summary>Evidence (1)</summary><ul class="lc-evidence">
        <li><span class="ev-where">suggestion decision · docs/a.md L7 · this review</span><br><q>rejected: cut it (keep my wording)</q></li>
        </ul></details>
      
      
      
      
      
    </li>

  </ul>
  <div class="lib-io">
    <span>Review on another machine too? Carry your learnings across: newer ones win.</span>
    <a role="button" class="outline" href="/_library-export" download>Export learnings</a>
    <form method="POST" action="/_library-import" enctype="multipart/form-data" class="lib-import" lvt-form:no-intercept>
      <input type="file" name="file" accept=".jsonl,application/x-ndjson,application/json" aria-label="Learnings file to import" required>
      <button type="submit" class="outline">Import</button>
    </form>
  </div>

  
</section>








</main>



</div>



<div
  class="kbd-help-backdrop"
  lvt-on:click="toggleKeyboardHelp"
  aria-hidden="true"
></div>
<div
  class="kbd-help-modal"
  role="dialog"
  aria-label="Keyboard shortcuts"
  aria-modal="true"
>
  <div class="kbd-help-head">
    <strong>Keyboard shortcuts</strong>
    <form method="POST">
      <button
        type="submit"
        name="toggleKeyboardHelp"
        class="outline close-btn"
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M6 6l12 12M18 6L6 18"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg>
      </button>
    </form>
  </div>
  <dl class="kbd-help-list">
    <div class="kbd-row"><dt><kbd>j</kbd></dt><dd>Next file</dd></div>
    <div class="kbd-row"><dt><kbd>k</kbd></dt><dd>Previous file</dd></div>
    <div class="kbd-row"><dt><kbd>↓</kbd></dt><dd>Move line cursor down</dd></div>
    <div class="kbd-row"><dt><kbd>↑</kbd></dt><dd>Move line cursor up</dd></div>
    <div class="kbd-row"><dt><kbd>n</kbd></dt><dd>Next open item</dd></div>
    <div class="kbd-row"><dt><kbd>p</kbd></dt><dd>Previous open item</dd></div>
    <div class="kbd-row"><dt><kbd>c</kbd></dt><dd>Comment on this file</dd></div>
    <div class="kbd-row"><dt><kbd>f</kbd></dt><dd>Toggle file tree</dd></div>
    <div class="kbd-row"><dt><kbd>t</kbd></dt><dd>Toggle table of contents</dd></div>
    <div class="kbd-row"><dt><kbd>⌘/Ctrl &#43; K</kbd></dt><dd>Search files</dd></div>
    <div class="kbd-row"><dt><kbd>a</kbd></dt><dd>All comments</dd></div>
    <div class="kbd-row"><dt><kbd>z</kbd></dt><dd>Understand this change</dd></div>
    <div class="kbd-row"><dt><kbd>r</kbd></dt><dd>Show / hide resolved comments</dd></div>
    <div class="kbd-row"><dt><kbd>s</kbd></dt><dd>Show / hide suggestions</dd></div>
    <div class="kbd-row"><dt><kbd>.</kbd></dt><dd>Focus mode (hide side columns)</dd></div>
    <div class="kbd-row"><dt><kbd>?</kbd></dt><dd>Keyboard shortcuts</dd></div>
    <div class="kbd-row"><dt><kbd>Esc</kbd></dt><dd>Cancel / close</dd></div>
    <div class="kbd-row"><dt><kbd>Enter</kbd></dt><dd>Comment on the line cursor</dd></div>
    <div class="kbd-row"><dt><kbd>⌘/Ctrl &#43; Enter</kbd></dt><dd>Save comment</dd></div>
  </dl>
  <p class="kbd-help-note">Drawing a precise region on rendered HTML or an image needs a mouse — from the keyboard, comment on the whole block or image instead.</p>
  
  <p class="kbd-help-usage"><a href="/_usage" target="_blank" rel="noopener">Open the usage guide ↗</a></p>
</div>


<div
  class="search-backdrop"
  lvt-on:click="closeSearch"
  aria-hidden="true"
></div>
<div
  class="search-modal"
  role="dialog"
  aria-label="Search files"
  aria-modal="true"
>
  
</div>

<footer class="app-footer" role="contentinfo">
  prereview v · built with <a
    href="https://github.com/livetemplate/livetemplate"
    target="_blank"
    rel="noopener noreferrer"
  >livetemplate</a>
</footer>




<dialog id="confirm-quit"><article><header><strong>Quit prereview?</strong></header><p><small>Stops the prereview server and closes the review. Saved comments are already written to the CSV; this can't be undone from the browser.</small></p><footer>
    <form method="POST">
      <fieldset role="group">
        <button
          type="button"
          command="close"
          commandfor="confirm-quit"
          class="secondary"
        >Cancel</button>
        <button
          type="submit"
          name="quit"
          class="contrast"
        >Quit</button>
      </fieldset>
    </form>
  </footer></article></dialog>

</div>
</div><script defer src="/livetemplate-client.js"></script>
<script defer src="/prereview-handlers.js"></script>
</body>
</html>


