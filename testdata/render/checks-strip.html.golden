<!DOCTYPE html>

<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
>
<title>prereview · /repo</title>
<link rel="stylesheet" href="/pico.min.css">
<link rel="stylesheet" href="/livetemplate.css">
<link rel="stylesheet" href="/syntax.css">
<link rel="stylesheet" href="/prereview.css">
</head>
<body
  data-lvt-loading-debounce-ms="200"
  data-lvt-heartbeat-ms="10000"
><div data-lvt-id="lvt-ID" data-lvt-loading="true">

<div class="theme-root" data-scheme="solarized">

<span class="kbd-esc" hidden aria-hidden="true"
  lvt-on:window:keydown="clearSelection"
  lvt-key="Escape"
></span>



<div class="kbd-bindings" hidden aria-hidden="true"><span
    lvt-on:window:keydown="nextFile"
    lvt-key="j"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="prevFile"
    lvt-key="k"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="cursorDown"
    lvt-key="ArrowDown"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="cursorUp"
    lvt-key="ArrowUp"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="navNext"
    lvt-key="n"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="navPrev"
    lvt-key="p"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="openFileComment"
    lvt-key="c"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleFiles"
    lvt-key="f"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleTOC"
    lvt-key="t"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="openSearch"
    lvt-key="Mod&#43;k"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleBoxes"
    lvt-key="b"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleCommentList"
    lvt-key="a"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleUnderstand"
    lvt-key="z"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleShowResolved"
    lvt-key="r"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleSuggestions"
    lvt-key="s"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleFileView"
    lvt-key="d"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="markUnread"
    lvt-key="u"
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleFocusMode"
    lvt-key="."
    lvt-mod:skip-when-typing
  ></span><span
    lvt-on:window:keydown="toggleKeyboardHelp"
    lvt-key="?"
    lvt-mod:skip-when-typing
  ></span></div>
<header
  class="bar"
  lvt-fx:url-hash="setURLHash"
  data-lvt-url-hash="notes.txt"
>
  <form method="POST">
    <button
      type="submit"
      name="toggleFiles"
      class="hamburger outline contrast"
      aria-label="Toggle files"
    ><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path
  d="M4 7h16M4 12h16M4 17h16"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
  </form>
  
  
  <form method="POST">
    <button
      type="submit"
      name="openSearch"
      class="search-btn outline contrast"
      aria-label="Search files"
      title="Search files (⌘/Ctrl + K)"
    ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
    cx="11" cy="11" r="7"
    stroke="currentColor" stroke-width="1.7" fill="none"
  /><path
    d="M16 16l5 5"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"
  /></svg><span class="tb-word">Search</span> <kbd class="kbd-hint tb-kbd" aria-hidden="true">⌘K</kbd></button>
  </form>
  
  <div class="title">
    <span class="title-main"><span class="title-file">notes.txt</span></span>
  </div>
  
  <div class="toolbar-inline">
    <div class="tb-group tb-views">
      <form method="POST" title="Focus: hide the side columns">
        <button
          type="submit"
          name="toggleFocusMode"
          class="tb-btn"
          aria-pressed="false"
          
        ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"
/></svg><span class="tb-word">Focus</span> <kbd class="kbd-hint tb-kbd" aria-hidden="true">.</kbd></button>
      </form>
      <form method="POST" title="No annotations yet">
        <button
          type="submit"
          name="toggleCommentList"
          class="tb-btn"
          aria-pressed="false"
          disabled
        ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg><span class="tb-word">Annotations</span><span class="tb-count">0</span> <kbd class="kbd-hint tb-kbd" aria-hidden="true">a</kbd></button>
      </form>
      <form method="POST" title="No walkthrough or quiz yet, and no agent to make one">
        <button
          type="submit"
          name="toggleUnderstand"
          class="tb-btn"
          aria-pressed="false"
          disabled
        ><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg><span class="tb-word">Understand</span> <kbd class="kbd-hint tb-kbd" aria-hidden="true">z</kbd></button>
      </form>
    </div>
    <div class="tb-group tb-prefs">
      <form method="POST">
        <button
          type="submit"
          name="cycleScheme"
          class="tb-btn"
          title="Color scheme: Solarized. Next: Gruvbox"
        ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
  stroke-linejoin="round"
/><circle cx="7.5" cy="11.5" r="1.2" fill="currentColor"/><circle cx="12" cy="8" r="1.2" fill="currentColor"/><circle cx="16.5" cy="11.5" r="1.2" fill="currentColor"/></svg><span class="tb-word">Solarized</span></button>
      </form>
      <form method="POST">
        <button
          type="submit"
          name="cycleTheme"
          class="tb-btn"
          title="Mode: System. Next: Light"
        ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8.5"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"/></svg><span class="tb-word">System</span></button>
      </form>
      <form method="POST">
        <button
          type="submit"
          name="toggleKeyboardHelp"
          class="tb-btn"
          title="Keyboard shortcuts"
        ><span class="tb-glyph" aria-hidden="true">?</span><span class="tb-word">Shortcuts</span> <kbd class="kbd-hint tb-kbd" aria-hidden="true">?</kbd></button>
      </form>
      <a class="tb-btn" href="/_usage" target="_blank" rel="noopener" title="Usage guide (opens a new tab)"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg><span class="tb-word">Guide</span></a>
    </div>

  </div>
  
  
  <form method="POST" class="nav-prev">
    <button
      type="submit"
      name="prevFile"
      title="Previous file"
      aria-label="Previous file"
      class="contrast"
    ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg><span class="nav-label">Prev <kbd class="kbd-hint" aria-hidden="true">k</kbd></span></button>
  </form>
  <form method="POST" class="nav-next">
    <button
      type="submit"
      name="nextFile"
      title="Next file"
      aria-label="Next file"
      class="contrast"
    ><span class="nav-label">Next <kbd class="kbd-hint" aria-hidden="true">j</kbd></span><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M9 6l6 6-6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
  </form>
  
  <form method="POST" class="library-form">
    <button
      type="submit"
      name="toggleLibrary"
      class="contrast library-trigger"
      aria-pressed="false"
      title="Library: the learnings and checks every review on this machine uses"
    ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="tb-label">Library</span></button>
  </form>

  
  
  <form method="POST" class="tb-action">
    <button
      type="button"
      command="show-modal"
      commandfor="confirm-quit"
      class="contrast"
      title="Stop the prereview server"
    >Quit</button>
  </form>
  
  
  <form method="POST" style="margin:0">
    <button
      type="submit"
      name="toggleMoreMenu"
      class="more-trigger"
      aria-label="More options"
      aria-haspopup="menu"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="5" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="12" r="1.8" fill="currentColor"/>
        <circle cx="12" cy="19" r="1.8" fill="currentColor"/>
      </svg>
    </button>
  </form>
</header>


<div
  class="more-menu-backdrop"
  lvt-on:click="closeMoreMenu"
  aria-hidden="true"
></div>
<div
  class="more-menu"
  role="menu"
  aria-label="More options"
>
  <div class="menu-info">2 files · 2 changed · 0/2 viewed</div>
  
  
  <form method="POST">
    <button type="submit" name="prevFile" class="menu-item" role="menuitem">
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></span>
      <span class="menu-label">Previous file</span>
    </button>
  </form>
  <form method="POST">
    <button type="submit" name="nextFile" class="menu-item" role="menuitem">
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M9 6l6 6-6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></span>
      <span class="menu-label">Next file</span>
    </button>
  </form>
  
  
  <form method="POST">
    <button
      type="submit"
      name="cycleScheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
  stroke-linejoin="round"
/><circle cx="7.5" cy="11.5" r="1.2" fill="currentColor"/><circle cx="12" cy="8" r="1.2" fill="currentColor"/><circle cx="16.5" cy="11.5" r="1.2" fill="currentColor"/></svg></span>
      <span class="menu-label">Scheme: Solarized</span>
      <span class="menu-meta">Gruvbox →</span>
    </button>
  </form>
  <form method="POST">
    <button
      type="submit"
      name="cycleTheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8.5"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"/></svg></span>
      <span class="menu-label">Mode: System</span>
      <span class="menu-meta">Light →</span>
    </button>
  </form>
  
  
  
  
  <form method="POST" title="Only for Markdown and HTML files"><input type="hidden" name="view" value="rendered">
    <button
      type="submit"
      name="setMarkdownView"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Preview<small class="menu-why">Only for Markdown and HTML files</small></span>
    </button>
  </form>
  <form method="POST" title="Only for Markdown and HTML files"><input type="hidden" name="view" value="raw">
    <button
      type="submit"
      name="setMarkdownView"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Raw<small class="menu-why">Only for Markdown and HTML files</small></span>
    </button>
  </form>
  <form method="POST" title="Mark what changed; off shows the plain file">
    <button
      type="submit"
      name="toggleFileView"
      class="menu-item menu-file-view is-on"
      role="menuitemcheckbox"
      aria-checked="true"
      
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M5 12l4 4 10-10"
  stroke="currentColor"
  stroke-width="2.2"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
/></svg></span>
      <span class="menu-label">Diff <kbd class="kbd-hint" aria-hidden="true">d</kbd></span>
    </button>
  </form>
  <form method="POST" title="Show whitespace-only changes as unchanged">
    <button
      type="submit"
      name="toggleHideWhitespace"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Whitespace</span>
    </button>
  </form>
  <form method="POST" title="No mechanical changes to fold">
    <button
      type="submit"
      name="toggleFoldMechanical"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Fold<small class="menu-why">No mechanical changes to fold</small></span>
    </button>
  </form>
  <form method="POST" title="Only on an image or the HTML preview">
    <button
      type="submit"
      name="toggleRegionSelect"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Annotate<small class="menu-why">Only on an image or the HTML preview</small></span>
    </button>
  </form>
  <form method="POST" title="Only on the HTML preview, once it has annotations">
    <button
      type="submit"
      name="toggleBoxes"
      class="menu-item menu-file-view"
      role="menuitemcheckbox"
      aria-checked="false"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.8"
  fill="none"
/></svg></span>
      <span class="menu-label">Boxes <kbd class="kbd-hint" aria-hidden="true">b</kbd><small class="menu-why">Only on the HTML preview, once it has annotations</small></span>
    </button>
  </form>
  
  
  
  
  <form method="POST" title="No annotations yet">
    <button
      type="submit"
      name="toggleCommentList"
      class="menu-item"
      role="menuitem"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
      <span class="menu-label">Annotations <kbd class="kbd-hint" aria-hidden="true">a</kbd><small class="menu-why">No annotations yet</small></span>
      
    </button>
  </form>
  
  <form method="POST" title="No walkthrough or quiz yet, and no agent to make one">
    <button
      type="submit"
      name="toggleUnderstand"
      class="menu-item"
      role="menuitem"
      disabled
    >
      <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>
      <span class="menu-label">Understand <kbd class="kbd-hint" aria-hidden="true">z</kbd><small class="menu-why">No walkthrough or quiz yet, and no agent to make one</small></span>
      
    </button>
  </form>
  
  
  
  <div
    class="menu-info"
    style="border-bottom: 0; margin-bottom: 0; font-style: italic;"
  >No comments yet — tap a line to add one.</div>
  
  
  
  <form method="POST">
    <button
      type="submit"
      name="toggleKeyboardHelp"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon" aria-hidden="true">?</span>
      <span class="menu-label">Keyboard shortcuts</span>
    </button>
  </form>
  
  <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
    <span class="menu-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
    <span class="menu-label">Usage guide</span>
  </a>
</div>


<div class="banner-slot" data-key="banners">





</div>


<div
  class="drawer-backdrop"
  data-key="drawer-backdrop"
  lvt-on:click="closeFiles"
  aria-label="Close file list"
></div>

<div class="layout" data-key="layout">
<dialog
  id="files-drawer"
  open
  class=""
  lvt-fx:resize="--pr-drawer-w"
  data-resize-handle=".resize-handle"
  data-resize-min="200"
  data-resize-max="560"
  data-resize-store="prereview.drawerW"
>
  
  <div class="drawer-collapse">
    <form method="POST">
      <button
        type="submit"
        name="toggleFiles"
        class="collapse-toggle"
        aria-label="Hide file list"
        aria-expanded="true"
        title="Hide files (f)"
      ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
  d="M15 6l-6 6 6 6"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
    </form>
  </div>
  <div class="drawer-head">
    <div class="drawer-stats">
      <strong>2 files · 2 changed</strong>
      <small>0 of 2 viewed</small>
      <progress class="drawer-viewed" value="0" max="2" aria-label="Files viewed"></progress>
    </div>
    <form method="POST">
      <button
        type="submit"
        name="closeFiles"
        class="outline close-btn"
        aria-label="Close"
      ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M6 6l12 12M18 6L6 18"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg></button>
    </form>
  </div>
  
  
  
  
  <div class="drawer-base">
    <form method="POST" class="base-select-form">
      <label for="base-input">Base</label>
      <select id="base-input" name="ref" lvt-on:change="setBase">
        
      </select>
    </form>
  </div>
  
  <div class="drawer-search">
    <form method="POST" lvt-form:preserve>
      <input type="text" name="filter" placeholder="Filter files…" value=""
             lvt-on:input="setFileFilter" lvt-mod:debounce="200"
             autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
             enterkeyhint="search">
    </form>
  </div>
  
  
  <div class="drawer-body">
    
    <ul class="file-tree"><li class="tree-file" data-key="app.go">
  <div class="file-row" style="--depth:0">
    <form method="POST" class="file-select-form">
      <input type="hidden" name="path" value="app.go">
      <button type="submit" name="selectFile" class="file-btn outline contrast" title="app.go"><span class="status-badge M">M</span><span class="tree-file-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M6 3h8l4 4v14H6z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /><path
    d="M14 3v4h4"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
        <span class="file-label"><span class="file-name">app</span><span class="file-ext">.go</span></span>
        <span class="file-meta"><small class="diff-stats"><span class="add">+3</span><span class="del">-1</span></small></span>
      </button>
    </form>
    <form method="POST" class="file-viewed-form">
      <input type="hidden" name="path" value="app.go">
      <button type="submit" name="toggleViewed" class="viewed-toggle" aria-label="Mark as viewed" title="Mark viewed"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.5"
  fill="none"
/></svg></button>
    </form>
  </div>
</li><li class="tree-file" data-key="README.md">
  <div class="file-row" style="--depth:0">
    <form method="POST" class="file-select-form">
      <input type="hidden" name="path" value="README.md">
      <button type="submit" name="selectFile" class="file-btn outline contrast" title="README.md"><span class="status-badge M">M</span><span class="tree-file-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M6 3h8l4 4v14H6z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /><path
    d="M14 3v4h4"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /></svg></span>
        <span class="file-label"><span class="file-name">README</span><span class="file-ext">.md</span></span>
        <span class="file-meta"><small class="diff-stats"><span class="add">+2</span></small></span>
      </button>
    </form>
    <form method="POST" class="file-viewed-form">
      <input type="hidden" name="path" value="README.md">
      <button type="submit" name="toggleViewed" class="viewed-toggle" aria-label="Mark as viewed" title="Mark viewed"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle
  cx="12"
  cy="12"
  r="8"
  stroke="currentColor"
  stroke-width="1.5"
  fill="none"
/></svg></button>
    </form>
  </div>
</li></ul>
  </div>
  
  <div class="resize-handle" aria-hidden="true"></div>
</dialog>

<main class="viewer"
      lvt-fx:viewport-report="reportViewport"
      data-lvt-viewport-items=".line, .md-block">


<article>
<div class="file-sticky" data-key="file-sticky">
  <header class="file-head"><span class="file-head-name" title="notes.txt"><strong class="fh-base">notes.txt</strong></span>
    
    <span class="file-head-view" role="toolbar" aria-label="How this file shows">
      <span class="fh-seg">
        <form method="POST" title="Only for Markdown and HTML files"><input type="hidden" name="view" value="rendered"><button type="submit" name="setMarkdownView" class="fh-btn" aria-pressed="false" disabled>Preview</button></form>
        <form method="POST" title="Only for Markdown and HTML files"><input type="hidden" name="view" value="raw"><button type="submit" name="setMarkdownView" class="fh-btn" aria-pressed="false" disabled>Raw</button></form>
      </span>
      <form method="POST" title="Mark what changed; off shows the plain file"><button type="submit" name="toggleFileView" class="fh-btn" aria-pressed="true"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
    d="M4 4h7v16H4zM13 4h7v16h-7z"
    stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"
  /><path
    d="M6 11h3M6 13h3M16 9v6M14 12h4"
    stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
  /></svg><span>Diff</span> <kbd class="kbd-hint" aria-hidden="true">d</kbd></button></form>
      <form method="POST" title="Show whitespace-only changes as unchanged"><button type="submit" name="toggleHideWhitespace" class="fh-btn" aria-pressed="false">Whitespace</button></form>
      <form method="POST" title="No mechanical changes to fold"><button type="submit" name="toggleFoldMechanical" class="fh-btn" aria-pressed="false" disabled>Fold</button></form>
      <form method="POST" class="region-toggle" title="Only on an image or the HTML preview"><button type="button" class="fh-btn" disabled><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.7" stroke-dasharray="2.6 2" fill="none"/><path d="M19 14v7M15.5 17.5h7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"/></svg><span class="annotate-word"> Annotate</span></button></form>
      <form method="POST" title="Only on the HTML preview, once it has annotations"><button type="submit" name="toggleBoxes" class="fh-btn" aria-pressed="false" disabled>Boxes <kbd class="kbd-hint" aria-hidden="true">b</kbd></button></form>
    </span>
    
    <span class="file-head-actions">
    
    
    
    
    <form method="POST" class="file-head-comment">
      <button
        type="submit"
        name="openFileComment"
        class="contrast"
        title="Add a comment about the whole file"
        aria-label="Comment on file"
      ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
    d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-5.5A8 8 0 1 1 21 12z"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"
  /></svg><span class="file-head-comment-label">Comment on file <kbd class="kbd-hint" aria-hidden="true">c</kbd></span></button>
    </form>
    
    <div
      class="tb-dropdown file-head-checks checks-dropdown"
      lvt-el:toggleClass:on:click="open"
      lvt-el:removeClass:on:click-away="open"
    >
      <button
        type="button"
        class="checks-trigger is-failing"
        aria-haspopup="menu"
        title="Checks on this file: 1 of 4 passed, 1 running."
      ><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path
    d="M4 6.5l1.8 1.8L9 5M4 13.5l1.8 1.8L9 12M4 20l1.8-1.5M12 7h8M12 14h8M12 20h8"
    stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"
  /></svg><span class="checks-trigger-label">Checks</span><span class="checks-count">1/4</span></button>
      <div class="tb-dropdown-panel checks-panel" role="menu" aria-label="Checks">
        <form method="POST" title="No judges on this file"><button type="submit" name="runJudges" class="menu-item" role="menuitem" disabled><span class="menu-label">Run judges<small class="menu-why">No judges on this file</small></span></button></form>
        <form method="POST"><button type="submit" name="openChecks" class="menu-item" role="menuitem"><span class="menu-label">All checks</span></button></form>
      </div>
    </div>

    
    
    </span>
  </header>
  
  
  <div class="ck-strip" data-key="checks-strip" role="status" aria-label="Showing one check">
    
    <span class="ck-pill ck-fail">fail</span><b class="ck-strip-name" title="Filler intensifiers">Filler intensifiers</b>
    <span class="ck-strip-nav">
      <form method="POST"><input type="hidden" name="dir" value="-1"><button type="submit" name="stepFinding" class="outline" aria-label="Previous finding">‹</button></form>
      <span class="ck-strip-pos"><span class="ck-pos-long">finding 1 of 1 in this file</span><span class="ck-pos-short" aria-hidden="true">1/1</span></span>
      <form method="POST"><input type="hidden" name="dir" value="1"><button type="submit" name="stepFinding" class="outline" aria-label="Next finding">›</button></form>
    </span>
    
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="filler-intensifiers"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this check">×</button></form>
    
  </div>
  

</div>
  
  
  
  
  
  
  <div class="file-head-marks">
    
    
    <div class="file-head-cards">
      
  
  
    </div>
  </div>
  
  
  
  
  <div class="code wrap-lines"
       data-key="code-notes.txt"
       data-path="notes.txt"
       lvt-fx:scroll="reset-on:data-path"
       lvt-fx:text-select="selectText"
       style="--diff-min-width: calc(0ch + 7ch)"><div class="line-row" data-key="row-L0-1"><div tabindex="0"
              lvt-on:click="selectLine"
              lvt-on:keydown="selectLine"
              lvt-key="Enter"
              data-line="1"
              data-side="new"
              class="line add"
              data-key="L0-1"><span class="gutter"><span class="gutter-mark">+ </span>1</span><span class="content chroma" data-line-text>This is <mark class="check-finding">very</mark> good.</span></div>
      <div class="finding-card sev-suggestion" data-key="finding-filler-intensifiers-0" role="note">
        <span class="finding-check">Filler intensifiers</span>
        <span class="finding-msg">&#39;very&#39; adds emphasis, not meaning; try cutting it.</span>
        <span class="finding-actions">
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="filler-intensifiers"><input type="hidden" name="index" value="0"><button type="submit" name="queueFinding" class="outline">Queue as comment</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="filler-intensifiers"><input type="hidden" name="index" value="0"><button type="submit" name="dismissFinding" class="outline secondary" title="It's fine here: stop flagging this one">Ignore</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="filler-intensifiers"><input type="hidden" name="index" value="0"><button type="submit" name="hideFinding" class="outline secondary" title="Fold this card for now; the underline stays">Hide</button></form>
        </span>
      </div>
</div>
<div class="line-row" data-key="row-L0-2"><div tabindex="0"
              lvt-on:click="selectLine"
              lvt-on:keydown="selectLine"
              lvt-key="Enter"
              data-line="2"
              data-side="new"
              class="line add"
              data-key="L0-2"><span class="gutter"><span class="gutter-mark">+ </span>2</span><span class="content chroma" data-line-text>Plain line.</span></div></div>
<div class="code-sentinel" aria-hidden="true"></div></div>
  
</article>








</main>



</div>



<div
  class="kbd-help-backdrop"
  lvt-on:click="toggleKeyboardHelp"
  aria-hidden="true"
></div>
<div
  class="kbd-help-modal"
  role="dialog"
  aria-label="Keyboard shortcuts"
  aria-modal="true"
>
  <div class="kbd-help-head">
    <strong>Keyboard shortcuts</strong>
    <form method="POST">
      <button
        type="submit"
        name="toggleKeyboardHelp"
        class="outline close-btn"
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
  d="M6 6l12 12M18 6L6 18"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  fill="none"
/></svg>
      </button>
    </form>
  </div>
  <dl class="kbd-help-list">
    <div class="kbd-row"><dt><kbd>j</kbd></dt><dd>Next file</dd></div>
    <div class="kbd-row"><dt><kbd>k</kbd></dt><dd>Previous file</dd></div>
    <div class="kbd-row"><dt><kbd>↓</kbd></dt><dd>Move line cursor down</dd></div>
    <div class="kbd-row"><dt><kbd>↑</kbd></dt><dd>Move line cursor up</dd></div>
    <div class="kbd-row"><dt><kbd>n</kbd></dt><dd>Next open item</dd></div>
    <div class="kbd-row"><dt><kbd>p</kbd></dt><dd>Previous open item</dd></div>
    <div class="kbd-row"><dt><kbd>c</kbd></dt><dd>Comment on this file</dd></div>
    <div class="kbd-row"><dt><kbd>f</kbd></dt><dd>Toggle file tree</dd></div>
    <div class="kbd-row"><dt><kbd>t</kbd></dt><dd>Toggle table of contents</dd></div>
    <div class="kbd-row"><dt><kbd>⌘/Ctrl &#43; K</kbd></dt><dd>Search files</dd></div>
    <div class="kbd-row"><dt><kbd>b</kbd></dt><dd>Show / hide annotation boxes</dd></div>
    <div class="kbd-row"><dt><kbd>a</kbd></dt><dd>All annotations</dd></div>
    <div class="kbd-row"><dt><kbd>z</kbd></dt><dd>Understand this change</dd></div>
    <div class="kbd-row"><dt><kbd>r</kbd></dt><dd>Show / hide resolved annotations here</dd></div>
    <div class="kbd-row"><dt><kbd>s</kbd></dt><dd>Show / hide suggestions here</dd></div>
    <div class="kbd-row"><dt><kbd>d</kbd></dt><dd>Diff: mark changes, or show the plain file</dd></div>
    <div class="kbd-row"><dt><kbd>u</kbd></dt><dd>Mark this file unread</dd></div>
    <div class="kbd-row"><dt><kbd>.</kbd></dt><dd>Focus mode (hide side columns)</dd></div>
    <div class="kbd-row"><dt><kbd>?</kbd></dt><dd>Keyboard shortcuts</dd></div>
    <div class="kbd-row"><dt><kbd>Esc</kbd></dt><dd>Cancel / close</dd></div>
    <div class="kbd-row"><dt><kbd>Enter</kbd></dt><dd>Comment on the line cursor</dd></div>
    <div class="kbd-row"><dt><kbd>⌘/Ctrl &#43; Enter</kbd></dt><dd>Save comment</dd></div>
  </dl>
  <p class="kbd-help-note">Drawing a precise region on rendered HTML or an image needs a mouse — from the keyboard, comment on the whole block or image instead.</p>
  
  <p class="kbd-help-usage"><a href="/_usage" target="_blank" rel="noopener">Open the usage guide ↗</a></p>
</div>


<div
  class="search-backdrop"
  lvt-on:click="closeSearch"
  aria-hidden="true"
></div>
<div
  class="search-modal"
  role="dialog"
  aria-label="Search files"
  aria-modal="true"
>
  
</div>

<footer class="app-footer" role="contentinfo">
  prereview v · built with <a
    href="https://github.com/livetemplate/livetemplate"
    target="_blank"
    rel="noopener noreferrer"
  >livetemplate</a>
</footer>




<dialog id="confirm-quit"><article><header><strong>Quit prereview?</strong></header><p><small>Stops the prereview server and closes the review. Saved comments are already written to the CSV; this can't be undone from the browser.</small></p><footer>
    <form method="POST">
      <fieldset role="group">
        <button
          type="button"
          command="close"
          commandfor="confirm-quit"
          class="secondary"
        >Cancel</button>
        <button
          type="submit"
          name="quit"
          class="contrast"
        >Quit</button>
      </fieldset>
    </form>
  </footer></article></dialog>

</div>
</div><script defer src="/livetemplate-client.js"></script>
<script defer src="/prereview-handlers.js"></script>
</body>
</html>


