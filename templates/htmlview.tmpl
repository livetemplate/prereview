{{define "htmlView"}}{{with $.CurrentDiff}}  {{/* Rendered-HTML view. The whole file renders once in a sandboxed
       <iframe srcdoc> — a real document, so var()/@media/vw/sticky all
       resolve against the iframe viewport (a shadow root can't do this).
       Each top-level <body> child in the srcdoc carries its REAL source
       line range (data-from / data-to). The sandbox is allow-scripts WITHOUT
       allow-same-origin: the page's own scripts RUN (so JS-generated CSS like
       the Tailwind Play CDN renders, #63) but the opaque origin blocks all
       access to the parent app. That also means the parent can't read the
       iframe's contentDocument, so lvt-fx:preview-bridge takes the height +
       block rects the in-iframe beacon (previewBridgeJS) posts out. Selecting
       a region to comment on is driven by a parent-document overlay, not from
       inside the iframe — iOS does not deliver iframe-internal events to parent
       listeners. Comments and the composer open in a card over the preview, by
       the box or marker they belong to (PreviewCard). */}}
  <div class="html-view" data-key="html-{{.Path}}">
    {{- /* sandboxed iframe preview + draw-a-region overlay */ -}}
    <div class="preview-stage{{if $.ShowBoxes}} show-boxes{{end}}"><iframe
      class="html-preview"
      sandbox="allow-scripts"
      srcdoc="{{$.RenderedHTMLDoc}}"
      lvt-fx:preview-bridge
      title="HTML preview of {{.Path}}"
    ></iframe>
      {{- /* One marker per commented block, showing its count: an invisible box
             the preview-bridge directive places over the block (from the rects
             the preview posts), with the marker at its corner. Tapping it
             scrolls the block's cards below into view and shows the boxes its
             comments were drawn with, each in its annotation colour; the
             block itself is outlined only for a comment with no box. The
             drawn boxes are placed by percentage: the layer covers the
             preview, which is sized to its page. A box the marker opened
             takes a tap, which brings it to the front (FrontBoxID). */ -}}
      {{- if or $.HTMLMarkers $.PreviewPendingBox $.PreviewCard}}<div class="pin-layer preview-pins" data-key="preview-pins">
        {{- range $.HTMLMarkers -}}
        {{- $mk := .Key -}}
        <div class="area-overlay
                {{- if .Acted}} is-acted{{else if not .Open}} is-resolved{{end}}
                {{- if .Unboxed}} is-unboxed{{end}}
                {{- if eq $.FocusedHTMLBlock .Key}} is-focused{{end -}}
                "
                data-id="{{.Key}}"
                data-from="{{.From}}"
                data-to="{{.To}}"><button type="button"
                class="pin-btn"
                lvt-on:click="focusHTMLBlock"
                data-id="{{.Key}}"
                aria-label="Show the comments on this block">{{.Total}}</button></div>
        {{- range .Boxed -}}
        <div class="area-overlay drawn-box {{index $.AnnotationColors .ID}}
                {{- if .Resolved}} is-resolved{{else if index $.AgentActedLabels .ID}} is-acted{{end}}
                {{- if and (eq $.FocusedHTMLBlock $mk) (not (index $.HiddenBoxes .ID))}} is-shown{{end}}
                {{- if eq $.FrontBoxID .ID}} is-front{{end -}}
                "
                data-box="{{.ID}}"
                lvt-on:click="raiseBox"
                style="left:{{.Anchor.Box.PercentX}};top:{{.Anchor.Box.PercentY}};width:{{.Anchor.Box.PercentW}};height:{{.Anchor.Box.PercentH}};">
          {{- if and (eq $.FocusedHTMLBlock $mk) (not (index $.HiddenBoxes .ID))}}{{template "annotationBar" .}}{{end -}}
        </div>
        {{- end -}}
        {{- end -}}
        {{- with $.PreviewPendingBox -}}
        <div class="area-overlay area-overlay-pending"
                data-box="pending"
                style="left:{{.PercentX}};top:{{.PercentY}};width:{{.PercentW}};height:{{.PercentH}};"></div>
        {{- end -}}
        {{- /* The open card (PreviewCard): a block's comments, suggestions and
               composer. Under a box (being drawn, or the block's drawn boxes)
               it is placed by percentage like the boxes; else it rides an
               anchor that lvt-fx:preview-bridge places over the block, as it
               does the markers, and opens under the marker. */ -}}
        {{- with $.PreviewCard -}}
        {{- if .Box -}}
        {{template "previewCard" .}}
        {{- else -}}
        <div class="area-overlay preview-card-anchor"
                data-key="preview-card-anchor"
                data-from="{{.Block.StartLine}}"
                data-to="{{.Block.EndLine}}">{{template "previewCard" .}}</div>
        {{- end -}}
        {{- end -}}
      </div>{{end}}
      {{- if $.RegionSelectArmed -}}
      <div
        class="region-overlay"
        lvt-fx:region-select="selectBlock"
        data-surface="html"
        data-key="region-html-{{.Path}}"
      ></div>
      {{- end -}}
    </div>
  </div>{{end}}{{end}}

{{/* previewCard is the card PreviewCard describes; `.` is the PreviewCardView. */}}
{{define "previewCard"}}<div class="preview-card{{if .Box}} on-box{{if .Right}} is-right{{end}}{{end}}"
          data-key="preview-card-{{.Block.StartLine}}-{{.Block.EndLine}}"
          {{- with .Box}} style="--card-top:{{.PercentBottom}};--card-left:{{.PercentX}};--card-right:{{.PercentRight}};"{{end}}>
            {{- if eq $.SelectionEndMax 0}}<button type="button" class="preview-card-close" lvt-on:click="closePreviewCard" title="Close" aria-label="Close">&times;</button>{{end -}}
            {{template "blockComments" .Block}}{{template "blockSuggestions" .Block}}
          </div>{{end}}
