{{/* Checks (checks M1/M1b): deterministic checkers. The file header's button
     shows "passed/total" for this file and opens the Checks page (library.tmpl)
     filtered to it; the bar above the code lists this file's failing checks, and
     picking one draws ITS findings inline (only one at a time, so a noisy rule
     can't unfold the file) and turns the bar into a finding stepper. All server
     state — no custom JS. */}}
{{define "checksButton"}}{{with $.CheckSummary}}
    {{- /* #279: the button is a menu (Run judges, All checks), so Run judges
           needs no bar above the code. Run judges is always listed; with no
           judges on the file it is greyed out with the reason, like every other
           control that can't act. */ -}}
    <div
      class="tb-dropdown file-head-checks checks-dropdown"
      lvt-el:toggleClass:on:click="open"
      lvt-el:removeClass:on:click-away="open"
    >
      <button
        type="button"
        class="checks-trigger{{if .Failing}} is-failing{{else if .Running}} is-running{{else}} is-passing{{end}}{{if .JudgeWaiting}} is-waiting{{end}}"
        aria-haspopup="menu"
        title="Checks on this file: {{.Passed}} of {{.Total}} passed{{if .Running}}, {{.Running}} running{{end}}{{if .JudgeWaiting}}, waiting on your agent for {{.JudgeWaiting}} judge{{if ne .JudgeWaiting 1}}s{{end}}{{end}}."
      >{{template "iconCheckList"}}<span class="checks-trigger-label">Checks</span><span class="checks-count">{{.Passed}}/{{.Total}}</span></button>
      <div class="tb-dropdown-panel checks-panel" role="menu" aria-label="Checks">
        {{if not .JudgesRun}}<form method="POST" title="No judges on this file"><button type="submit" name="runJudges" class="menu-item" role="menuitem" disabled><span class="menu-label">Run judges<small class="menu-why">No judges on this file</small></span></button></form>
        {{else if .NeedsAgent}}<p class="checks-menu-note" role="none">Run judges — needs an agent. <a href="/_usage#judges" target="_blank" rel="noopener">How to start one</a></p>
        {{else if .JudgeWaiting}}<p class="checks-menu-note is-waiting" role="status">Asked your agent · {{.JudgeWaiting}} judge{{if ne .JudgeWaiting 1}}s{{end}}</p>
        {{else}}<form method="POST"><button type="submit" name="runJudges" class="menu-item" role="menuitem"><span class="menu-label">{{if .JudgeTimedOut}}No answer yet — run judges again{{else if .JudgesStale}}Re-run judges ({{.JudgesStale}} stale){{else}}Run judges ({{.JudgesRun}}){{end}}</span></button></form>
        {{end}}<form method="POST"><button type="submit" name="openChecks" class="menu-item" role="menuitem"><span class="menu-label">All checks</span></button></form>
      </div>
    </div>
{{end}}{{end}}

{{define "libraryButton"}}
  <form method="POST" class="library-form">
    <button
      type="submit"
      name="toggleLibrary"
      class="contrast library-trigger{{if $.ShowLibrary}} is-on{{end}}"
      aria-pressed="{{if $.ShowLibrary}}true{{else}}false{{end}}"
      title="Library: the learnings and checks every review on this machine uses"
    >{{template "iconLibrary"}}<span class="tb-label">Library</span>{{if $.LearnNew}}<span class="lib-badge" title="{{$.LearnNew}} new learning{{if ne $.LearnNew 1}}s{{end}} proposed">{{$.LearnNew}}</span>{{end}}{{if $.LearnStalled}}<span class="agent-dot is-stalled" role="img" aria-label="Learning is waiting: your agent's learner isn't running" title="Learning is waiting: your agent's learner isn't running"></span>{{end}}</button>
  </form>
{{end}}

{{define "checksStrip"}}{{with $.CheckStrip}}
  <div class="ck-strip{{if not .Selected}} is-idle{{end}}{{if .Judge}} is-judge{{end}}" data-key="checks-strip" role="{{if .Selected}}status{{else}}group{{end}}" aria-label="{{if .Judge}}Showing one judge{{else if .Selected}}Showing one check{{else}}Failing checks on this file{{end}}">
    {{if .Judge}}
    <span class="ck-pill ck-{{.Judge.Status}}">{{.Judge.Status}}</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-pill ck-advisory" title="{{if .Calibrated}}Calibrated: counts in Checks n/m{{else}}Advisory: shown, not counted, until it agrees with you often enough{{end}}">judge · {{if .Calibrated}}calibrated{{else}}advisory{{end}}</span>
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this judge">×</button></form>
    {{else if .Selected}}
    <span class="ck-pill ck-fail">fail</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-strip-nav">
      <form method="POST"><input type="hidden" name="dir" value="-1"><button type="submit" name="stepFinding" class="outline" aria-label="Previous finding">‹</button></form>
      <span class="ck-strip-pos"><span class="ck-pos-long">finding {{.Pos}} of {{.Count}} in this file</span><span class="ck-pos-short" aria-hidden="true">{{.Pos}}/{{.Count}}</span></span>
      <form method="POST"><input type="hidden" name="dir" value="1"><button type="submit" name="stepFinding" class="outline" aria-label="Next finding">›</button></form>
    </span>
    {{if .Hidden}}<form method="POST" class="ck-strip-hidden"><button type="submit" name="showHiddenFindings" class="ck-link" title="Show the cards you hid">{{.Hidden}} hidden · show</button></form>{{end}}
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this check">×</button></form>
    {{else}}
    {{if .Failing}}<form method="POST"><button type="submit" name="toggleCheckStrip" class="outline ck-strip-sum" aria-expanded="{{if .Open}}true{{else}}false{{end}}" title="{{if .Open}}Hide{{else}}Show{{end}} the failing checks">{{len .Failing}} failing{{if .FailingChecks}} · {{.FailingChecks}} check{{if ne .FailingChecks 1}}s{{end}}{{end}}{{if .FailingJudges}} · {{.FailingJudges}} judge{{if ne .FailingJudges 1}}s{{end}}{{end}}{{template "iconChevronDown"}}</button></form>
    {{end}}<form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    {{if and .Failing .Open}}<div class="ck-strip-list">{{range .Failing}}<form method="POST" class="ck-strip-pick"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline{{if .Judge}} is-judge{{end}}">{{.Name}} {{if .Judge}}<span class="ck-judge-tag">judge{{if .Advisory}} · advisory{{end}}</span>{{else}}<span class="ck-strip-n">{{.Count}}</span>{{end}}</button></form>
    {{end}}</div>{{end}}
    {{end}}
  </div>
  {{with .Judge}}<div class="jv-card" data-key="judge-card" role="note">
    {{with .Critique}}<p class="jv-critique">{{.}}</p>{{end}}
    {{if eq .Status "stale"}}<p class="jv-stale">This verdict is for an older version of the file or the rubric.</p>{{end}}
    <div class="jv-actions">
      {{if .Queued}}<span class="ck-pill ck-open" title="Already queued as a comment">Queued</span>{{else}}<form method="POST"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="queueJudgment" class="outline">Queue as comment</button></form>{{end}}
      {{template "judgeVerdictActions" .}}
    </div>
  </div>{{end}}
{{end}}{{end}}

{{/* judgeVerdictActions: Show in file (when the quote was found), then the
     calibration group — Agree / Disagree (choosing your current answer again
     takes it back) and the model — kept on one line and pushed right, so on a
     phone it wraps below as a unit. Shared by the file's judge card and the
     Checks page's verdict rows. Called with a JudgeVerdictView as "." (like
     findingCard with a FindingView). */}}
{{define "judgeVerdictActions"}}{{if .CanShow}}<form method="POST" class="ckp-show"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="0"><button type="submit" name="jumpToFinding" class="outline">Show in file</button></form>
      {{end}}{{if or (eq .Status "fail") (eq .Status "ignored")}}<form method="POST" class="jv-ignore"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="toggleIgnoreVerdict" class="outline secondary jv-btn{{if eq .Status "ignored"}} is-on{{end}}" aria-pressed="{{if eq .Status "ignored"}}true{{else}}false{{end}}" title="{{if eq .Status "ignored"}}Bring it back{{else}}It's fine here: stop counting it until the file or the rubric changes{{end}}">{{if eq .Status "ignored"}}Ignored{{else}}Ignore{{end}}</button></form>
      {{end}}<span class="jv-agree"><span class="jv-label">Agree?</span>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="agree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "agree"}} is-on{{end}}" aria-pressed="{{if eq .Label "agree"}}true{{else}}false{{end}}">Agree</button></form>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="disagree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "disagree"}} is-on{{end}}" aria-pressed="{{if eq .Label "disagree"}}true{{else}}false{{end}}">Disagree</button></form>
      {{with .Model}}<span class="ck-src">{{.}}</span>{{end}}</span>{{end}}

{{define "findingCard"}}
      <div class="finding-card sev-{{.Severity}}" data-key="finding-{{.CheckID}}-{{.Index}}" role="note">
        <span class="finding-check">{{.CheckName}}</span>
        <span class="finding-msg">{{.Message}}</span>
        <span class="finding-actions">
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="queueFinding" class="outline">Queue as comment</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="dismissFinding" class="outline secondary" title="It's fine here: stop flagging this one">Ignore</button></form>
          <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="hideFinding" class="outline secondary" title="Fold this card for now; the underline stays">Hide</button></form>
        </span>
      </div>
{{end}}
