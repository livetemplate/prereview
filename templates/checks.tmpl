{{/* Checks (checks M1/M1b): deterministic checkers. The file header's button
     shows "passed/total" for this file and opens the Checks page (library.tmpl)
     filtered to it; the bar above the code lists this file's failing checks, and
     picking one draws ITS findings inline (only one at a time, so a noisy rule
     can't unfold the file) and turns the bar into a finding stepper. All server
     state — no custom JS. */}}
{{define "checksButton"}}{{with $.CheckSummary}}
    <form method="POST" class="file-head-checks">
      <button
        type="submit"
        name="openChecks"
        class="checks-trigger{{if .Failing}} is-failing{{else if .Running}} is-running{{else}} is-passing{{end}}"
        title="Checks on this file: {{.Passed}} of {{.Total}} passed{{if .Running}}, {{.Running}} running{{end}}. Opens the Checks page."
      >{{template "iconCheckList"}}<span class="checks-trigger-label">Checks</span><span class="checks-count">{{.Passed}}/{{.Total}}</span></button>
    </form>
{{end}}{{end}}

{{define "libraryButton"}}
  <form method="POST" class="library-form">
    <button
      type="submit"
      name="toggleLibrary"
      class="contrast library-trigger{{if $.ShowLibrary}} is-on{{end}}"
      aria-pressed="{{if $.ShowLibrary}}true{{else}}false{{end}}"
      title="Library: the checks every review on this machine uses"
    >{{template "iconLibrary"}}<span class="tb-label">Library</span></button>
  </form>
{{end}}

{{define "checksStrip"}}{{with $.CheckStrip}}
  <div class="ck-strip{{if not .Selected}} is-idle{{end}}{{if .Judge}} is-judge{{end}}" data-key="checks-strip" role="{{if .Selected}}status{{else}}group{{end}}" aria-label="{{if .Judge}}Showing one judge{{else if .Selected}}Showing one check{{else}}Failing checks on this file{{end}}">
    {{if .Judge}}
    <span class="ck-pill ck-{{.Judge.Status}}">{{.Judge.Status}}</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-pill ck-advisory">judge · advisory</span>
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this judge">×</button></form>
    {{else if .Selected}}
    <span class="ck-pill ck-fail">fail</span><b class="ck-strip-name" title="{{.Name}}">{{.Name}}</b>
    <span class="ck-strip-nav">
      <form method="POST"><input type="hidden" name="dir" value="-1"><button type="submit" name="stepFinding" class="outline" aria-label="Previous finding">‹</button></form>
      <span class="ck-strip-pos"><span class="ck-pos-long">finding {{.Pos}} of {{.Count}} in this file</span><span class="ck-pos-short" aria-hidden="true">{{.Pos}}/{{.Count}}</span></span>
      <form method="POST"><input type="hidden" name="dir" value="1"><button type="submit" name="stepFinding" class="outline" aria-label="Next finding">›</button></form>
    </span>
    <form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    <form method="POST" class="ck-strip-close"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline" aria-label="Stop showing this check">×</button></form>
    {{else}}
    {{if .Failing}}<span class="ck-strip-pos">Failing:</span>
    {{range .Failing}}<form method="POST" class="ck-strip-pick"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="selectCheck" class="outline{{if .Judge}} is-judge{{end}}">{{.Name}} {{if .Judge}}<span class="ck-judge-tag">judge</span>{{else}}<span class="ck-strip-n">{{.Count}}</span>{{end}}</button></form>
    {{end}}{{end}}{{if .JudgesRun}}{{if .NeedsAgent}}<span class="ck-strip-run"><button type="button" class="outline" disabled title="Judges are run by your coding agent">Run judges — needs an agent</button> <a class="ck-link" href="/_usage#judges" target="_blank" rel="noopener">How to start one</a></span>
    {{else if .JudgeWaiting}}<span class="ck-waiting" role="status">Asked your agent · {{.JudgeWaiting}} judge{{if ne .JudgeWaiting 1}}s{{end}}</span>
    {{else}}<form method="POST" class="ck-strip-run"><button type="submit" name="runJudges" class="outline">{{if .JudgeTimedOut}}No answer yet — run judges again{{else if .JudgesStale}}Re-run judges ({{.JudgesStale}} stale){{else}}Run judges ({{.JudgesRun}}){{end}}</button></form>
    {{end}}{{end}}<form method="POST" class="ck-strip-all"><button type="submit" name="openChecks" class="ck-link">All checks</button></form>
    {{end}}
  </div>
  {{with .Judge}}<div class="jv-card" data-key="judge-card" role="note">
    {{with .Critique}}<p class="jv-critique">{{.}}</p>{{end}}
    {{if eq .Status "stale"}}<p class="jv-stale">This verdict is for an older version of the file or the rubric.</p>{{end}}
    <div class="jv-actions">
      <form method="POST"><input type="hidden" name="id" value="{{.CheckID}}"><button type="submit" name="queueJudgment" class="outline">Queue as comment</button></form>
      {{template "judgeVerdictActions" .}}
    </div>
  </div>{{end}}
{{end}}{{end}}

{{/* judgeVerdictActions: Show in file (when the quote was found), Agree /
     Disagree (choosing your current answer again takes it back) and the model —
     shared by the file's judge card and the Checks page's verdict rows. Called
     with a JudgeVerdictView as "." (like findingCard with a FindingView). */}}
{{define "judgeVerdictActions"}}{{if .CanShow}}<form method="POST" class="ckp-show"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="0"><button type="submit" name="jumpToFinding" class="outline">Show in file</button></form>
      {{end}}<span class="jv-label">Agree?</span>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="agree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "agree"}} is-on{{end}}" aria-pressed="{{if eq .Label "agree"}}true{{else}}false{{end}}">Agree</button></form>
      <form method="POST"><input type="hidden" name="path" value="{{.Path}}"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="label" value="disagree"><button type="submit" name="labelJudgment" class="outline jv-btn{{if eq .Label "disagree"}} is-on{{end}}" aria-pressed="{{if eq .Label "disagree"}}true{{else}}false{{end}}">Disagree</button></form>
      {{with .Model}}<span class="ck-src">{{.}}</span>{{end}}{{end}}

{{define "findingCard"}}
      <div class="finding-card sev-{{.Severity}}" data-key="finding-{{.CheckID}}-{{.Index}}" role="note">
        <span class="finding-check">{{.CheckName}}</span>
        <span class="finding-msg">{{.Message}}</span>
        <form method="POST" class="finding-queue"><input type="hidden" name="id" value="{{.CheckID}}"><input type="hidden" name="index" value="{{.Index}}"><button type="submit" name="queueFinding" class="outline">Queue as comment</button></form>
      </div>
{{end}}
