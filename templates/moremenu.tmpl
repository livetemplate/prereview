{{define "moreMenu" -}}
<div
  class="more-menu-backdrop{{if .MoreMenuOpen}} is-open{{end}}"
  lvt-on:click="closeMoreMenu"
  aria-hidden="true"
></div>
<div
  class="more-menu{{if .MoreMenuOpen}} is-open{{end}}"
  role="menu"
  aria-label="More options"
>
  <div class="menu-info">{{len .Files}} files{{if gt .ChangedFilesCount 0}} · {{.ChangedFilesCount}} changed{{end}} · {{.ScopeViewedCount}}/{{.ScopeFileCount}} viewed
    {{- if gt .CommentCount 0}} · {{.CommentCount}} comment{{if ne .CommentCount 1}}s{{end}}{{end -}}
  </div>
  {{/* Prev/Next file moved here from the bar on mobile (#119) so the narrow bar
       stays tidy (☰ 🔍 Queue Pause ⋮). Pause/resume + End session stay inline
       (there's room). Desktop keeps these inline (this menu is display:none
       ≥900px); their bar copies are hidden <900px via CSS. */}}
  {{if and (gt (len .Files) 1) (not .LiveShowing)}}
  <form method="POST">
    <button type="submit" name="prevFile" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconChevronLeft"}}</span>
      <span class="menu-label">Previous file</span>
    </button>
  </form>
  <form method="POST">
    <button type="submit" name="nextFile" class="menu-item" role="menuitem">
      <span class="menu-icon">{{template "iconChevronRight"}}</span>
      <span class="menu-label">Next file</span>
    </button>
  </form>
  {{end}}
  {{/* Color scheme + mode — mirror the desktop toolbar palette + sun/moon.
       Scheme cycles Solarized → Gruvbox → Catppuccin; mode cycles
       System → Light → Dark; meta shows what the next tap switches to.
       First items so they're always reachable regardless of the open file. */}}
  <form method="POST">
    <button
      type="submit"
      name="cycleScheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon">{{template "iconPalette"}}</span>
      <span class="menu-label">Scheme: {{.SchemeLabel}}</span>
      <span class="menu-meta">{{.NextSchemeLabel}} →</span>
    </button>
  </form>
  <form method="POST">
    <button
      type="submit"
      name="cycleTheme"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon">{{if eq .ThemeMode "light"}}{{template "iconThemeLight"}}{{else if eq .ThemeMode "dark"}}{{template "iconThemeDark"}}{{else}}{{template "iconThemeSystem"}}{{end}}</span>
      <span class="menu-label">Mode: {{.ThemeModeLabel}}</span>
      <span class="menu-meta">{{.NextThemeModeLabel}} →</span>
    </button>
  </form>
  {{if .FileShowing}}
  {{/* "Comment on file" now lives in the sticky file header (.file-head),
       reachable on mobile too — so it's no longer mirrored in this menu. */}}
  {{with .RenderedHeadings}}
  {{/* Mobile-only entry — desktop renders the TOC as a permanent right
       sidebar, so this is `display: none` ≥900px via the media query.
       OpenTOC closes the more-menu in the same action so the dropdown
       doesn't stay drawn over the overlay it just summoned. */}}
  <form method="POST">
    <button
      type="submit"
      name="openTOC"
      class="menu-item toc-menu-item"
      role="menuitem"
    >
      <span class="menu-icon">{{template "iconTOC"}}</span>
      <span class="menu-label">Table of contents</span>
      <span class="menu-meta">{{len .}}</span>
    </button>
  </form>
  {{end}}
  {{/* This file's view controls, the same seven as the desktop file header
       (fileheader.tmpl), with the same names. All are listed while a file is
       open; one that doesn't apply is disabled, with its reason under the label
       since a phone has no hover. */}}
  <form method="POST" title="{{if $.CanMarkUnread}}Forget that you read this file: its Viewed mark and reading progress{{else}}Nothing read in this file yet{{end}}">
    <button
      type="submit"
      name="markUnread"
      class="menu-item"
      role="menuitem"
      {{if not $.CanMarkUnread}}disabled{{end}}
    >
      <span class="menu-icon">{{template "iconViewedCircle"}}</span>
      <span class="menu-label">Mark unread{{with index $.KeyHint "markUnread"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not $.CanMarkUnread}}<small class="menu-why">Nothing read in this file yet</small>{{end}}</span>
    </button>
  </form>
  {{- $previewable := or $.IsMarkdown $.IsHTML}}
  {{- $raw := or (and $.IsMarkdown $.RawMarkdown) (and $.IsHTML $.RawHTML)}}
  <form method="POST" title="{{if $previewable}}Show the rendered file{{else}}Only for Markdown and HTML files{{end}}"><input type="hidden" name="view" value="rendered">
    <button
      type="submit"
      name="{{if $.IsHTML}}setHTMLView{{else}}setMarkdownView{{end}}"
      class="menu-item menu-file-view{{if and $previewable (not $raw)}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and $previewable (not $raw)}}true{{else}}false{{end}}"
      {{if not $previewable}}disabled{{end}}
    >
      <span class="menu-icon">{{if and $previewable (not $raw)}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Preview{{if not $previewable}}<small class="menu-why">Only for Markdown and HTML files</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if $previewable}}Show the raw source{{else}}Only for Markdown and HTML files{{end}}"><input type="hidden" name="view" value="raw">
    <button
      type="submit"
      name="{{if $.IsHTML}}setHTMLView{{else}}setMarkdownView{{end}}"
      class="menu-item menu-file-view{{if and $previewable $raw}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and $previewable $raw}}true{{else}}false{{end}}"
      {{if not $previewable}}disabled{{end}}
    >
      <span class="menu-icon">{{if and $previewable $raw}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Raw{{if not $previewable}}<small class="menu-why">Only for Markdown and HTML files</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if (not $.ShowRenderedHTML)}}Mark what changed; off shows the plain file{{else}}Not in the HTML preview{{end}}">
    <button
      type="submit"
      name="toggleFileView"
      class="menu-item menu-file-view{{if and (not $.ShowRenderedHTML) (not $.FileView)}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and (not $.ShowRenderedHTML) (not $.FileView)}}true{{else}}false{{end}}"
      {{if not (not $.ShowRenderedHTML)}}disabled{{end}}
    >
      <span class="menu-icon">{{if and (not $.ShowRenderedHTML) (not $.FileView)}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Diff{{with index $.KeyHint "toggleFileView"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not (not $.ShowRenderedHTML)}}<small class="menu-why">Not in the HTML preview</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if $.ShowsDiffRows}}Show whitespace-only changes as unchanged{{else}}Only in a diff{{end}}">
    <button
      type="submit"
      name="toggleHideWhitespace"
      class="menu-item menu-file-view{{if and $.ShowsDiffRows $.HideWhitespace}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and $.ShowsDiffRows $.HideWhitespace}}true{{else}}false{{end}}"
      {{if not $.ShowsDiffRows}}disabled{{end}}
    >
      <span class="menu-icon">{{if and $.ShowsDiffRows $.HideWhitespace}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Whitespace{{if not $.ShowsDiffRows}}<small class="menu-why">Only in a diff</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if $.HasMechanical}}Fold the changes the walkthrough calls mechanical{{else}}No mechanical changes to fold{{end}}">
    <button
      type="submit"
      name="toggleFoldMechanical"
      class="menu-item menu-file-view{{if and $.HasMechanical (not $.UnfoldMechanical)}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and $.HasMechanical (not $.UnfoldMechanical)}}true{{else}}false{{end}}"
      {{if not $.HasMechanical}}disabled{{end}}
    >
      <span class="menu-icon">{{if and $.HasMechanical (not $.UnfoldMechanical)}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Fold{{if not $.HasMechanical}}<small class="menu-why">No mechanical changes to fold</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if $.CanAnnotate}}Drag a box on the page to comment on that part{{else}}Only on an image or the HTML preview{{end}}">
    <button
      type="submit"
      name="toggleRegionSelect"
      class="menu-item menu-file-view{{if and $.CanAnnotate $.RegionSelectArmed}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and $.CanAnnotate $.RegionSelectArmed}}true{{else}}false{{end}}"
      {{if not $.CanAnnotate}}disabled{{end}}
    >
      <span class="menu-icon">{{if and $.CanAnnotate $.RegionSelectArmed}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">{{if $.RegionSelectArmed}}Annotating — tap to stop{{else}}Annotate{{end}}{{if not $.CanAnnotate}}<small class="menu-why">Only on an image or the HTML preview</small>{{end}}</span>
    </button>
  </form>
  <form method="POST" title="{{if (gt (len $.HTMLMarkers) 0)}}Outline every annotation's box{{else}}Only on the HTML preview, once it has annotations{{end}}">
    <button
      type="submit"
      name="toggleBoxes"
      class="menu-item menu-file-view{{if and (gt (len $.HTMLMarkers) 0) $.ShowBoxes}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and (gt (len $.HTMLMarkers) 0) $.ShowBoxes}}true{{else}}false{{end}}"
      {{if not (gt (len $.HTMLMarkers) 0)}}disabled{{end}}
    >
      <span class="menu-icon">{{if and (gt (len $.HTMLMarkers) 0) $.ShowBoxes}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Boxes{{with index $.KeyHint "toggleBoxes"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not (gt (len $.HTMLMarkers) 0)}}<small class="menu-why">Only on the HTML preview, once it has annotations</small>{{end}}</span>
    </button>
  </form>
  {{end}}
  {{if .LiveShowing}}
  <form method="POST" title="{{if .RegionComments}}Outline every annotation's box on the page{{else}}No annotations on this page{{end}}">
    <button
      type="submit"
      name="toggleBoxes"
      class="menu-item{{if and .RegionComments .ShowBoxes}} is-on{{end}}"
      role="menuitemcheckbox"
      aria-checked="{{if and .RegionComments .ShowBoxes}}true{{else}}false{{end}}"
      {{if not .RegionComments}}disabled{{end}}
    >
      <span class="menu-icon">{{if and .RegionComments .ShowBoxes}}{{template "iconCheck"}}{{else}}{{template "iconCircle16"}}{{end}}</span>
      <span class="menu-label">Boxes{{with index $.KeyHint "toggleBoxes"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not .RegionComments}}<small class="menu-why">No annotations on this page</small>{{end}}</span>
    </button>
  </form>
  {{end}}
  {{/* Annotations and Understand are always listed, as on the desktop
       toolbar. One that can't act is disabled, and since a phone has no hover,
       its reason shows under the label. */}}
  {{$annOn := or (gt .CommentCount 0) .ShowAllComments}}
  <form method="POST"{{if not $annOn}} title="No annotations yet"{{end}}>
    <button
      type="submit"
      name="toggleCommentList"
      class="menu-item"
      role="menuitem"
      {{if not $annOn}}disabled{{end}}
    >
      <span class="menu-icon">{{template "iconComments"}}</span>
      <span class="menu-label">{{if .ShowAllComments}}Back{{else}}Annotations{{end}}{{with index $.KeyHint "toggleCommentList"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not $annOn}}<small class="menu-why">No annotations yet</small>{{end}}</span>
      {{if gt .CommentCount 0}}<span class="menu-meta">{{.CommentCount}}</span>{{end}}
    </button>
  </form>
  {{$undOn := or .ShowUnderstandEntry .ShowUnderstand}}
  <form method="POST" title="{{if $undOn}}Walk through the whole change, and quiz yourself on it{{else}}No walkthrough or quiz yet, and no agent to make one{{end}}">
    <button
      type="submit"
      name="toggleUnderstand"
      class="menu-item"
      role="menuitem"
      {{if not $undOn}}disabled{{end}}
    >
      <span class="menu-icon">{{template "iconQuiz"}}</span>
      <span class="menu-label">{{if .ShowUnderstand}}Back{{else}}Understand{{end}}{{with index $.KeyHint "toggleUnderstand"}} <kbd class="kbd-hint" aria-hidden="true">{{.}}</kbd>{{end}}{{if not $undOn}}<small class="menu-why">No walkthrough or quiz yet, and no agent to make one</small>{{end}}</span>
      {{with .QuizScoreLabel}}<span class="menu-meta">{{.}}</span>{{end}}
    </button>
  </form>
  {{/* Show resolved, suggestions, all-or-none and the two unhides live in the
       file's Annotations filter (annfilter.tmpl), on a phone too, so the menu
       doesn't repeat them. */}}
  {{if gt .DecisionCount 0}}
  <div class="menu-info sg-decision-count">{{.DecisionCount}} suggestion decision{{if ne .DecisionCount 1}}s{{end}} recorded</div>
  {{end}}
  {{if and (eq .CommentCount 0) (eq .ResolvedCount 0)}}
  <div
    class="menu-info"
    style="border-bottom: 0; margin-bottom: 0; font-style: italic;"
  >No comments yet — tap a line to add one.</div>
  {{end}}
  {{/* End session now lives in the Queue dropdown (the session hub) — reachable
       on mobile too since that dropdown is a direct child of the bar. */}}
  {{/* Keyboard shortcuts — same toggleKeyboardHelp action as the "?" key and
       the desktop toolbar button. Always available. */}}
  <form method="POST">
    <button
      type="submit"
      name="toggleKeyboardHelp"
      class="menu-item"
      role="menuitem"
    >
      <span class="menu-icon" aria-hidden="true">?</span>
      <span class="menu-label">Keyboard shortcuts</span>
    </button>
  </form>
  {{/* Usage guide — standalone /_usage page, opened in a new tab. */}}
  <a class="menu-item" role="menuitem" href="/_usage" target="_blank" rel="noopener">
    <span class="menu-icon">{{template "iconBook"}}</span>
    <span class="menu-label">Usage guide</span>
  </a>
</div>
{{- end -}}
