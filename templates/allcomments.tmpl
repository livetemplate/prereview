{{define "allComments" -}}
<section class="all-comments">
  <header class="ac-head">
    <strong>Annotations</strong>
    {{template "annFilter" $}}
    {{if .AnnotationsListed}}{{$live := eq .CommentListFilter "annotations"}}<div class="ac-filter">
      <button type="button" lvt-on:click="setCommentFilter" data-filter=""
        class="lib-chip{{if not $live}} is-on{{end}}" aria-pressed="{{not $live}}">Everything</button>
      <button type="button" lvt-on:click="setCommentFilter" data-filter="annotations"
        class="lib-chip{{if $live}} is-on{{end}}" aria-pressed="{{$live}}"
        title="Only the boxes drawn on the live site">Live site {{.AnnotationsListed}}</button>
    </div>{{end}}
    {{if .UnresolvedListed}}<form method="POST" class="ac-resolve-all">
      <button
        type="submit"
        name="resolveAll"
        class="outline"
        title="Resolve every comment listed here"
      >Resolve all {{.UnresolvedListed}}</button>
    </form>{{end}}
    <form method="POST" style="margin:0">
      <button
        type="submit"
        name="toggleCommentList"
        class="outline contrast"
        title="Return to the file you were viewing"
      >Back</button>
    </form>
  </header>
  {{if .AnnotationList}}
  <ul class="ac-list">
    {{range .AnnotationList}}{{with .Comment}}
    <li
      class="ac-item{{if .Resolved}} is-resolved{{end}}{{if eq $.ScrollToCommentID .ID}} is-target{{end}}{{with index $.AnnotationColors .ID}} {{.}}{{end}}"
      data-key="{{.ID}}"
      {{- if eq $.ScrollToCommentID .ID}} lvt-fx:scroll="into-view"{{end}}
    >
      <form method="POST" class="ac-jump">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" name="jumpToComment" class="ac-jump-btn">
          <div class="ac-where">{{if .IsRegionLevel}}<small class="anno-label ck-judge-tag">annotation {{index $.AnnotationNumbers .ID}}</small> {{end}}<code>{{.Location}}</code>{{if not .IsRegionLevel}} · {{.LineSpan}}{{with .Side}} <small>({{.}})</small>{{end}}{{end}}
            {{- if .Resolved}} <small class="resolved-badge">resolved</small>{{end}}
            {{- if .AnchorMoved}} <small class="moved-badge">moved</small>{{end}}
            {{- if and .AnchorEdited (not .Resolved) (not .Processed)}} <small class="edited-badge" title="exactly these lines were edited — likely addressed; confirm and resolve">likely addressed</small>{{end}}
            {{- if .AnchorOutdated}} <small class="outdated-badge">outdated</small>{{end}}
            {{- if .Processed}} {{template "processedBadge"}}{{end}}
            {{- if eq (index $.CommentQueueStates .ID) "answered"}} {{template "answeredBadge"}}{{end}}
            {{- if index $.AwaitingAgent .ID}} {{template "awaitingBadge"}}{{end}}
            {{- with .Source}} {{template "sourceBadge" .}}{{end -}}
          </div>
          <div class="ac-body">{{.Headline}}</div>
        </button>
      </form>
      {{if .AnchorOutdated}}<details class="anchor-orig"><summary>⚠ the document changed here — originally anchored to:</summary><pre>{{.Anchor.Text}}</pre></details>{{end}}
      {{- template "thread" (index $.ThreadViews .ID) -}}
      {{- if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{end}}
      <div class="ac-actions">
        {{if .IsRegionLevel -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="jumpToComment"
            class="outline ac-show-on-page"
            title="Back to the live site, with this annotation's box outlined"
          >Show on page</button>
        </form>
        {{- end}}
        {{if ne $.ReplyingID .ID -}}
        {{template "replyButton" .}}
        {{- end}}
        <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button
        type="submit"
        name="toggleResolved"
        class="outline"
      >{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>
        {{if .Resolved -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="hideComment"
            class="outline"
          >Hide</button>
        </form>
        {{- end}}
        {{if and (not .Resolved) .AnchorOutdated -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="reanchorComment"
            class="outline"
          >Re-anchor</button>
        </form>
        {{- end}}
        {{if and (not .Resolved) (not .AnchorOutdated) -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="editComment"
            class="outline"
          >Edit</button>
        </form>
        {{- end}}
        <button
      type="button"
      class="secondary outline"
      command="show-modal"
      commandfor="confirm-delete-{{.ID}}"
    >Delete</button>
        {{template "deleteDialog" .}}
      </div>
    </li>
    {{else}}
    <li class="ac-row{{with .State}} is-settled{{end}}" data-key="{{.Key}}">
      <form method="POST" class="ac-jump">
        <input type="hidden" name="kind" value="{{.Kind}}">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" name="jumpToAnnotation" class="ac-jump-btn" title="Open it on its file">
          <div class="ac-where"><small class="ac-kind">{{.Label}}</small> <code>{{.File}}</code> · {{.Span}}{{with .State}} <small class="resolved-badge">{{.}}</small>{{end}}</div>
          <div class="ac-body">{{.Text}}</div>
        </button>
      </form>
    </li>
    {{end}}{{end}}
  </ul>
  {{else}}
  {{/* Empty overview: a centered message + a prominent Back so the user
       isn't stranded on a near-blank page with only the small sticky-
       header Back (issue #27). Both empty branches get the Back; the
       empty state says whether the filter is what hides them. */}}
  <div class="ac-empty">
    <p class="ac-empty-msg">
      {{- if .HasAnyAnnotation}}The filter hides every annotation. Change it above to see them.
      {{- else}}No annotations yet.
      {{- end -}}
    </p>
    <form method="POST" style="margin:0">
      <button
        type="submit"
        name="toggleCommentList"
        class="contrast ac-empty-back"
        title="Return to the file you were viewing"
      >← Back to file</button>
    </form>
  </div>
  {{end}}
</section>
{{- end -}}
