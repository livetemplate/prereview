{{define "allComments" -}}
<section class="all-comments">
  <header class="ac-head">
    <strong>All comments ({{.CommentCount}})</strong>
    {{if .AnnotationsListed}}<div class="ac-filter">
      <form method="POST"><input type="hidden" name="filter" value=""><button
        type="submit"
        name="setCommentFilter"
        class="{{if eq .CommentListFilter ""}}contrast{{else}}outline contrast{{end}}"
        aria-pressed="{{if eq .CommentListFilter ""}}true{{else}}false{{end}}"
      >All</button></form>
      <form method="POST"><input type="hidden" name="filter" value="annotations"><button
        type="submit"
        name="setCommentFilter"
        class="{{if eq .CommentListFilter "annotations"}}contrast{{else}}outline contrast{{end}}"
        aria-pressed="{{if eq .CommentListFilter "annotations"}}true{{else}}false{{end}}"
        title="Only the live site's annotations"
      >Annotations {{.AnnotationsListed}}</button></form>
    </div>{{end}}
    {{if .UnresolvedListed}}<form method="POST" class="ac-resolve-all">
      <button
        type="submit"
        name="resolveAll"
        class="outline"
        title="Resolve every comment listed here"
      >Resolve all {{.UnresolvedListed}}</button>
    </form>{{end}}
    <form method="POST" style="margin:0">
      <button
        type="submit"
        name="toggleCommentList"
        class="outline contrast"
        title="Return to the file you were viewing"
      >Back</button>
    </form>
  </header>
  {{if .VisibleComments}}
  <ul class="ac-list">
    {{range .VisibleComments}}
    <li
      class="ac-item{{if .Resolved}} is-resolved{{end}}{{if eq $.ScrollToCommentID .ID}} is-target{{end}}"
      data-key="{{.ID}}"
      {{- if eq $.ScrollToCommentID .ID}} lvt-fx:scroll="into-view"{{end}}
    >
      <form method="POST" class="ac-jump">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" name="jumpToComment" class="ac-jump-btn">
          <div class="ac-where">{{if .IsRegionLevel}}<small class="anno-label">annotation</small> <code>{{.Location}}</code>{{else}}<code>{{.Location}}</code> · {{.LineSpan}}{{with .Side}} <small>({{.}})</small>{{end}}{{end}}
            {{- if .Resolved}} <small class="resolved-badge">resolved</small>{{end}}
            {{- if .AnchorMoved}} <small class="moved-badge">moved</small>{{end}}
            {{- if and .AnchorEdited (not .Resolved) (not .Processed)}} <small class="edited-badge" title="exactly these lines were edited — likely addressed; confirm and resolve">likely addressed</small>{{end}}
            {{- if .AnchorOutdated}} <small class="outdated-badge">outdated</small>{{end}}
            {{- if .Processed}} {{template "processedBadge"}}{{end}}
            {{- if eq (index $.CommentQueueStates .ID) "answered"}} {{template "answeredBadge"}}{{end}}
            {{- if index $.AwaitingAgent .ID}} {{template "awaitingBadge"}}{{end}}
            {{- with .Source}} {{template "sourceBadge" .}}{{end -}}
          </div>
          <div class="ac-body">{{.Headline}}</div>
        </button>
      </form>
      {{if .AnchorOutdated}}<details class="anchor-orig"><summary>⚠ the document changed here — originally anchored to:</summary><pre>{{.Anchor.Text}}</pre></details>{{end}}
      {{- template "thread" (index $.Threads .ID) -}}
      {{- if eq $.ReplyingID .ID}}{{template "replyForm" $}}{{end}}
      <div class="ac-actions">
        {{if .IsRegionLevel -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="jumpToComment"
            class="outline"
            title="Back to the live site, with this annotation's box outlined"
          >Show on page</button>
        </form>
        {{- end}}
        {{if ne $.ReplyingID .ID -}}
        <form method="POST"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" name="openReply" class="outline">Reply</button></form>
        {{- end}}
        <form method="POST">
      <input type="hidden" name="id" value="{{.ID}}">
      <button
        type="submit"
        name="toggleResolved"
        class="outline"
      >{{if .Resolved}}Reopen{{else}}Resolve{{end}}</button>
    </form>
        {{if .Resolved -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="hideComment"
            class="outline"
          >Hide</button>
        </form>
        {{- end}}
        {{if and (not .Resolved) .AnchorOutdated -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="reanchorComment"
            class="outline"
          >Re-anchor</button>
        </form>
        {{- end}}
        {{if and (not .Resolved) (not .AnchorOutdated) -}}
        <form method="POST">
          <input type="hidden" name="id" value="{{.ID}}">
          <button
            type="submit"
            name="editComment"
            class="outline"
          >Edit</button>
        </form>
        {{- end}}
        <button
      type="button"
      class="secondary outline"
      command="show-modal"
      commandfor="confirm-delete-{{.ID}}"
    >Delete</button>
        {{template "deleteDialog" .}}
      </div>
    </li>
    {{end}}
  </ul>
  {{else}}
  {{/* Empty overview: a centered message + a prominent Back so the user
       isn't stranded on a near-blank page with only the small sticky-
       header Back (issue #27). Both empty branches get the Back; the
       resolved-hidden branch keeps its "toggle Show resolved" hint. */}}
  <div class="ac-empty">
    <p class="ac-empty-msg">
      {{- if and (gt .CommentCount 0) (not .ShowResolved)}}{{.CommentCount}} resolved comment{{if ne .CommentCount 1}}s{{end}} hidden — toggle “Show resolved” to see them.
      {{- else}}No comments yet.
      {{- end -}}
    </p>
    <form method="POST" style="margin:0">
      <button
        type="submit"
        name="toggleCommentList"
        class="contrast ac-empty-back"
        title="Return to the file you were viewing"
      >← Back to file</button>
    </form>
  </div>
  {{end}}
</section>
{{- end -}}
